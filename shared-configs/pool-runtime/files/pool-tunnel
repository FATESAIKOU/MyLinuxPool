#!/usr/bin/env bash
# pool-tunnel — spec: docs/POOL_RUNTIME_SPEC.md §3
# Supervisor for the reverse SSH tunnel to the Gateway. This is the one
# component in the whole system that is not allowed to fail quietly.
#
# Never calls `gh` directly — all addressing goes through pool-resolve.

set -uo pipefail

STATE_DIR="${HOME}/.mylinuxpool"
# Private to the tunnel: never the user's ~/.ssh/known_hosts, which other
# tools also write and which outlives any single Gateway generation.
KNOWN_HOSTS_FILE="${STATE_DIR}/gateway_known_hosts"
RUN_DIR="${STATE_DIR}/run"
CTL="${RUN_DIR}/ctl-gateway.sock"
PRIVATE_KEY="${HOME}/.ssh/id_pool"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
POOL_RESOLVE="${SCRIPT_DIR}/pool-resolve"

HEALTH_INTERVAL=2
HEALTH_TIMEOUT=2
UNHEALTHY_THRESHOLD=2
GATEWAY_CHECK_INTERVAL=30

NAME=""
ONCE=0

# Connection state, populated by resolve_connection_info().
GW_IP=""
GW_USER=""
GW_GEN=""
GW_HOST_KEY=""
MY_PORT=""
MASTER_PID=""
# §10.3: set to 1 once resolve_connection_info sees all of
# POOL_GATEWAY_PORT/HOST/USER — disables the pool-resolve-based 30s drift
# check, which would otherwise fail forever with no GH credentials to use.
STATIC_GATEWAY=0

# Where a node that CAN resolve the Gateway publishes what it found, and
# where a node that cannot goes to read it. A provider writes this on
# every successful resolve; a worker container gets the directory
# bind-mounted read-only and follows it.
#
# This is the third mode, between "call pool-resolve" (needs a GitHub
# token) and "take the address from the environment" (needs nothing, but
# freezes at docker-run time and so cannot survive a rotate). A worker
# reading its provider's published file needs no credential and still
# follows the Gateway, because the provider it runs on is already
# tracking NODE_GATEWAY on its own 30s cycle.
GATEWAY_PUBLISH_DIR="${POOL_GATEWAY_PUBLISH_DIR:-${HOME}/.mylinuxpool/gateway}"
GATEWAY_PUBLISH_FILE="${GATEWAY_PUBLISH_DIR}/gateway.json"
# Set in the container (create-worker points it at the bind mount).
GATEWAY_FOLLOW_FILE="${POOL_GATEWAY_FILE:-}"
FOLLOW_GATEWAY=0

log() {
    local level="$1"; shift
    local ts
    ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    if [[ "$level" == "INFO" ]]; then
        printf '[%s] %s %s\n' "$ts" "$level" "$*"
    else
        printf '[%s] %s %s\n' "$ts" "$level" "$*" >&2
    fi
}

usage() {
    echo "usage: pool-tunnel [--name <node-name>] [--once]" >&2
    echo "       (or set POOL_GATEWAY_PORT / POOL_NODE_NAME — see spec §10.3, used by disposable workers)" >&2
    echo "       (also set POOL_GATEWAY_HOST / POOL_GATEWAY_USER to skip pool-resolve entirely — no GH credentials needed)" >&2
}

load_name_from_config() {
    local cfg="${STATE_DIR}/config" line
    [[ -f "$cfg" ]] || return 1
    while IFS= read -r line; do
        case "$line" in
            NODE_NAME=*)
                NAME="${line#NODE_NAME=}"
                [[ -n "$NAME" ]] && return 0
                ;;
        esac
    done < "$cfg"
    return 1
}

next_backoff() {
    case "$1" in
        2) echo 4 ;;
        4) echo 8 ;;
        8) echo 16 ;;
        16) echo 30 ;;
        *) echo 30 ;;
    esac
}

# §3.1 steps 1-2: ask pool-resolve (never gh) for our own gateway_port and
# the Gateway's current ip/tunnel_user/generation.
#
# §10.3: a worker is disposable and gets no NODE_<NAME> var of its own —
# if POOL_GATEWAY_PORT is set, take the port straight from the
# environment and skip the pool-resolve "$NAME" lookup entirely. Providers
# never set this env var, so their path below is unchanged.
#
# If POOL_GATEWAY_PORT, POOL_GATEWAY_HOST and POOL_GATEWAY_USER are ALL
# set, the Gateway side is taken straight from the environment too, and
# pool-resolve is never called at all — a worker in this mode needs zero
# GitHub credentials to build its tunnel. The tradeoff (spec §10.3): it
# can't detect a Gateway rotate, so STATIC_GATEWAY also disables the 30s
# drift check below rather than let it spam errors with no way to
# succeed. This is expected — workers are disposable; re-run
# create-worker after a rotate.
# publish_gateway — record what we resolved so co-located containers can
# follow it. Written via a temp file in the same directory and renamed, so
# a reader never sees a half-written file. Never fatal: publishing is a
# convenience for others, and failing to do it must not take down a
# working tunnel.
publish_gateway() {
    local tmp
    mkdir -p "$GATEWAY_PUBLISH_DIR" 2>/dev/null || return 0
    chmod 755 "$GATEWAY_PUBLISH_DIR" 2>/dev/null || true
    tmp="$(mktemp "${GATEWAY_PUBLISH_DIR}/.gw.XXXXXX" 2>/dev/null)" || return 0
    printf '{"ip":"%s","tunnel_user":"%s","generation":"%s","host_key":"%s","published_at":"%s"}\n' \
        "$GW_IP" "$GW_USER" "$GW_GEN" "$GW_HOST_KEY" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$tmp" 2>/dev/null || {
        rm -f "$tmp"; return 0
    }
    chmod 644 "$tmp" 2>/dev/null || true
    mv -f "$tmp" "$GATEWAY_PUBLISH_FILE" 2>/dev/null || rm -f "$tmp"
    return 0
}

# read_published_gateway — pull ip/user/generation out of the file a
# provider published. Prints "ip<TAB>user<TAB>generation"; non-zero if the
# file is missing or unreadable, which the caller retries rather than
# treats as fatal (the provider may not have written it yet).
read_published_gateway() {
    local ip user gen hk
    [[ -r "$GATEWAY_FOLLOW_FILE" ]] || return 1
    ip="$(jq -r '.ip // empty' < "$GATEWAY_FOLLOW_FILE" 2>/dev/null)"
    user="$(jq -r '.tunnel_user // empty' < "$GATEWAY_FOLLOW_FILE" 2>/dev/null)"
    gen="$(jq -r '.generation // empty' < "$GATEWAY_FOLLOW_FILE" 2>/dev/null)"
    hk="$(jq -r '.host_key // empty' < "$GATEWAY_FOLLOW_FILE" 2>/dev/null)"
    [[ -n "$ip" && -n "$user" ]] || return 1
    printf '%s\t%s\t%s\t%s\n' "$ip" "$user" "$gen" "$hk"
}

resolve_connection_info() {
    local self_json rc

    # Follow mode: the port is still ours to know (create-worker assigned
    # it), but the Gateway address comes from the provider's published
    # file and is re-read on every drift cycle.
    if [[ -n "$GATEWAY_FOLLOW_FILE" && -n "${POOL_GATEWAY_PORT:-}" ]]; then
        local pub i
        MY_PORT="$POOL_GATEWAY_PORT"
        for i in $(seq 1 30); do
            pub="$(read_published_gateway)" && break
            [[ "$i" -eq 1 ]] && log INFO "waiting for ${GATEWAY_FOLLOW_FILE} to appear"
            sleep 2
        done
        if [[ -z "${pub:-}" ]]; then
            # Fall back to the frozen address rather than refusing to run:
            # a tunnel that cannot survive a rotate still beats no tunnel,
            # and this is what a provider on an older pool-runtime gives us.
            if [[ -n "${POOL_GATEWAY_HOST:-}" && -n "${POOL_GATEWAY_USER:-}" ]]; then
                log WARN "no readable Gateway file at ${GATEWAY_FOLLOW_FILE} after 60s — falling back to POOL_GATEWAY_HOST; this tunnel will NOT survive a Gateway rotate"
                GW_IP="$POOL_GATEWAY_HOST"
                GW_USER="$POOL_GATEWAY_USER"
                GW_GEN=""
                STATIC_GATEWAY=1
                return 0
            fi
            log ERROR "no readable Gateway file at ${GATEWAY_FOLLOW_FILE} after 60s and no POOL_GATEWAY_HOST fallback — is the provider's pool-tunnel running?"
            return 1
        fi
        IFS=$'\t' read -r GW_IP GW_USER GW_GEN GW_HOST_KEY <<< "$pub"
        FOLLOW_GATEWAY=1
        log INFO "following ${GATEWAY_FOLLOW_FILE}: ${GW_USER}@${GW_IP} (generation ${GW_GEN:-unknown})"
        return 0
    fi

    if [[ -n "${POOL_GATEWAY_PORT:-}" && -n "${POOL_GATEWAY_HOST:-}" && -n "${POOL_GATEWAY_USER:-}" ]]; then
        MY_PORT="$POOL_GATEWAY_PORT"
        GW_IP="$POOL_GATEWAY_HOST"
        GW_USER="$POOL_GATEWAY_USER"
        GW_GEN=""
        STATIC_GATEWAY=1
        return 0
    fi

    if [[ -n "${POOL_GATEWAY_PORT:-}" ]]; then
        MY_PORT="$POOL_GATEWAY_PORT"
    else
        self_json="$("$POOL_RESOLVE" "$NAME")"
        rc=$?
        if [[ $rc -ne 0 ]]; then
            log ERROR "pool-resolve ${NAME} failed (exit ${rc})"
            return 1
        fi

        MY_PORT="$(printf '%s' "$self_json" | jq -r '.gateway_port // empty')"
        if [[ -z "$MY_PORT" ]]; then
            log ERROR "node ${NAME} has no gateway_port defined"
            return 1
        fi
    fi

    # Deliberately NOT --refresh, unlike the drift check below and unlike
    # ops-scripts/mlp. This runs on the rebuild path, which is exactly when
    # the network may be unhealthy: served from pool-resolve's 30s cache, a
    # node can rebuild its tunnel using the last known address even while
    # GitHub is unreachable. Forcing a refresh here would turn a GitHub
    # outage into a tunnel outage. If the cached address is stale, the 30s
    # drift check corrects it — and that one does use --refresh.
    local gw_json
    gw_json="$("$POOL_RESOLVE" gateway)"
    rc=$?
    if [[ $rc -ne 0 ]]; then
        log ERROR "pool-resolve gateway failed (exit ${rc})"
        return 1
    fi

    GW_IP="$(printf '%s' "$gw_json" | jq -r '.ip // empty')"
    GW_USER="$(printf '%s' "$gw_json" | jq -r '.tunnel_user // empty')"
    GW_GEN="$(printf '%s' "$gw_json" | jq -r '.generation // empty')"
    GW_HOST_KEY="$(printf '%s' "$gw_json" | jq -r '.host_key // empty')"

    if [[ -z "$GW_IP" || -z "$GW_USER" ]]; then
        log ERROR "gateway node is missing ip/tunnel_user"
        return 1
    fi

    return 0
}

# §3.3: ask whether the Gateway has moved (ip or generation changed).
# Uses --refresh so this is the one call per 30s cycle that forces a live
# read; the routine 2s loop above just reads pool-resolve's own cache.
gateway_changed() {
    local new_ip new_gen rc

    # Follow mode re-reads the provider's file instead of asking GitHub.
    # A file that has gone missing is not "no drift" — say so and retry,
    # rather than reporting health we cannot actually observe.
    if [[ "$FOLLOW_GATEWAY" -eq 1 ]]; then
        local pub new_user
        if ! pub="$(read_published_gateway)"; then
            log WARN "gateway file ${GATEWAY_FOLLOW_FILE} unreadable, will retry next cycle"
            return 1
        fi
        local new_hk
        IFS=$'\t' read -r new_ip new_user new_gen new_hk <<< "$pub"
        if [[ "$new_ip" != "$GW_IP" || "$new_gen" != "$GW_GEN" ]]; then
            log INFO "gateway drift detected via ${GATEWAY_FOLLOW_FILE}: ip ${GW_IP}->${new_ip} generation ${GW_GEN}->${new_gen}"
            GW_IP="$new_ip"; GW_USER="$new_user"; GW_GEN="$new_gen"; GW_HOST_KEY="$new_hk"
            return 0
        fi
        return 1
    fi

    new_ip="$("$POOL_RESOLVE" gateway --refresh --field .ip)"
    rc=$?
    if [[ $rc -ne 0 || -z "$new_ip" || "$new_ip" == "null" ]]; then
        log WARN "gateway drift check could not refresh (exit ${rc}), will retry next cycle"
        return 1
    fi

    new_gen="$("$POOL_RESOLVE" gateway --field .generation)"

    if [[ "$new_ip" != "$GW_IP" || "$new_gen" != "$GW_GEN" ]]; then
        log INFO "gateway drift detected: ip ${GW_IP}->${new_ip} generation ${GW_GEN}->${new_gen}"
        GW_IP="$new_ip"
        GW_GEN="$new_gen"
        GW_HOST_KEY="$("$POOL_RESOLVE" gateway --field .host_key 2>/dev/null)"
        [[ "$GW_HOST_KEY" == "null" ]] && GW_HOST_KEY=""
        return 0
    fi

    return 1
}

# NOTE: this probe reaches the Gateway's forwarded port, which means it
# also counts as activity on that session. Measured 2026-09-14: probing a
# dead forward every 15s kept sshd from reaping it for over 120s, versus
# ~60s when left alone. Harmless at this 2s cadence for OUR OWN live
# tunnel (we are the peer that answers), but it is why RUNBOOK §7.9 says
# not to point an automated monitor at other nodes' ports.

# Cheap liveness probe on the local mux socket, independent of GW_IP/GW_USER
# so it works even right after process start when those aren't known yet
# (scenario: a stale ControlMaster socket left over from a crashed run).
control_alive() {
    [[ -S "$CTL" ]] || return 1
    ssh -S "$CTL" -O check placeholder >/dev/null 2>&1
}

# §3.1 step 3 / §3.4 step 3: build the ControlMaster. ExitOnForwardFailure
# means ssh exits immediately if the remote port is already occupied by a
# stale connection instead of pretending to succeed — that failure must
# never be reported as healthy.
start_master() {
    rm -f "$CTL"

    # Host key handling, and why it is not accept-new against the user's
    # own known_hosts:
    #
    # Linode recycles addresses, so a rotate regularly puts a different
    # machine on an IP a provider already has a key for.
    # StrictHostKeyChecking=accept-new accepts a NEW host but refuses a
    # CHANGED one — so every provider refused to attach and the rotate had
    # to roll back (RUNBOOK §7.8). Clearing known_hosts would only push
    # the same failure to the next recycled address.
    #
    # NODE_GATEWAY carries the Gateway's host key instead: it is written
    # by the rotate that built the machine, over the session that
    # provisioned it, and only Actions can write that variable. Pin to it
    # in a file of our own — a real identity check, and stricter than the
    # trust-on-first-use it replaces.
    local -a hostkey_opts
    if [[ -n "$GW_HOST_KEY" ]]; then
        printf '%s %s\n' "$GW_IP" "$GW_HOST_KEY" > "$KNOWN_HOSTS_FILE"
        chmod 600 "$KNOWN_HOSTS_FILE" 2>/dev/null || true
        hostkey_opts=(-o UserKnownHostsFile="$KNOWN_HOSTS_FILE"
                      -o StrictHostKeyChecking=yes)
    else
        # No published key (a Gateway from before this was recorded).
        # Use a private known_hosts anyway, so a recycled address cannot
        # collide with an entry some other tool wrote.
        hostkey_opts=(-o UserKnownHostsFile="$KNOWN_HOSTS_FILE"
                      -o StrictHostKeyChecking=accept-new)
        log WARN "NODE_GATEWAY carries no host_key — falling back to trust-on-first-use"
    fi

    local -a cmd=(
        ssh -M -S "$CTL"
        -o ControlPersist=no
        -o ExitOnForwardFailure=yes
        -o ServerAliveInterval=15
        -o ServerAliveCountMax=2
        "${hostkey_opts[@]}"
        -o AddressFamily=inet
        -i "$PRIVATE_KEY" -o IdentitiesOnly=yes
        -N -R "127.0.0.1:${MY_PORT}:localhost:22"
        "${GW_USER}@${GW_IP}"
    )

    # Keep ssh's stderr. Throwing it away and then asserting a cause
    # ("remote forward was refused") turned every possible failure —
    # auth, host key, connection, forward — into the same sentence, and
    # a real rotate failure on 2026-09-14 could not be diagnosed at all
    # because the only evidence had been discarded. Report what ssh said.
    local err
    err="$(mktemp "${STATE_DIR}/.ssherr.XXXXXX" 2>/dev/null)" || err=""
    if [[ -n "$err" ]]; then
        "${cmd[@]}" </dev/null >/dev/null 2>"$err" &
    else
        "${cmd[@]}" </dev/null >/dev/null 2>&1 &
    fi
    MASTER_PID=$!

    local waited=0
    while (( waited < 10 )); do
        if ! kill -0 "$MASTER_PID" 2>/dev/null; then
            wait "$MASTER_PID" 2>/dev/null
            local rc=$?
            log ERROR "ssh ControlMaster exited during setup (rc=${rc})"
            if [[ -n "$err" && -s "$err" ]]; then
                while IFS= read -r line; do
                    [[ -n "$line" ]] && log ERROR "  ssh: ${line}"
                done < "$err"
            else
                log ERROR "  ssh printed nothing — no further detail available"
            fi
            rm -f "$err"
            return 1
        fi
        if ssh -S "$CTL" -O check placeholder >/dev/null 2>&1; then
            [[ -n "$err" ]] && rm -f "$err"
            return 0
        fi
        sleep 1
        waited=$((waited + 1))
    done

    log ERROR "timed out waiting for ControlMaster to become ready"
    if [[ -n "$err" && -s "$err" ]]; then
        while IFS= read -r line; do
            [[ -n "$line" ]] && log ERROR "  ssh: ${line}"
        done < "$err"
    fi
    [[ -n "$err" ]] && rm -f "$err"
    kill "$MASTER_PID" 2>/dev/null || true
    wait "$MASTER_PID" 2>/dev/null || true
    return 1
}

teardown_master() {
    if [[ -S "$CTL" ]]; then
        ssh -S "$CTL" -O exit placeholder >/dev/null 2>&1 || true
    fi
    rm -f "$CTL"
    if [[ -n "$MASTER_PID" ]]; then
        kill "$MASTER_PID" 2>/dev/null || true
        wait "$MASTER_PID" 2>/dev/null || true
    fi
    MASTER_PID=""
}

# §3.2: ride the existing ControlMaster (no new handshake) and read the SSH
# banner off our own forwarded port on the Gateway — `nc -z` only proves
# *something* is listening, not that it's our tunnel (a rogue listener on
# the port would report healthy). Timeout, nonzero, or a non-"SSH-" reply
# all count as unhealthy; only grep's exit status decides that (PIPESTATUS
# keeps ssh's own exit code from clobbering a successful banner match under
# `pipefail`, and an empty/timed-out reply makes grep fail on its own too).
health_check() {
    timeout "$HEALTH_TIMEOUT" ssh -S "$CTL" "${GW_USER}@${GW_IP}" \
        "timeout 1 nc 127.0.0.1 ${MY_PORT} </dev/null | head -c 4" \
        | grep -q '^SSH-'
    return "${PIPESTATUS[1]}"
}

on_terminate() {
    log INFO "received termination signal, tearing down tunnel"
    teardown_master
    exit 0
}

parse_args() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --name)
                [[ $# -ge 2 ]] || { usage; exit 2; }
                NAME="$2"; shift 2 ;;
            --once)
                ONCE=1; shift ;;
            -h|--help)
                usage; exit 0 ;;
            *)
                log ERROR "unknown argument: $1"
                usage
                exit 2 ;;
        esac
    done
}

main() {
    parse_args "$@"

    if [[ -z "$NAME" ]]; then
        if [[ -n "${POOL_NODE_NAME:-}" ]]; then
            # §10.3: worker identity, no NODE_<NAME> var / config file involved.
            NAME="$POOL_NODE_NAME"
        elif load_name_from_config; then
            :
        elif [[ -n "${POOL_GATEWAY_PORT:-}" ]]; then
            # POOL_GATEWAY_PORT alone is enough to run (see
            # resolve_connection_info) — NAME here is cosmetic only.
            NAME="worker"
        else
            log ERROR "no --name given, NODE_NAME not found in ${STATE_DIR}/config, and neither POOL_NODE_NAME nor POOL_GATEWAY_PORT is set"
            exit 2
        fi
    fi

    mkdir -p "$RUN_DIR"
    trap on_terminate TERM INT

    local backoff=2
    local unhealthy_count=0
    local last_gw_check=0

    while true; do
        # §3.5 scenario 4: startup with a leftover/dead ControlMaster socket.
        if [[ -S "$CTL" ]] && ! control_alive; then
            log WARN "stale ControlMaster socket at ${CTL}, removing"
            rm -f "$CTL"
        fi

        if [[ ! -S "$CTL" ]]; then
            if ! resolve_connection_info; then
                log ERROR "could not resolve connection info, backing off ${backoff}s"
                if [[ "$ONCE" -eq 1 ]]; then
                    exit 1
                fi
                sleep "$backoff"
                backoff="$(next_backoff "$backoff")"
                continue
            fi

            # Only a node that resolved this itself has anything worth
            # publishing; a follower would just echo back what it read.
            [[ "$FOLLOW_GATEWAY" -eq 1 || "$STATIC_GATEWAY" -eq 1 ]] || publish_gateway

            if start_master; then
                log INFO "tunnel established: ${GW_USER}@${GW_IP} <- :${MY_PORT} (gateway generation ${GW_GEN})"
                backoff=2
                unhealthy_count=0
                last_gw_check=$(date +%s)
                if [[ "$ONCE" -eq 1 ]]; then
                    exit 0
                fi
            else
                rm -f "$CTL"
                log ERROR "tunnel establishment failed, backing off ${backoff}s"
                if [[ "$ONCE" -eq 1 ]]; then
                    exit 1
                fi
                sleep "$backoff"
                backoff="$(next_backoff "$backoff")"
                continue
            fi
        fi

        sleep "$HEALTH_INTERVAL"

        if health_check; then
            unhealthy_count=0
        else
            unhealthy_count=$((unhealthy_count + 1))
            log WARN "health check failed (${unhealthy_count}/${UNHEALTHY_THRESHOLD})"
            if (( unhealthy_count >= UNHEALTHY_THRESHOLD )); then
                log ERROR "tunnel unhealthy for ${UNHEALTHY_THRESHOLD} consecutive checks, rebuilding"
                teardown_master
                unhealthy_count=0
            fi
        fi

        local now=$(date +%s)
        if [[ "$STATIC_GATEWAY" -ne 1 || "$FOLLOW_GATEWAY" -eq 1 ]] \
           && (( now - last_gw_check >= GATEWAY_CHECK_INTERVAL )); then
            last_gw_check=$now
            if gateway_changed; then
                log WARN "rebuilding tunnel immediately due to gateway drift"
                [[ "$FOLLOW_GATEWAY" -eq 1 || "$STATIC_GATEWAY" -eq 1 ]] || publish_gateway
                teardown_master
            fi
        fi
    done
}

main "$@"
