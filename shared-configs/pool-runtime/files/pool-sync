#!/usr/bin/env bash
# shared-configs/pool-runtime/files/pool-sync — spec: task D
#
# Converges a provider's installed pool-* scripts to what the repo declares,
# every 30 minutes (pool-sync.timer), by re-checking each profile-declared
# unit — a CONTENT comparison, not an existence check.
#
# WHY main() wraps the whole script (this is load-bearing): this file is
# installed to ~/.mylinuxpool/bin/pool-sync, and pool-runtime's install.sh
# replaces it in place. Bash reads a script incrementally by byte offset,
# so a script swapped mid-read can decode garbage after the overwrite
# point; a function body is parsed completely before execution starts, so
# the running instance is immune to the file under it being rewritten.
#
# No state is kept under ~/.mylinuxpool and no new file is ever created:
# convergence is judged purely by the units' own --check.

set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"

REPO="${POOL_REPO:-FATESAIKOU/MyLinuxPool}"
# How old a worker container must be before the orphan sweep will touch it:
# create-worker's whole flow takes a couple of minutes, so 15 is room to spare.
# Overridable for tests.
SWEEP_MIN_AGE="${POOL_SWEEP_MIN_AGE:-900}"
BRANCH="${POOL_BRANCH:-master}"
STATE_DIR="${HOME}/.mylinuxpool"
CONFIG_FILE="${STATE_DIR}/config"
GH_TOKEN_FILE="${STATE_DIR}/gh_token"

# The tunnel identity path is the SINGLE source in tunnel-identity.sh —
# the same file pool-tunnel and rotate's tunnel probe read, so the minted
# key path can never diverge from the path the tunnel actually uses.
# shellcheck source=tunnel-identity.sh
source "${SCRIPT_DIR}/tunnel-identity.sh"

# Global on purpose: the EXIT trap below runs after main() returns, when
# its locals are already gone — referencing a local under `set -u` would
# itself abort the cleanup.
TMP_DIR=""

log() {
    local level="$1"; shift
    local ts
    ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    if [[ "$level" == "INFO" ]]; then
        printf '[%s] %s %s\n' "$ts" "$level" "$*"
    else
        printf '[%s] %s %s\n' "$ts" "$level" "$*" >&2
    fi
}

main() {
    # --- local facts: node identity + GitHub credential -------------
    local node_name
    node_name="$(grep '^NODE_NAME=' "$CONFIG_FILE" 2>/dev/null | head -1 | cut -d= -f2-)"
    if [[ -z "$node_name" ]]; then
        log ERROR "no NODE_NAME in ${CONFIG_FILE} — is this machine registered?"
        exit 1
    fi
    if [[ ! -f "$GH_TOKEN_FILE" ]]; then
        log ERROR "no token at ${GH_TOKEN_FILE} — cannot fetch the repo or read GitHub"
        exit 1
    fi

    # --- fetch a fresh copy of the repo ------------------------------
    # The credential helper reads the token from the file at invocation
    # time (register-provider.sh's exact pattern) — the token never
    # appears on a command line or in any log.
    TMP_DIR="$(mktemp -d)"
    trap 'rm -rf "$TMP_DIR"' EXIT

    if [[ "$REPO" == *"://"* || "$REPO" == git@* ]]; then
        clone_url="$REPO"
    else
        clone_url="https://github.com/${REPO}.git"
    fi
    if ! git clone --depth 1 --branch "$BRANCH" \
            -c credential.https://github.com.helper="!f() { echo username=x-access-token; echo \"password=\$(cat $HOME/.mylinuxpool/gh_token 2>/dev/null)\"; }; f" \
            "$clone_url" "$TMP_DIR/repo" >/dev/null 2>&1; then
        # N6: GitHub being down must never become a provider fault.
        log WARN "cannot fetch ${REPO}@${BRANCH} from GitHub — will retry on the next timer tick"
        exit 0
    fi

    # --- migration: drop the old persistent clone ---------------------
    # One-off migration: drop the resident clone register-provider.sh used
    # to leave behind, so a machine registered before that fix converges on
    # its own instead of needing re-registration.
    if [[ -d "${STATE_DIR}/repo" ]]; then
        rm -rf "${STATE_DIR}/repo"
        log INFO "removed the old persistent repo clone at ${STATE_DIR}/repo — declarations now live only on GitHub"
    fi

    # --- which profile does this node belong to ----------------------
    # .registered_with on the node's GitHub var records whether
    # register-provider.sh ran with --no-sudo; the matching provider
    # profile is the one source for what this machine should carry.
    local var_name profile var_json registered_with
    var_name="NODE_$(printf '%s' "$node_name" | tr '[:lower:]' '[:upper:]' | tr '-' '_')"
    profile="default"
    var_json="$(GH_TOKEN="$(cat "$GH_TOKEN_FILE")" \
        gh api "repos/${REPO}/actions/variables/${var_name}" --jq .value 2>/dev/null || true)"
    if [[ -z "$var_json" ]] || ! printf '%s' "$var_json" | jq empty >/dev/null 2>&1; then
        log WARN "cannot read ${var_name} from GitHub — assuming profile 'default'"
    else
        registered_with="$(printf '%s' "$var_json" | jq -r '.registered_with // empty')"
        if [[ "$registered_with" == "--no-sudo" ]]; then
            profile="no-sudo"
        fi
    fi
    log INFO "node ${node_name}: profile '${profile}' (${var_name})"

    # --- converge every profile-declared unit -------------------------
    # Only units that need NEITHER a decryption key NOR root can ever be
    # converged here: pool-sync runs as the ordinary user from a systemd
    # user timer (no sudo), and providers deliberately carry no
    # FILE_CRYPTO_KEY (N2). Today that is two units — pool-runtime and wol.
    local profile_json units unit unit_json install
    profile_json="${TMP_DIR}/repo/profiles/provider/${profile}/profile.json"
    if [[ ! -f "$profile_json" ]]; then
        log ERROR "profile '${profile}' not found in the fetched repo — sync aborted"
        exit 1
    fi
    units="$(jq -r '.shared_config[]?' "$profile_json" 2>/dev/null || true)"
    if [[ -z "$units" ]]; then
        log WARN "profile '${profile}' declares no shared_config units — nothing to sync"
    fi

    local changed=0
    for unit in $units; do
        unit_json="${TMP_DIR}/repo/shared-configs/${unit}/unit.json"
        if [[ ! -f "$unit_json" ]]; then
            log WARN "no unit.json for declared unit '${unit}' — skipping"
            continue
        fi
        # 生產觸發條件：目前無人觸發。兩台 provider 的 profile 宣告的三個
        # 單位 needs_key 皆 false，所以這個 skip 不會
        # 執行；它要等 provider profile 又宣告 rclone/standalonescripts
        # （唯二 needs_key=true 的 unit）才會第一次生效。
        if [[ "$(jq -r '.needs_key // false' "$unit_json" 2>/dev/null || true)" == "true" ]]; then
            # N2: providers deliberately carry no decryption key; units
            # that need one are only handled at registration time.
            log INFO "skipped: ${unit} needs FILE_CRYPTO_KEY, only handled at registration"
            continue
        fi
        if [[ "$(jq -r '.needs_root // false' "$unit_json" 2>/dev/null || true)" == "true" ]]; then
            # 生產觸發條件：目前 100% 走此路（每個 provider tick 都會）。兩台
            # provider 的 profile 都宣告 gh，而 gh 的 unit.json 是 needs_root=true，
            # 所以每一輪都在這裡被跳過；退場條件是 gh 的 needs_root 不再為 true。
            # pool-sync runs as the ordinary user from a systemd user
            # timer — it has no root. Installing a needs_root unit would
            # fail (and then retry every 30 minutes); a missing `gh`
            # binary is exactly such a case. Installing is left to
            # registration/repair, which run with the credentials this timer
            # does not have — but it still verifies one (see the capability
            # declaration below).
            log INFO "skipped: ${unit} needs root, only handled at registration or by an admin"
            continue
        fi
        install="${TMP_DIR}/repo/shared-configs/${unit}/install.sh"
        if [[ ! -x "$install" ]]; then
            log WARN "install.sh of unit '${unit}' missing or not executable — skipping"
            continue
        fi
        if "$install" --check --home "$HOME" --user "$(whoami)" >/dev/null 2>&1; then
            log INFO "ok: ${unit} is up to date"
        else
            log INFO "installing: ${unit} (drift detected)"
            if "$install" --home "$HOME" --user "$(whoami)" >/dev/null 2>&1; then
                changed=1
            else
                log ERROR "install of unit '${unit}' failed — exit 1 for systemd to record"
                exit 1
            fi
        fi
    done

    # --- declare this machine's capabilities (D4) ------------------------
    # A separate path from convergence: nothing is installed here, and only
    # the `capabilities` field of NODE_<NAME> is ever written. Every failure
    # here is WARN-only — a broken declaration must not cost this machine its
    # convergence, its authorized_keys or its tunnel key.
    #
    # No workflow dispatch: telling the Gateway to re-read its keys is not
    # what this does, and dispatching here would put back the ~96 refresh
    # runs a day that issue #7 removed.
    local cap_runner="${TMP_DIR}/repo/scripts/lib/capability.sh"
    local cap_tok=""
    cap_tok="$(cat "$GH_TOKEN_FILE" 2>/dev/null || true)"
    if [[ -r "$cap_runner" ]]; then
        # shellcheck source=/dev/null
        source "$cap_runner"
        local cur_caps="" cur_decl="" new_caps="" cap_stderr=""
        cur_caps="$(GH_TOKEN="$cap_tok" gh api "repos/${REPO}/actions/variables/${var_name}" \
            --jq '.value // empty' 2>/dev/null || true)"
        if [[ -z "$cur_caps" ]] || ! printf '%s' "$cur_caps" | jq -e . >/dev/null 2>&1; then
            log WARN "capability declaration: cannot read a usable ${var_name} — leaving it alone"
        else
            # capability_declaration 的第二個引數是**現有宣告**，不是整份 var。
            cur_decl="$(printf '%s' "$cur_caps" | jq -Sc '.capabilities // {}')"
            # 一個 tick 只驗一次：狀態由 capability_declaration 順帶報到 stderr
            #（「capability <key>: rc=<n>」），這裡只翻譯成 WARN／INFO。
            if new_caps="$(MLP_REPO_ROOT="${TMP_DIR}/repo" \
                              capability_declaration "$profile_json" "$cur_decl" 2>"${TMP_DIR}/cap.err")"; then
                cap_stderr="$(cat "${TMP_DIR}/cap.err" 2>/dev/null || true)"
                while read -r pk prc; do
                    [[ -n "$pk" ]] || continue
                    case "$prc" in
                        1) log WARN "capability '${pk}' is not established — dropping it from ${var_name}.capabilities" ;;
                        2) log INFO "capability '${pk}' could not be confirmed this tick — keeping the declared value" ;;
                    esac
                done < <(printf '%s\n' "$cap_stderr" | sed -n 's/^capability \(.*\): rc=\([0-9]\)$/\1 \2/p')

                if [[ "$cur_decl" == "$(printf '%s' "$new_caps" | jq -Sc .)" ]]; then
                    log INFO "capabilities already match the profile's verified state — nothing to write"
                else
                    # 比較才正規化；寫入不排序，保留既有鍵序（與 tunnel-key.sh 一致）。
                    local merged
                    merged="$(printf '%s' "$cur_caps" | jq -c --argjson caps "$new_caps" '. + {capabilities: $caps}')"
                    if printf '%s' "$merged" | GH_TOKEN="$cap_tok" \
                        gh variable set "$var_name" --repo "$REPO" >/dev/null 2>&1; then
                        log INFO "wrote ${var_name}.capabilities = ${new_caps}"
                    else
                        log WARN "capability declaration: could not write ${var_name} — leaving it alone"
                    fi
                fi
            else
                log WARN "capability declaration: runner failed — leaving ${var_name} alone"
            fi
        fi
    else
        log WARN "capability declaration: ${cap_runner} missing in the fetched repo — skipping"
    fi

    # --- converge this machine's authorized_keys from CLIENT_* ---------
    # (KEY-DESIGN §3.4: the provider's login list converges itself on every
    # tick — no repair-provider run, no FILE_CRYPTO_KEY needed.)
    # Since KEY-DESIGN §8 (task U) this is the ONLY writer: ssh-admin and its
    # static encrypted list are gone, so CLIENT_* is the single source.
    #
    # This is a FULL REPLACE, deliberately NOT a union. The point is
    # revocation: with a union, a `register-client --remove` would delete
    # the var but the key would stay on every provider forever. Replacing
    # means removing the var removes the key.
    #
    # The assembly + install is ONE shared implementation,
    # refresh_sync_local_authorized_keys (scripts/refresh-authkeys.sh) —
    # register-provider calls the same function, so there is never a second
    # copy of this rule that could drift out of sync with its guards.
    sync_authorized_keys() {
        local vars_json

        vars_json="$(GH_TOKEN="$(cat "$GH_TOKEN_FILE")" \
            gh api "repos/${REPO}/actions/variables?per_page=100" --paginate 2>/dev/null || true)"
        if [[ -z "$vars_json" ]]; then
            log WARN "cannot read GitHub variables — leaving ${HOME}/.ssh/authorized_keys untouched (N6)"
            return 0
        fi

        # Source the functions from the fresh clone fetched above —
        # always the latest declarations, never a stale copy. A missing
        # scripts/ (e.g. an old repo branch) is a WARN, not a failure.
        if [[ ! -f "${TMP_DIR}/repo/scripts/refresh-authkeys.sh" \
              || ! -f "${TMP_DIR}/repo/scripts/lib/authkeys.sh" ]]; then
            log WARN "scripts/refresh-authkeys.sh or scripts/lib/authkeys.sh missing in the fetched repo — skipping authorized_keys convergence"
            return 0
        fi
        # shellcheck source=/dev/null
        source "${TMP_DIR}/repo/scripts/refresh-authkeys.sh"
        # shellcheck source=/dev/null
        source "${TMP_DIR}/repo/scripts/lib/authkeys.sh"

        refresh_sync_local_authorized_keys "$vars_json" || {
            log WARN "authorized_keys convergence failed (see above) — leaving ${HOME}/.ssh/authorized_keys untouched"
            return 0
        }

        # The same list again, into the directory every worker container on
        # this provider bind-mounts read-only. Their sshd reads it through
        # AuthorizedKeysCommand on each login, so this is what makes adding
        # OR REVOKING a client reach workers that are already running.
        #
        # Deliberately the same function, called twice, rather than a second
        # assembly: one implementation of "what belongs in an
        # authorized_keys", including the self-lockout guard (RUNBOOK §7.12).
        # Non-zero is a WARN — a provider with no workers loses nothing, and
        # the next tick retries.
        refresh_sync_local_authorized_keys "$vars_json" \
            "${HOME}/.mylinuxpool/clients/authorized_keys" || {
            log WARN "could not converge the worker client list — workers keep the list they already have"
        }
        return 0
    }

    sync_authorized_keys

    # --- remove worker containers the ledger no longer lists -----------
    # delete-worker removes the container over ssh, and that step is
    # best-effort on purpose (fh-l is normally powered OFF, so it routinely
    # cannot be reached) — which can leave a container on disk with
    # --restart unless-stopped. This is the other half of that: what the
    # ledger does not list, this machine should not be running.
    sweep_orphan_workers() {
        command -v docker >/dev/null 2>&1 || return 0

        local workers_json prefix now container created created_trim created_epoch age
        workers_json="$(GH_TOKEN="$(cat "$GH_TOKEN_FILE")" \
            gh api "repos/${REPO}/actions/variables/POOL_WORKERS" --jq .value 2>/dev/null || true)"
        # N6: GitHub being unreachable must never turn into deleting things.
        # No data means no sweep, not an empty ledger.
        if [[ -z "$workers_json" ]] || ! printf '%s' "$workers_json" | jq empty >/dev/null 2>&1; then
            log WARN "cannot read POOL_WORKERS — skipping the orphan sweep (never delete on missing data)"
            return 0
        fi

        # Only this node's own containers, ever.
        prefix="mlp-${node_name}-"
        now="$(date +%s)"

        while IFS= read -r container; do
            [[ -n "$container" ]] || continue
            if printf '%s' "$workers_json" \
                | jq -e --arg c "$container" 'any(.[]; .container == $c)' >/dev/null 2>&1; then
                continue
            fi

            # Age guard. create-worker starts the container BEFORE recording
            # it — it has to, because the worker mints its own key and only
            # then can the ledger entry be written. A young container is
            # therefore probably one being created right now, not an orphan.
            created="$(docker inspect -f '{{.Created}}' "$container" 2>/dev/null)"
            # RFC3339 -> epoch. GNU `date -d` is what providers have; the BSD
            # form keeps this parseable on a developer Mac. TZ=UTC because
            # BSD date reads a bare timestamp as LOCAL time, which made every
            # container look hours old and defeated the guard entirely.
            # Unparseable means age 0 — never delete on a number we could not read.
            created_epoch=""
            if [[ -n "$created" ]]; then
                created_trim="${created%%.*}"; created_trim="${created_trim%Z}"
                created_epoch="$(date -d "$created" +%s 2>/dev/null \
                    || TZ=UTC date -j -f '%Y-%m-%dT%H:%M:%S' "$created_trim" +%s 2>/dev/null \
                    || true)"
            fi
            age=0
            [[ -n "$created_epoch" ]] && age=$(( now - created_epoch ))
            if (( age < SWEEP_MIN_AGE )); then
                log INFO "leaving ${container} alone (${age}s old — may still be mid-creation)"
                continue
            fi

            if docker rm -f "$container" >/dev/null 2>&1; then
                log INFO "swept orphan worker container ${container} (POOL_WORKERS does not list it)"
            else
                log WARN "could not remove orphan container ${container} — will retry next tick"
            fi
        done < <(docker ps -a --filter "name=^${prefix}" --format '{{.Names}}' 2>/dev/null)
    }

    sweep_orphan_workers

    # --- ensure the per-machine tunnel key exists and is published -----
    # KEY-DESIGN §3.2/§3.3 + MIGRATION.md §3: providers generate their own
    # tunnel identity once (at first sync, not at registration — fh-l's
    # re-registration would need a sudo password we do not have), and publish
    # the public half into their own NODE_<NAME> var so the Gateway refresh can
    # authorize it. The migration keeps the shared key working meanwhile, so any
    # failure here is WARN-only: a running machine must never be broken by a bad
    # tick, and the next tick retries.
    # The mint-and-publish rule itself lives in scripts/lib/tunnel-key.sh,
    # sourced from the clone fetched above — the same sharing pattern as
    # refresh-authkeys.sh.
    local tunnel_key_changed=1
    if [[ -f "${TMP_DIR}/repo/scripts/lib/tunnel-key.sh" ]]; then
        # shellcheck source=/dev/null
        # TUNNEL_KEY_REPO_DIR gives the lib a fallback for
        # tunnel-identity.sh: it prefers the installed copy, but a machine
        # syncing for the very first time may not have one yet.
        TUNNEL_KEY_REPO_DIR="${TMP_DIR}/repo" \
            source "${TMP_DIR}/repo/scripts/lib/tunnel-key.sh"
        if GH_TOKEN="$(cat "$GH_TOKEN_FILE")" \
                tunnel_key_ensure_published "$node_name" "$var_name" "$REPO"; then
            # Refresh only for a key this tick wrote; a failed dispatch is
            # left to the daily schedule. An unset flag means an older lib,
            # so dispatch as before.
            if [[ -z "${TUNNEL_KEY_CHANGED+x}" ]]; then
                log INFO "tunnel-key.sh predates TUNNEL_KEY_CHANGED — dispatching as before"
                tunnel_key_changed=1
            else
                tunnel_key_changed="${TUNNEL_KEY_CHANGED}"
            fi

            if [[ "$tunnel_key_changed" != "1" ]]; then
                log INFO "tunnel_public_key already published — not dispatching refresh-authorized-keys.yml"
            elif GH_TOKEN="$(cat "$GH_TOKEN_FILE")" \
                    gh workflow run refresh-authorized-keys.yml --repo "$REPO" >/dev/null 2>&1; then
                log INFO "dispatched refresh-authorized-keys.yml"
            else
                log WARN "could not dispatch refresh-authorized-keys.yml — the Gateway will pick the key up on the daily schedule (refresh-authorized-keys.yml runs at 20:00 UTC)"
            fi
        else
            log WARN "tunnel key convergence failed (see above) — retrying on the next tick"
        fi
    else
        log WARN "scripts/lib/tunnel-key.sh missing in the fetched repo — skipping tunnel key convergence"
    fi

    # --- restart the tunnel only when something actually changed -------
    # pool-tunnel holds every worker's reverse tunnel; an unnecessary
    # restart drops all of them for nothing (spec §3.5: restarts are
    # costly, so the sync must be able to run with no change at all).
    # The order is load-bearing: daemon-reload MUST come before restart —
    # the install above may have replaced the pool-tunnel.service unit file
    # itself, and systemd only re-reads unit files on daemon-reload.
    if [[ "$changed" -eq 1 ]]; then
        systemctl --user daemon-reload
        systemctl --user restart pool-tunnel
        log INFO "pool-tunnel restarted (files changed; daemon-reload first)"
    else
        log INFO "no changes — pool-tunnel NOT restarted"
    fi
}

main "$@"
