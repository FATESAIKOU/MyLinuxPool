#cloud-config
# profiles/provider/repair/user-data.tmpl — cloud-init NoCloud user-data for a
# family repair host (openspec/changes/family-repair-host, design D1/D4/D8).
#
# Rendered on the owner's Mac by ops-scripts/register-repair-host; every
# placeholder token (upper-case name between double at-signs) is replaced
# there, and the renderer refuses to write a file that still contains one. Values are single-line by construction (names,
# ports, one public-key line, base64), so no token can inject YAML.
#
# What this file must never contain: a GitHub token (spec "維修承載機不持有
# GitHub 權杖"). The generator scans the rendered result and refuses on a hit
# (D5, first half); the VM-side guard is task 5.
#
# Deliberately NO `packages:` — the spike (OUT-spike-repair.md §2) showed the
# Ubuntu noble cloud image already ships bash, openssh, jq, netcat, curl and
# python3, and a family network may be slow, metered or filtered. Nothing
# here may depend on reaching an apt mirror.
package_update: false
package_upgrade: false

# The one login user. Its only way in is the owner's public key below (D8:
# pre-seeded; revoking it means editing authorized_keys after logging in, or
# building a new seed). No password exists, so password login cannot be
# turned on by accident later.
users:
  - name: @@LOGIN_USER@@
    shell: /bin/bash
    lock_passwd: true
    ssh_authorized_keys:
      - "@@LOGIN_PUBKEY@@"
ssh_pwauth: false
disable_root: true

write_files:
  # sshd: loopback only, keys only (spec "家人網路上的其他裝置碰不到 VM 的
  # sshd"). The reverse tunnel lands on the VM's own localhost:22, so nothing
  # needs a non-loopback listener. Named 10-… so it sorts before cloud-init's
  # own 50-cloud-init.conf: sshd keeps the FIRST value it reads.
  - path: /etc/ssh/sshd_config.d/10-mlp-repair.conf
    owner: root:root
    permissions: '0644'
    content: |
      ListenAddress 127.0.0.1
      ListenAddress ::1
      PasswordAuthentication no
      KbdInteractiveAuthentication no
      PubkeyAuthentication yes
      AuthenticationMethods publickey
      PermitRootLogin no

  # Static-mode inputs for pool-tunnel (POOL_GATEWAY_HOST/USER/PORT all set
  # = no pool-resolve, no GitHub; POOL_GATEWAY_SSH_PORT is design D3).
  # No secrets in here, so it stays world-readable.
  #
  # POOL_GATEWAY_HOST is a PLACEHOLDER on purpose. The Gateway's IP changes on
  # every rotate, so it is not known when this seed is built: the launcher
  # hands it to the VM at boot over the D2 channel (task 5), which overrides
  # this value. The placeholder uses the reserved .invalid TLD (RFC 2606), so
  # anything that dials before task 5 lands fails at DNS instead of reaching
  # some other host.
  - path: /etc/mlp/tunnel.env
    owner: root:root
    permissions: '0644'
    content: |
      POOL_NODE_NAME=@@NODE_NAME@@
      POOL_GATEWAY_PORT=@@PROVIDER_PORT@@
      POOL_GATEWAY_USER=@@GATEWAY_TUNNEL_USER@@
      POOL_GATEWAY_SSH_PORT=@@GATEWAY_SSH_PORT@@
      POOL_GATEWAY_HOST=@@GATEWAY_HOST@@

  # The tunnel private key. It was minted on the owner's Mac — design D4's
  # deliberate exception to "a private key never leaves the machine that made
  # it": its destination is this VM, and the family side cannot run anything.
  # defer: true because the owner is the user cloud-init creates above; a
  # non-deferred write_files runs before users exist (spike pitfall 2).
  # The path comes from tunnel-identity.sh (the single definition), rendered
  # for this user's home.
  - path: @@TUNNEL_KEY_PATH@@
    owner: @@LOGIN_USER@@:@@LOGIN_USER@@
    permissions: '0600'
    encoding: b64
    defer: true
    content: @@TUNNEL_PRIVATE_KEY_B64@@

  # ---- task 5 adds its pieces here ------------------------------------------
  # pool-tunnel (static mode) + tunnel-identity.sh, the system unit with
  # User=@@LOGIN_USER@@, the VM-side token guard (D5 second half), the D2
  # fetch/report scripts and the fail2ban-aware backoff (D7).

runcmd:
  # Ubuntu 24.04's sshd is socket-activated: sshd-socket-generator turns
  # ListenAddress into ssh.socket very early in boot, BEFORE cloud-init writes
  # the drop-in above. Without this, the first boot listens on 0.0.0.0:22
  # until the next reboot (spike pitfall 1). The `|| restart ssh` arm covers
  # an image that is not socket-activated.
  - [ sh, -c, 'systemctl daemon-reload && (systemctl restart ssh.socket || systemctl restart ssh)' ]
