#cloud-config
# profiles/provider/repair/user-data.tmpl — cloud-init NoCloud user-data for a
# family repair host (openspec/changes/archive/2026-10-01-family-repair-host, design D1/D4/D8).
#
# Rendered on the owner's Mac by ops-scripts/package-repair-host; every
# placeholder token (upper-case name between double at-signs) is replaced
# there, and the renderer refuses to write a file that still contains one. Values are single-line by construction (names,
# ports, one public-key line, base64), so no token can inject YAML.
#
# What this file must never contain: a GitHub token (spec "維修承載機不持有
# GitHub 權杖"). The generator scans the rendered result and refuses on a hit
# (D5, first half); on the VM, repair-token-guard refuses to start the tunnel
# when a token shows up later (D5, second half).
#
# Layout on the VM (the interface scripts/tests/test-repair-host-vm.sh
# defines): the tools live in /home/@@LOGIN_USER@@/.mylinuxpool/bin/, the
# directory pool-tunnel already treats as its home (install.sh uses it on
# every other provider). Two system units with User=@@LOGIN_USER@@ run them
# (spike: simpler in cloud-init than a user unit plus linger).
#
# Why the tools are staged in /usr/local/lib/mlp-repair/ and copied by
# runcmd instead of written straight into the home directory: a
# non-deferred write_files runs BEFORE cloud-init creates the user, and
# would create /home/@@LOGIN_USER@@ as root (the user would then not own its
# own home or ~/.mylinuxpool). Deferring them would work too, but only the
# tunnel key has to be the user's file from the first moment; the tools
# are code, root-owned in the staging copy, and one install step owns the
# whole layout. Keep exactly ONE deferred entry: the test's injection that
# removes it must leave no other one behind to hide the loss.
#
# Limitations (honest list):
#   * Nothing here is verified by cloud-init itself on the Mac; the YAML is
#     parsed by the generator and the shape by the tests. Boot behaviour
#     (unit ordering, RuntimeDirectory, the first-boot ssh.socket restart)
#     was seen in the spike and is re-verified only on a real VM (tasks 8).
#   * runcmd runs once per instance-id. Changing a tool on an existing VM
#     means a new seed (new instance-id) or copying it in by hand.
#
# Deliberately NO `packages:` — the spike (OUT-spike-repair.md §2) showed the
# Ubuntu noble cloud image already ships bash, openssh, jq, netcat, curl and
# python3, and a family network may be slow, metered or filtered. Nothing
# here may depend on reaching an apt mirror.
package_update: false
package_upgrade: false

# The login user. Its way in is the owner's public keys below: the --login-key
# given at registration plus every CLIENT_* client key known at that moment
# (2026-09-29 decision, tasks 8b.1 — so the owner's other machines and the AI
# entry can all log in). This is a SNAPSHOT: the seed is static, nothing
# fetches new keys at boot, so adding or rotating a client means building a
# new bundle (re-run package-repair-host) and rebooting the VM on it.
# Revoking one key means editing authorized_keys after logging in, or the
# same rebuild. No password exists, so password login cannot be turned on by
# accident later.
users:
  - name: @@LOGIN_USER@@
    shell: /bin/bash
    lock_passwd: true
    ssh_authorized_keys:
      @@LOGIN_PUBKEYS_YAML@@
ssh_pwauth: false
disable_root: true

write_files:
  # sshd: loopback only, keys only (spec "家人網路上的其他裝置碰不到 VM 的
  # sshd"). The reverse tunnel lands on the VM's own localhost:22, so nothing
  # needs a non-loopback listener. Named 10-… so it sorts before cloud-init's
  # own 50-cloud-init.conf: sshd keeps the FIRST value it reads.
  - path: /etc/ssh/sshd_config.d/10-mlp-repair.conf
    owner: root:root
    permissions: '0644'
    content: |
      ListenAddress 127.0.0.1
      ListenAddress ::1
      PasswordAuthentication no
      KbdInteractiveAuthentication no
      PubkeyAuthentication yes
      AuthenticationMethods publickey
      PermitRootLogin no

  # Passwordless sudo for the login user ONLY (2026-09-29 decision, tasks
  # 8b.4: the live acceptance found `repair` with no root — sudo asked for a
  # password that is locked, so changing network settings or capturing
  # packets during a repair was impossible). The principal is @@LOGIN_USER@@
  # and nothing else (the generator renders it to the profile's login_user):
  # a bare ALL would hand passwordless root to any present or future local
  # account. Mode 0440 root-owned, the mode sudo requires (sudo ignores the
  # file otherwise, loudly).
  - path: /etc/sudoers.d/90-mlp-repair
    owner: root:root
    permissions: '0440'
    content: |
      @@LOGIN_USER@@ ALL=(ALL) NOPASSWD: ALL

  # Static-mode inputs for pool-tunnel (POOL_GATEWAY_HOST/USER/PORT all set
  # = no pool-resolve, no GitHub; POOL_GATEWAY_SSH_PORT is design D3).
  # No secrets in here, so it stays world-readable.
  #
  # POOL_GATEWAY_HOST is a PLACEHOLDER on purpose. The Gateway's IP changes on
  # every rotate, so it is not known when this seed is built: the launcher
  # hands it to the VM at boot over the D2 channel (task 5), which overrides
  # this value. The placeholder uses the reserved .invalid TLD (RFC 2606), so
  # anything that dials before task 5 lands fails at DNS instead of reaching
  # some other host.
  - path: /etc/mlp/tunnel.env
    owner: root:root
    permissions: '0644'
    content: |
      POOL_NODE_NAME=repair-host
      POOL_GATEWAY_PORT_RANGE=@@PROVIDER_PORT_RANGE@@
      POOL_GATEWAY_USER=@@GATEWAY_TUNNEL_USER@@
      POOL_GATEWAY_SSH_PORT=@@GATEWAY_SSH_PORT@@
      POOL_GATEWAY_HOST=@@GATEWAY_HOST@@

  # The tunnel private key. It was minted on the owner's Mac — design D4's
  # deliberate exception to "a private key never leaves the machine that made
  # it": its destination is this VM, and the family side cannot run anything.
  # defer: true because the owner is the user cloud-init creates above; a
  # non-deferred write_files runs before users exist (spike pitfall 2).
  # The path comes from tunnel-identity.sh (the single definition), rendered
  # for this user's home.
  - path: @@TUNNEL_KEY_PATH@@
    owner: @@LOGIN_USER@@:@@LOGIN_USER@@
    permissions: '0600'
    encoding: b64
    defer: true
    content: @@TUNNEL_PRIVATE_KEY_B64@@

  # ---- the tunnel: tools (staged, see the header) ---------------------------
  # Embedded by package-repair-host from the checkout it runs in, base64 so
  # no file content can break the YAML. pool-tunnel and tunnel-identity.sh
  # are the unmodified shared-configs copies (static mode, D3 port);
  # everything repair-specific is in the four repair-* scripts next to this
  # template, each with its own header.
  - path: /usr/local/lib/mlp-repair/pool-tunnel
    owner: root:root
    permissions: '0755'
    encoding: b64
    content: @@EMBED_POOL_TUNNEL_B64@@
  - path: /usr/local/lib/mlp-repair/tunnel-identity.sh
    owner: root:root
    permissions: '0644'
    encoding: b64
    content: @@EMBED_TUNNEL_IDENTITY_B64@@
  - path: /usr/local/lib/mlp-repair/repair-token-guard
    owner: root:root
    permissions: '0755'
    encoding: b64
    content: @@EMBED_REPAIR_TOKEN_GUARD_B64@@
  - path: /usr/local/lib/mlp-repair/repair-gateway-fetch
    owner: root:root
    permissions: '0755'
    encoding: b64
    content: @@EMBED_REPAIR_GATEWAY_FETCH_B64@@
  - path: /usr/local/lib/mlp-repair/repair-gateway-report
    owner: root:root
    permissions: '0755'
    encoding: b64
    content: @@EMBED_REPAIR_GATEWAY_REPORT_B64@@
  - path: /usr/local/lib/mlp-repair/repair-tunnel-launch
    owner: root:root
    permissions: '0755'
    encoding: b64
    content: @@EMBED_REPAIR_TUNNEL_LAUNCH_B64@@

  # ---- the tunnel: units ---------------------------------------------------
  # D2 "get" half: ask the launcher (host 127.0.0.1, seen as 10.0.2.2 through
  # NAT) for the Gateway IP before the tunnel starts. Before= and not
  # Required= by the tunnel: no answer must not block the tunnel unit, it
  # then dials the .invalid placeholder and fails at DNS (explicit, never a
  # guess), and the launcher script asks again before every dial.
  # RuntimeDirectory= makes /run/mlp owned by the unit's user, so the
  # launcher (same user) can refresh the file later; Preserve keeps it after
  # this oneshot exits.
  - path: /etc/systemd/system/mlp-d2-fetch.service
    owner: root:root
    permissions: '0644'
    content: |
      [Unit]
      Description=MyLinuxPool repair host: fetch the Gateway IP from the launcher (D2)
      Wants=network-online.target
      After=network-online.target
      Before=mlp-tunnel-repair.service

      [Service]
      Type=oneshot
      User=@@LOGIN_USER@@
      RuntimeDirectory=mlp
      RuntimeDirectoryPreserve=yes
      Environment=MLP_GATEWAY_ENV_FILE=/run/mlp/gateway.env
      ExecStart=/home/@@LOGIN_USER@@/.mylinuxpool/bin/repair-gateway-fetch

      [Install]
      WantedBy=multi-user.target

  # The tunnel itself. tunnel.env first, gateway.env over it: for a name set
  # in both, systemd keeps the later file's value, which is how the fetched
  # IP replaces the placeholder with no code. The leading '-' lets the
  # second file be absent. Exit 78 is the token guard's refusal (D5): it is
  # excluded from restarts so the unit stays visibly failed. RestartSec=310
  # matches the D7 rhythm in repair-tunnel-launch, so a crash-restart cannot
  # put two rejected dials closer together than the rhythm allows.
  - path: /etc/systemd/system/mlp-tunnel-repair.service
    owner: root:root
    permissions: '0644'
    content: |
      [Unit]
      Description=MyLinuxPool repair host: reverse tunnel to the Gateway (static mode)
      Wants=network-online.target mlp-d2-fetch.service
      After=network-online.target mlp-d2-fetch.service

      [Service]
      Type=simple
      User=@@LOGIN_USER@@
      # KillMode=mixed, not the default control-group: on stop, SIGTERM
      # must go to the launch script ALONE, while the ssh master it manages
      # stays alive until on_stop explicitly tears it down. With
      # control-group (the default), the master dies in the same instant as
      # the trap fires, and the nametag_remove ssh in on_stop finds no
      # master to multiplex onto — its fallback connection then races
      # a dying network, and the tag leaks (measured live: tag present
      # after a clean ACPI shutdown, no new sshproxy session in auth.log).
      KillMode=mixed
      EnvironmentFile=/etc/mlp/tunnel.env
      EnvironmentFile=-/run/mlp/gateway.env
      Environment=MLP_GATEWAY_ENV_FILE=/run/mlp/gateway.env
      ExecStart=/home/@@LOGIN_USER@@/.mylinuxpool/bin/repair-tunnel-launch
      Restart=on-failure
      RestartSec=310
      RestartPreventExitStatus=78

      [Install]
      WantedBy=multi-user.target

runcmd:
  # Ubuntu 24.04's sshd is socket-activated: sshd-socket-generator turns
  # ListenAddress into ssh.socket very early in boot, BEFORE cloud-init writes
  # the drop-in above. Without this, the first boot listens on 0.0.0.0:22
  # until the next reboot (spike pitfall 1). The `|| restart ssh` arm covers
  # an image that is not socket-activated.
  - [ sh, -c, 'systemctl daemon-reload && (systemctl restart ssh.socket || systemctl restart ssh)' ]
  # Install the staged tools into the user's ~/.mylinuxpool/bin (see the
  # header for why they are staged). The user exists by now: runcmd runs in
  # cloud-final, after users are created and after the deferred key write.
  # Every destination is spelled out, no glob: what lands here is exactly
  # what the units and the tests name. tunnel-identity.sh is sourced, not
  # run, so it gets no execute bit (same rule as install.sh and preflight).
  - [ install, -d, -o, "@@LOGIN_USER@@", -g, "@@LOGIN_USER@@", -m, "0755", /home/@@LOGIN_USER@@/.mylinuxpool, /home/@@LOGIN_USER@@/.mylinuxpool/bin ]
  - [ install, -o, "@@LOGIN_USER@@", -g, "@@LOGIN_USER@@", -m, "0755", /usr/local/lib/mlp-repair/pool-tunnel, /home/@@LOGIN_USER@@/.mylinuxpool/bin/pool-tunnel ]
  - [ install, -o, "@@LOGIN_USER@@", -g, "@@LOGIN_USER@@", -m, "0644", /usr/local/lib/mlp-repair/tunnel-identity.sh, /home/@@LOGIN_USER@@/.mylinuxpool/bin/tunnel-identity.sh ]
  - [ install, -o, "@@LOGIN_USER@@", -g, "@@LOGIN_USER@@", -m, "0755", /usr/local/lib/mlp-repair/repair-token-guard, /home/@@LOGIN_USER@@/.mylinuxpool/bin/repair-token-guard ]
  - [ install, -o, "@@LOGIN_USER@@", -g, "@@LOGIN_USER@@", -m, "0755", /usr/local/lib/mlp-repair/repair-gateway-fetch, /home/@@LOGIN_USER@@/.mylinuxpool/bin/repair-gateway-fetch ]
  - [ install, -o, "@@LOGIN_USER@@", -g, "@@LOGIN_USER@@", -m, "0755", /usr/local/lib/mlp-repair/repair-gateway-report, /home/@@LOGIN_USER@@/.mylinuxpool/bin/repair-gateway-report ]
  - [ install, -o, "@@LOGIN_USER@@", -g, "@@LOGIN_USER@@", -m, "0755", /usr/local/lib/mlp-repair/repair-tunnel-launch, /home/@@LOGIN_USER@@/.mylinuxpool/bin/repair-tunnel-launch ]
  # Enable for every later boot and start now. --no-block: runcmd runs inside
  # cloud-final.service, and a blocking start from there waits on a job the
  # boot transaction may order after cloud-final itself (a deadlock until
  # the job times out). The units' own After=/Before= still order the two.
  - [ systemctl, enable, --now, --no-block, mlp-d2-fetch.service, mlp-tunnel-repair.service ]
