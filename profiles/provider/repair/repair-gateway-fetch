#!/usr/bin/env bash
# repair-gateway-fetch — the "get" half of design D2 (openspec/changes/
# family-repair-host): ask the Windows launcher for the Gateway's current IP.
#
#   repair-gateway-fetch          (no arguments)
#
# The Gateway's IP changes on every rotate, so the seed cannot carry it (the
# seed has the placeholder gateway-ip-set-at-launch.invalid). The family
# types the IP into the launcher; the launcher serves it on the host's
# 127.0.0.1, which VirtualBox NAT exposes to the VM as 10.0.2.2 (spike
# OUT-spike-repair.md §3(c)).
#
# Protocol: GET http://${MLP_D2_HOST}:${MLP_D2_PORT}/gw, body = TWO lines
# (EPHEMERAL-INTERFACE.md item 4): the IPv4, then `name=<repair name>`.
# The name follows the same rule as the launcher side (interface item 3).
# Both lines are validated; anything else fail-closes (see below).
#
# Environment:
#   MLP_D2_HOST           default 10.0.2.2 (the NAT host address)
#   MLP_D2_PORT           default 18080 (the port the spike used)
#   MLP_D2_TIMEOUT        default 3 (seconds, whole request)
#   MLP_GATEWAY_ENV_FILE  default /run/mlp/gateway.env — the file
#                         mlp-tunnel-repair.service lays over
#                         /etc/mlp/tunnel.env (EnvironmentFile=-, later
#                         file wins) and repair-tunnel-launch re-reads
#
# Exit 0: got two valid lines, wrote them atomically (temp file in the
# same directory + mv, like pool-tunnel's publish_gateway), so nobody
# ever reads half a file:
#   POOL_GATEWAY_HOST=<ip>
#   REPAIR_NAME=<name>
# Exit 1: no answer, timeout, empty or malformed answer, or the file could
# not be written. The existing file is left exactly as it was — not
# written, not emptied. That is deliberate: repair-tunnel-launch refuses
# to dial without a valid answer (PM ruling), so a stale file can never
# be mistaken for a fresh one. It never guesses an address.
#   mlp-d2-fetch.service is ordered Before= the tunnel unit but not
#   Required= by it, so a failure here never blocks the tunnel unit.
#
# Why strict IPv4 only: the answer lands in a file systemd parses and in
# ssh's destination argument. Anything that is not four decimal octets
# (0-255, no leading zeros — glibc reads 010 as octal) is refused, which
# also rules out option injection ("-oProxyCommand=...") and newlines.
# pool-tunnel dials with AddressFamily=inet, so IPv6 would not work anyway.
#
# Limitations (honest list):
#   * One port only. design D2 says the launcher needs a fallback port when
#     18080 is taken; the VM cannot discover which one it picked. Task 6
#     (the launcher) must either keep 18080 or tell us another way.
#   * Plain HTTP, no authentication: any program on the family's Windows
#     machine that binds 127.0.0.1:18080 first can hand the VM a different
#     IP. The worst it gets is the VM dialing that address with the tunnel
#     key (see design Risks on accept-new); nothing secret is sent.
#   * No hostnames: a Gateway reachable only by name cannot be used.
#   * Concurrent runs are not coordinated; each write is atomic, the last
#     one wins.
#   * bash 3.2 compatible because the tests run it on the owner's Mac.
set -uo pipefail

D2_HOST="${MLP_D2_HOST:-10.0.2.2}"
D2_PORT="${MLP_D2_PORT:-18080}"
D2_TIMEOUT="${MLP_D2_TIMEOUT:-3}"
OUT_FILE="${MLP_GATEWAY_ENV_FILE:-/run/mlp/gateway.env}"

OCTET='(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])'
IPV4_RE="^${OCTET}\\.${OCTET}\\.${OCTET}\\.${OCTET}\$"
# Same hostname-label rule as the launcher side (interface item 3). Kept as
# a literal here (not sourced from anywhere): this file must stand alone on
# the VM, and the launcher enforces the identical text on its end.
NAME_RE='^[a-z]([a-z0-9-]{0,30}[a-z0-9])?$'

say() { printf 'repair-gateway-fetch: %s\n' "$*" >&2; }

# The knobs are ours, but they end up in a URL and a curl argument, so they
# get the same shape checks as the answer.
if ! [[ "$D2_HOST" =~ ^[A-Za-z0-9][A-Za-z0-9.-]*$ ]]; then
    say "MLP_D2_HOST='${D2_HOST}' is not a host name or address"
    exit 1
fi
if ! [[ "$D2_PORT" =~ ^[1-9][0-9]{0,4}$ ]] || (( 10#$D2_PORT > 65535 )); then
    say "MLP_D2_PORT='${D2_PORT}' is not a port"
    exit 1
fi
if ! [[ "$D2_TIMEOUT" =~ ^[1-9][0-9]{0,2}$ ]]; then
    say "MLP_D2_TIMEOUT='${D2_TIMEOUT}' is not a whole number of seconds"
    exit 1
fi

URL="http://${D2_HOST}:${D2_PORT}/gw"

# --noproxy '*': an http_proxy in the environment must never route the
# request for 10.0.2.2 somewhere else. -f: an HTTP error status is a failure,
# not a body. --max-filesize: an answer is two short lines; refuse a huge one.
body="$(curl -fsS --noproxy '*' --max-time "$D2_TIMEOUT" --max-filesize 256 "$URL" </dev/null 2>/dev/null)"
rc=$?
if [[ $rc -ne 0 ]]; then
    say "no answer from the launcher at ${URL} (curl exit ${rc}) — leaving ${OUT_FILE} as it is"
    exit 1
fi
if [[ -z "$body" ]]; then
    say "the launcher at ${URL} answered with nothing — leaving ${OUT_FILE} as it is"
    exit 1
fi

# Two-line body, nothing else. CRs are transport; one trailing LF is
# tolerated. Anything else — a single-line legacy answer, a bad IP, a
# second line that is not `name=`, a bad name, a third junk line — leaves
# the file exactly as it was (the old single-line code accepted a bare IP;
# that shape now fails closed on purpose).
norm="$(printf '%s' "$body" | tr -d '\r')"
norm="${norm%$'\n'}"
if [[ "$norm" != *$'\n'* || "$norm" == *$'\n'*$'\n'* ]]; then
    say "the launcher at ${URL} did not answer exactly 2 lines (IP + name=) — leaving ${OUT_FILE} as it is"
    exit 1
fi
ip="${norm%%$'\n'*}"
name_line="${norm#*$'\n'}"
if ! [[ "$ip" =~ $IPV4_RE ]]; then
    # Never echo the answer in full: it is untrusted input going to a log.
    say "the launcher at ${URL} answered something that is not an IPv4 address — leaving ${OUT_FILE} as it is"
    exit 1
fi
if [[ "$name_line" != name=* ]]; then
    say "the launcher at ${URL} answered a second line that is not name=<name> — leaving ${OUT_FILE} as it is"
    exit 1
fi
name="${name_line#name=}"
if [[ -z "$name" ]] || ! [[ "$name" =~ $NAME_RE ]]; then
    say "the launcher at ${URL} answered a name that fails the format — leaving ${OUT_FILE} as it is"
    exit 1
fi

out_dir="$(dirname "$OUT_FILE")"
# No mkdir: the directory is systemd's RuntimeDirectory= (owned by the
# unit's User=). Creating it here would only hide a unit that is wired
# wrong, and would litter /run on a machine where this is run by hand.
if ! tmp="$(mktemp "${out_dir}/.gateway.env.XXXXXX" 2>/dev/null)"; then
    say "cannot create a temp file in ${out_dir} — got ${ip} but could not record it"
    exit 1
fi
if ! printf 'POOL_GATEWAY_HOST=%s\nREPAIR_NAME=%s\n' "$ip" "$name" > "$tmp" 2>/dev/null; then
    rm -f "$tmp"
    say "writing ${tmp} failed — got an answer but could not record it"
    exit 1
fi
chmod 644 "$tmp" 2>/dev/null || true
if ! mv -f "$tmp" "$OUT_FILE" 2>/dev/null; then
    rm -f "$tmp"
    say "could not move the new value into ${OUT_FILE}"
    exit 1
fi
printf 'repair-gateway-fetch: Gateway %s name %s from %s -> %s\n' "$ip" "$name" "$URL" "$OUT_FILE"
exit 0
