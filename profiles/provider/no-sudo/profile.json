    "worker-host": {
      "runtime": "docker"
    },
    "github": {
      "repos": {
        "FATESAIKOU/MyBrain": [
          "read"
        ]
      }
    },
    "wol": {
      "methods": [
        "unicast"
      ]
    }
  }
}
