#!/usr/bin/env bash
# verify-profile —— 把某台機器的實際狀態與它的 profile 宣告對照。
#
#   verify-profile <node> <role/profile>   # 金鑰由 stdin 讀入
#
# 只讀不寫：對 profile 宣告的每個 unit 跑 install.sh --check。
#
# 機密處理見 RUNBOOK §9：遠端腳本先落地成檔案，金鑰才單獨走 stdin。
# 絕不把兩者灌進同一個 stdin——那個錯誤在 2026-09-13/14 造成兩次金鑰洩漏。
set -uo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")/.." && pwd)"
NODE="${1:-}"; PROFILE="${2:-}"

[[ -n "$NODE" && -n "$PROFILE" ]] || {
    echo "usage: verify-profile <node> <role/profile>   (key on stdin)" >&2; exit 2; }

PROFILE_JSON="${REPO_ROOT}/profiles/${PROFILE}/profile.json"
[[ -f "$PROFILE_JSON" ]] || { echo "verify-profile: no such profile: ${PROFILE_JSON}" >&2; exit 2; }

UNITS="$(python3 -c "import json;print(' '.join(json.load(open('${PROFILE_JSON}'))['shared_config']))")"
RESOLVE="${REPO_ROOT}/shared-configs/pool-runtime/files/pool-resolve"

HOPS="$("$RESOLVE" "$NODE" --expand-hops)" || {
    echo "verify-profile: could not resolve ${NODE}" >&2; exit 3; }
read -r JUMPS LUSER LHOST LPORT <<< "$(printf '%s' "$HOPS" | python3 -c "
import json,sys
h=json.load(sys.stdin)
j=','.join('%s@%s:%s' % (x['user'],x['host'],x['port']) for x in h[:-1]) or '-'
l=h[-1]
print(j, l['user'], l['host'], l['port'])")"

KNOWN_HOSTS="${HOME}/.mylinuxpool/known_hosts"

# 用哪把金鑰登入不在這裡決定——tunnel-identity.sh 是唯一的答案來源
# （RUNBOOK §7.12）。不帶 -i 時 ssh 只會試它內建的那幾個候選
# （id_rsa、id_ed25519…），`mlp register client` 產生的 id_mlp 不在其中，
# 每一跳都會以 Permission denied 收場。SSH_IDENTITY 已設就尊重呼叫端。
if [[ -z "${SSH_IDENTITY:-}" ]]; then
    for _ti in "${HOME}/.mylinuxpool/bin/tunnel-identity.sh" \
               "${REPO_ROOT}/shared-configs/pool-runtime/files/tunnel-identity.sh"; do
        # shellcheck source=/dev/null
        [[ -f "$_ti" ]] && { . "$_ti"; break; }
    done
    SSH_IDENTITY="${CLIENT_KEY:-}"
fi
IDENT_OPTS=()
IDENT_LEG=""
if [[ -n "${SSH_IDENTITY:-}" ]]; then
    IDENT_OPTS=(-i "$SSH_IDENTITY" -o IdentitiesOnly=yes)
    IDENT_LEG="-i ${SSH_IDENTITY} -o IdentitiesOnly=yes "
fi

SSH_OPTS=(-o BatchMode=yes -o ConnectTimeout=10
          ${IDENT_OPTS[@]+"${IDENT_OPTS[@]}"}
          # 不轉送 Mac 的 en_US.UTF-8——provider 上沒有那個 locale，
          # 遠端每開一次 bash 就警告一行，把真正的輸出淹掉。
          -o SetEnv=LC_ALL=C)

if [[ "$JUMPS" == "-" ]]; then
    # 終端就是跳板本身（gateway）：用專屬 known_hosts 驗它。
    SSH_OPTS+=(-o UserKnownHostsFile="$KNOWN_HOSTS" -o StrictHostKeyChecking=accept-new)
else
    # -J 產生的隱式 ProxyCommand **不繼承** UserKnownHostsFile 或
    # StrictHostKeyChecking，跳板那一段會退回預設的 ~/.ssh/known_hosts
    # 並在 BatchMode 下直接失敗。rotate 之前會過，只是因為舊 Gateway IP
    # 剛好躺在預設檔裡——矇對的，不是設計。
    # 明確組 ProxyCommand，把選項帶進去（跟 scripts/lib/ssh.sh 同一套做法）。
    proxy=""
    IFS=',' read -r -a hops <<< "$JUMPS"
    for h in "${hops[@]}"; do
        hu="${h%@*}"; hr="${h#*@}"; hh="${hr%:*}"; hp="${hr##*:}"
        leg="ssh ${IDENT_LEG}-o UserKnownHostsFile=${KNOWN_HOSTS} -o StrictHostKeyChecking=accept-new"
        leg+=" -o BatchMode=yes -o ConnectTimeout=10"
        [[ -n "$proxy" ]] && leg+=" -o ProxyCommand=\"${proxy}\""
        leg+=" -p ${hp} -W %h:%p ${hu}@${hh}"
        proxy="$leg"
    done
    # 最終目的地是 Gateway loopback 上的轉發埠，那裡的 host key 隨著
    # 每次 rotate/worker 重建而變，釘住它只會製造假警報。
    SSH_OPTS+=(-o UserKnownHostsFile=/dev/null -o StrictHostKeyChecking=no -o LogLevel=ERROR
               -o ProxyCommand="$proxy")
fi

STAGE="$(mktemp -d)"; trap 'rm -rf "$STAGE"' EXIT

cat > "${STAGE}/run.sh" <<'REMOTE'
#!/usr/bin/env bash
# 金鑰是這支腳本唯一的 stdin 輸入。
IFS= read -r POOL_KEY
[[ -n "$POOL_KEY" ]] || { echo "no key on stdin" >&2; exit 2; }
cd "$HOME/.mlp-verify" || exit 1
fail=0
for u in $UNITS_LIST; do
    printf '  %-22s ' "$u"
    if [[ ! -f "shared-configs/$u/install.sh" ]]; then
        echo "MISSING UNIT"; fail=1; continue
    fi
    if printf '%s' "$POOL_KEY" | bash "shared-configs/$u/install.sh" --check >/tmp/vp.out 2>&1; then
        echo "ok"
    else
        echo "DRIFT: $(tail -1 /tmp/vp.out | sed 's/^\[[^]]*\] [A-Z]* //' | cut -c1-56)"
        fail=1
    fi
done
rm -f /tmp/vp.out
exit "$fail"
REMOTE

echo "verify-profile: ${NODE} against ${PROFILE}"
echo "  units: ${UNITS}"
echo

# macOS 的 bsdtar 會替每個檔案塞 LIBARCHIVE.xattr 標頭，遠端 GNU tar 就對每個
# 檔案抱怨一行。COPYFILE_DISABLE 只擋 ._ 檔，擋不掉 xattr——要 --no-xattrs。
# GNU tar 也認這個旗標，但仍舊探一下，別假設本機是哪一種 tar。
TAR_FLAGS=()
tar --no-xattrs --version >/dev/null 2>&1 && TAR_FLAGS+=(--no-xattrs)
tar --no-mac-metadata --version >/dev/null 2>&1 && TAR_FLAGS+=(--no-mac-metadata)
COPYFILE_DISABLE=1 tar "${TAR_FLAGS[@]}" -czf "${STAGE}/payload.tgz" \
    -C "$REPO_ROOT" shared-configs scripts 2>/dev/null
ssh "${SSH_OPTS[@]}" -p "$LPORT" "${LUSER}@${LHOST}" \
    'rm -rf ~/.mlp-verify && mkdir -p ~/.mlp-verify && tar xzf - -C ~/.mlp-verify' \
    < "${STAGE}/payload.tgz" || { echo "verify-profile: could not stage" >&2; exit 3; }

ssh "${SSH_OPTS[@]}" -p "$LPORT" "${LUSER}@${LHOST}" 'cat > ~/.mlp-verify/run.sh' < "${STAGE}/run.sh"

ssh "${SSH_OPTS[@]}" -p "$LPORT" "${LUSER}@${LHOST}" \
    "UNITS_LIST='${UNITS}' bash ~/.mlp-verify/run.sh"
rc=$?

ssh "${SSH_OPTS[@]}" -p "$LPORT" "${LUSER}@${LHOST}" 'rm -rf ~/.mlp-verify' </dev/null 2>/dev/null

echo
[[ "$rc" -eq 0 ]] && echo "verify-profile: ${NODE} matches ${PROFILE}" \
                  || echo "verify-profile: ${NODE} has drift from ${PROFILE}"
exit "$rc"
