#!/usr/bin/env bash
# ops-scripts/mlp — interactive admin CLI for MyLinuxPool, run from the operator's
# own Mac (DDNS is gone; this replaces hand-building `ssh -J ...` chains).
#
# bash 3.2 COMPATIBLE ON PURPOSE — macOS ships 3.2, not bash 4+, and that
# is very easy to forget on a Mac that also has a newer bash on $PATH via
# Homebrew. Concretely, this file must never use:
#   - associative arrays (`declare -A`)
#   - ${var,,} / ${var^^} case conversion (use `tr` instead)
#   - `mapfile`/`readarray`
# Plain indexed arrays, `[[ ... ]]`, process substitution and `printf %q`
# are all fine — those have been in bash since well before 3.2.
#
# All node connection info comes from shared-configs/pool-runtime's
# pool-resolve. The one direct `gh api` call in this file (in
# gather_targets) only enumerates NODE_* variable NAMES — pool-resolve has
# no "list all nodes" capability and neither does anything else here, so
# this is the same narrow, already-established exception pool-status uses
# for the same reason. No connection info (ip/port/user/...) is ever read
# from `gh` directly — that always goes through pool-resolve.
#
# HOST KEY TRUST MODEL (2026-09-14 incident — read this before touching
# any ssh call below):
#   - The Gateway is the one real trust boundary here, and it IS a stable
#     identity between rotates — its host key is checked, but against a
#     DEDICATED known_hosts file ($GW_KNOWN_HOSTS), never the operator's
#     own ~/.ssh/known_hosts. Rotating the Gateway changes its host key
#     on purpose; polluting the user's real known_hosts with it would
#     make a *future* rotate look like a MITM attack there instead
#     ("REMOTE HOST IDENTIFICATION HAS CHANGED"), right when the operator
#     most needs to get in. `mlp trust-gateway` clears and re-accepts it.
#   - 127.0.0.1:<port> (every provider/worker, on the far side of the
#     Gateway) is NOT a stable identity — worker ports get reused for a
#     different container, and it's always 127.0.0.1 regardless of which
#     machine is actually listening. Recording a host key for it would
#     be pure false confidence: it doesn't verify anything real, and it
#     actively causes spurious "changed" failures on ordinary port reuse.
#     Every connection to that hop uses UserKnownHostsFile=/dev/null +
#     StrictHostKeyChecking=no, on purpose — not laziness.
#   - Multi-hop connections (any provider/worker) reach this mixed model
#     via `-o ProxyCommand=...`, not `-J`: `-J` applies the SAME ssh
#     options to every hop, which can't express "verify the Gateway,
#     don't verify past it". ProxyCommand runs the Gateway leg as its own
#     ssh invocation with its own options, entirely independent of the
#     outer (destination-hop) ssh's options.

set -uo pipefail

# Resolve this script's REAL location, following symlinks, so it can be
# linked into a directory on PATH (`ln -s .../ops-scripts/mlp <dir on PATH>`).
# Both $0 and BASH_SOURCE name the LINK, not the target, so dirname on
# either lands in the link's directory and every repo-relative path below
# becomes wrong — the symptom is "scripts/lib/ssh.sh: No such file".
# `readlink` without -f is used deliberately: -f is GNU-only.
#
# This block is duplicated in every ops-script because it has to run
# BEFORE the script knows where the repo is — there is nothing to source
# yet. test-script-self-location.sh asserts the copies stay identical.
_mlp_self="${BASH_SOURCE[0]:-$0}"
while [ -L "$_mlp_self" ]; do
    _mlp_dir="$(cd -P "$(dirname "$_mlp_self")" && pwd)"
    _mlp_self="$(readlink "$_mlp_self")"
    case "$_mlp_self" in /*) ;; *) _mlp_self="${_mlp_dir}/${_mlp_self}" ;; esac
done
SCRIPT_DIR="$(cd -P "$(dirname "$_mlp_self")" && pwd)"
unset _mlp_self _mlp_dir
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
POOL_RESOLVE="${REPO_ROOT}/shared-configs/pool-runtime/files/pool-resolve"
POOL_STATUS="${REPO_ROOT}/shared-configs/pool-runtime/files/pool-status"
REPO="${POOL_REPO:-FATESAIKOU/MyLinuxPool}"

# shellcheck source=../scripts/lib/ssh.sh
source "${REPO_ROOT}/scripts/lib/ssh.sh"

MLP_STATE_DIR="${HOME}/.mylinuxpool"
GW_KNOWN_HOSTS="${MLP_STATE_DIR}/known_hosts"
FWD_DIR="${MLP_STATE_DIR}/fwd"

CTL_DIR=""
CTL=""
GW_IP=""
GW_USER=""
# The Gateway's SSH port. NODE_GATEWAY.port is the one place that says it;
# absent means 22, which is what every machine had before the port moved.
GW_PORT="22"
GW_HOST_KEY=""

# ---- colors: tput, off outside a real terminal --------------------------
if [[ -t 1 ]] && command -v tput >/dev/null 2>&1; then
    C_RESET="$(tput sgr0 2>/dev/null)"
    C_BOLD="$(tput bold 2>/dev/null)"
    C_GREEN="$(tput setaf 2 2>/dev/null)"
    C_RED="$(tput setaf 1 2>/dev/null)"
    C_YELLOW="$(tput setaf 3 2>/dev/null)"
else
    C_RESET=""; C_BOLD=""; C_GREEN=""; C_RED=""; C_YELLOW=""
fi

die() {
    echo "mlp: $*" >&2
    exit 1
}

# interactive_only — succeeds iff a human is present to answer fzf.
#   Pitfall shape worth naming: fzf is correct interactively and hangs
#   forever non-interactively (scripts, agents, CI, background jobs feed it
#   from a pipe or /dev/null, never a keyboard). The test is stdin, not
#   stdout: piped stdout stays legal (mlp ls | grep x has a human watching),
#   while piped stdin never does. Callers print their own usage on failure.
interactive_only() {
    [[ -t 0 ]]
}

usage() {
    cat <<'EOF'
usage: mlp [command]

  (no command)     interactive main menu
  ls               list providers/workers with live state
  ssh [name]       connect to a node or worker (menu if name omitted)
  wake [name]       wake a node declaring power.launch (fzf pick if none given / more than one)
  down [name]       shut down a node declaring power.shutdown (fzf pick if none given / more than one)
  state            compare master (GitHub) vs Gateway state.json vs local snapshot
  status           run pool-status
  rotate [--real]  rotate the Gateway (dry run unless --real)
  worker new       build and start a worker on a provider
  worker rm [name] stop a worker and release its port
  register client  register THIS machine (the one you are on) as a client
                   — uploads your public key. Run it on the machine you
                   will connect FROM.
  register provider  register a NEW machine into the pool. Run it ON
                   that new machine, not here on the Mac.
   ssh-config       print an ssh_config for the pool (--write to install it)
   trust-gateway    re-accept the Gateway's host key after a rotate
   fwd add <node> [entryip:]entryport[:targethost:targetport]
                    forward a local port to a node (or through it to a third host)
   fwd ls           list local forwards with live state
   fwd rm [entryport|bind:entryport]  remove a forward (fzf pick when omitted)
   verify-capabilities [<node>|--all]
                    run each declared capability's verification
   migrate-capabilities [--real]
                    one-off rerunnable migration to key:object (dry run by default)
   -h, --help       show this help

requires: fzf, jq, gh — install missing ones with `brew install <name>`
EOF
}

check_deps() {
    local missing=""
    command -v fzf >/dev/null 2>&1 || missing="${missing} fzf"
    command -v jq >/dev/null 2>&1 || missing="${missing} jq"
    command -v gh >/dev/null 2>&1 || missing="${missing} gh"
    if [[ -n "$missing" ]]; then
        echo "mlp: missing required tool(s):${missing}" >&2
        echo "install with: brew install${missing}" >&2
        exit 1
    fi
    if [[ ! -x "$POOL_RESOLVE" ]]; then
        die "pool-resolve not found at ${POOL_RESOLVE} — run mlp from inside a MyLinuxPool checkout"
    fi
    mkdir -p "$MLP_STATE_DIR"
    touch "$GW_KNOWN_HOSTS"
}

# ---- gateway + shared ControlMaster --------------------------------------
# One ssh session to the Gateway, reused for every port probe below —
# never open a new connection per node. Same idea as pool-tunnel's own
# health check riding its ControlMaster instead of a fresh handshake.

# resolve_gateway [nodie] — with "nodie", a failure sets RESOLVE_DETAIL
#   and returns 1 silently instead of dying, for ViewModel callers (fwd_add)
#   that must stay output-free and keep their own return codes. A bare call
#   behaves exactly as before (same globals, same messages, dies).
resolve_gateway() {
    local json rc fatal=1
    [[ "${1:-}" == "nodie" ]] && fatal=0
    RESOLVE_DETAIL=""
    # --refresh, not the 30s cache. Every command here means "through the
    # Gateway that is current right now"; served from cache, `ls` spends up
    # to 30 seconds after a rotate probing the previous machine, which is
    # still running until it is promoted away — so the table mixes nodes
    # that moved with nodes that had not yet, and reads as a fault when
    # nothing is wrong. One API call per command is the right price for an
    # interactive tool, and it also means the host key pinned below is the
    # current one.
    json="$("$POOL_RESOLVE" gateway --refresh)"
    rc=$?
    if [[ $rc -ne 0 ]]; then
        RESOLVE_DETAIL="pool-resolve gateway failed (exit ${rc})"
        [[ $fatal -eq 1 ]] && die "$RESOLVE_DETAIL"
        return 1
    fi
    GW_IP="$(printf '%s' "$json" | jq -r '.ip // empty')"
    GW_USER="$(printf '%s' "$json" | jq -r '.user // empty')"
    GW_PORT="$(printf '%s' "$json" | jq -r '.port // 22')"
    GW_HOST_KEY="$(printf '%s' "$json" | jq -r '.host_key // empty')"
    if [[ -z "$GW_IP" || -z "$GW_USER" ]]; then
        RESOLVE_DETAIL="NODE_GATEWAY is missing ip/user"
        [[ $fatal -eq 1 ]] && die "$RESOLVE_DETAIL"
        return 1
    fi

    # NODE_GATEWAY carries the Gateway's host key, written by the rotate
    # that built the machine and writable only by Actions. Pin to it, so a
    # rotate needs no `trust-gateway` afterwards and a recycled Linode
    # address cannot collide with a stale entry (RUNBOOK §7.8).
    if [[ -n "$GW_HOST_KEY" ]]; then
        mkdir -p "$MLP_STATE_DIR"
        if ! grep -qxF "${GW_IP} ${GW_HOST_KEY}" "$GW_KNOWN_HOSTS" 2>/dev/null; then
            ssh-keygen -R "$GW_IP" -f "$GW_KNOWN_HOSTS" >/dev/null 2>&1
            printf '%s %s\n' "$GW_IP" "$GW_HOST_KEY" >> "$GW_KNOWN_HOSTS"
        fi
    fi
    return 0
}

# client_identity_path — the key this client authenticates with.
#   ONE definition, used both by mlp's own ssh calls and by the ssh_config
#   it writes. id_mlp is what `mlp register client` creates and publishes;
#   ssh's built-in candidates (id_rsa, id_ed25519, ...) do NOT include it,
#   so every ssh invocation must pass -i explicitly or it silently falls
#   back to a key the pool may have stopped authorising — which is exactly
#   how `mlp` started failing with Permission denied while a direct
#   `ssh -i ~/.ssh/id_mlp` still worked.
client_identity_path() {
    # Sourced, never restated: tunnel-identity.sh is the one place that
    # says which file holds which key (RUNBOOK §7.12 — a rule with two
    # implementations is a rule that drifts). Prefer the copy installed on
    # this machine, fall back to the repo's.
    local ti
    for ti in "${HOME}/.mylinuxpool/bin/tunnel-identity.sh" \
              "${SCRIPT_DIR}/../shared-configs/pool-runtime/files/tunnel-identity.sh"; do
        if [[ -f "$ti" ]]; then
            # shellcheck source=/dev/null
            . "$ti"
            break
        fi
    done
    [[ -n "${CLIENT_KEY:-}" ]] || return 1
    echo "$CLIENT_KEY"
}

# client_identity_opts — the -i/-o pair for ssh, empty when no key is found
#   (ssh then falls back to its own defaults, and says so itself).
client_identity_opts() {
    local key
    key="$(client_identity_path)" || return 0
    printf '%s' "-i ${key} -o IdentitiesOnly=yes"
}

# Every ssh in this file ultimately goes through scripts/lib/ssh.sh, which
# reads SSH_IDENTITY. Set it ONCE, here, for the whole program.
#
# Setting it per call site is how `mlp down` kept failing with Permission
# denied after `mlp ssh` had been fixed: do_connect declared it `local`, so
# run_on_node — a different path to the same two helpers — still had none.
# That is the same "one rule, several implementations" mistake the rule
# itself exists to prevent (RUNBOOK §7.12). A global assignment cannot be
# half-applied.
SSH_IDENTITY="$(client_identity_path 2>/dev/null || true)"

open_gateway_master() {
    CTL_DIR="$(mktemp -d "${TMPDIR:-/tmp}/mlp.XXXXXX")" || return 1
    CTL="${CTL_DIR}/ctl-gateway"
    local err rc
    local ident; read -r -a ident <<< "$(client_identity_opts)"
    err="$(ssh -M -S "$CTL" -o ControlPersist=60 -o ConnectTimeout=8 -p "$GW_PORT" \
        ${ident[@]+"${ident[@]}"} \
        -o UserKnownHostsFile="$GW_KNOWN_HOSTS" -o StrictHostKeyChecking=accept-new -o BatchMode=yes \
        -N -f "${GW_USER}@${GW_IP}" < /dev/null 2>&1)"
    rc=$?
    if [[ $rc -ne 0 ]]; then
        if printf '%s' "$err" | grep -qi 'REMOTE HOST IDENTIFICATION HAS CHANGED\|host key verification failed'; then
            echo "mlp: Gateway's host key has changed — this usually means it was just rotated." >&2
            echo "mlp: if you just ran rotate-gateway, this is expected: run 'mlp trust-gateway', then try again." >&2
        else
            echo "mlp: could not connect to Gateway (${GW_USER}@${GW_IP}):" >&2
            printf '%s\n' "$err" >&2
        fi
    fi
    return "$rc"
}

# Clears any stale entry for the Gateway's current IP from the DEDICATED
# known_hosts file (never ~/.ssh/known_hosts — see the top-of-file trust
# model note) and re-accepts whatever key it presents right now.
cmd_trust_gateway() {
    resolve_gateway
    mkdir -p "$MLP_STATE_DIR"
    touch "$GW_KNOWN_HOSTS"

    # resolve_gateway already pinned the key NODE_GATEWAY carries, which
    # is a real identity check rather than trusting whatever answers.
    # Nothing left to do, and nothing to accept on faith.
    if [[ -n "$GW_HOST_KEY" ]]; then
        printf '%spinned %s from NODE_GATEWAY%s → %s\n' \
            "$C_GREEN" "$GW_IP" "$C_RESET" "$GW_KNOWN_HOSTS"
        echo "  (no trust-on-first-use needed; this runs automatically on every mlp command)"
        return 0
    fi

    # Unconditional and silent-if-nothing-to-do on purpose: macOS's default
    # /etc/ssh/ssh_config sets HashKnownHosts yes, so entries in here won't
    # be plaintext-grep-able — ssh-keygen -R already knows how to find a
    # hashed entry, a plain grep pre-check would not.
    ssh-keygen -R "$GW_IP" -f "$GW_KNOWN_HOSTS" >/dev/null 2>&1
    echo "cleared any old host key entry for ${GW_IP} in ${GW_KNOWN_HOSTS}"

    local ident2; read -r -a ident2 <<< "$(client_identity_opts)"
    if ssh -o UserKnownHostsFile="$GW_KNOWN_HOSTS" -o StrictHostKeyChecking=accept-new -p "$GW_PORT" \
           "${ident2[@]}" \
           -o ConnectTimeout=8 -o BatchMode=yes "${GW_USER}@${GW_IP}" true < /dev/null 2>/dev/null; then
        printf '%strusted Gateway host key for %s%s → %s\n' "$C_GREEN" "$GW_IP" "$C_RESET" "$GW_KNOWN_HOSTS"
    else
        die "could not connect to ${GW_USER}@${GW_IP} to accept its host key — check connectivity first"
    fi
}

close_gateway_master() {
    if [[ -n "$CTL" && -S "$CTL" ]]; then
        ssh -S "$CTL" -O exit "${GW_USER}@${GW_IP}" < /dev/null >/dev/null 2>&1 || true
    fi
    [[ -n "$CTL_DIR" ]] && rm -rf "$CTL_DIR" 2>/dev/null || true
    CTL=""
    CTL_DIR=""
}

# Rides the shared ControlMaster; the remote-side `timeout` (present on
# the Gateway) bounds the actual check, so no local `timeout` binary is
# needed here — macOS doesn't ship one by default. Echoes one of:
#   up            a banner was read — something is listening and speaks SSH.
#   down          the remote check ran to completion and found no banner:
#                 an OBSERVATION that it is not listening.
#   inconclusive  ssh itself failed (master blipped, Gateway busy) or the
#                 remote check left no trace: nothing was observed.
# down and inconclusive never merge: "observed not listening" and "did not
# observe" are different answers, and only the first is evidence. A failed
# probe reported as down would make a Gateway hiccup look like every node
# died — the failure shape this repo keeps re-hitting. The name matches
# fwd_probe's inconclusive (docs/FWD-DESIGN.md §4: name the consequence,
# not the symptom).
#
# `< /dev/null` on the LOCAL ssh here is not optional (2026-09-14
# incident): this runs inside `while read ... done < <(gather_targets)`
# loops in cmd_ls/cmd_ssh. Without it, ssh inherits the loop's stdin —
# which is the process-substitution pipe still holding unread rows — and
# happily eats from it, so the outer `read` silently loses whatever
# gather_targets hadn't produced yet (fh-proxy and one worker vanished
# from `mlp ls` this way). The `</dev/null` *inside* the quoted remote
# command string is unrelated: that one runs on the Gateway, for `nc`.
# The trailing marker is what separates "nc ran, found nothing" from "the
# remote command never got to run": partial/absent output means NOT
# observed, so it can be classified as inconclusive instead of down.
gw_probe_port() {
    local port="$1" out rc
    out="$(ssh -S "$CTL" -o ConnectTimeout=5 "${GW_USER}@${GW_IP}" \
        "timeout 2 nc 127.0.0.1 ${port} </dev/null | head -c 4; printf %s NC_DONE" < /dev/null 2>/dev/null)"
    rc=$?
    if [[ $rc -ne 0 || "$out" != *"NC_DONE"* ]]; then
        printf 'inconclusive'
        return
    fi
    if [[ "$out" == SSH-* ]]; then
        printf 'up'
    else
        printf 'down'
    fi
}

# Same `< /dev/null` requirement as gw_probe_port above, for the same
# reason — this is called from inside gather_targets, which itself feeds
# a `while read ... done < <(...)` loop in more than one caller. Do not
# "clean up" this redirection; removing it reproduces the bug where rows
# after this call silently disappear from `mlp ls`/`mlp ssh`'s menu.
gw_run() {
    # Runs one command on the Gateway over the shared ControlMaster.
    ssh -S "$CTL" -o ConnectTimeout=8 "${GW_USER}@${GW_IP}" "$1" < /dev/null 2>/dev/null
}

# ---- generic "run a command on any registered node" ----------------------
# Builds a connection from pool-resolve <node> --expand-hops and runs $2
# there. Every real chain today is exactly gateway+1 (see ARCHITECTURE.md
# §3 — no node is ever more than one hop past the Gateway), so this
# handles exactly that shape rather than an arbitrary-depth `-J` chain —
# which also matters for the trust model below: `-J` applies the SAME
# ssh options to every hop, so it can't express "verify the Gateway,
# don't verify past it" (see the top-of-file note). ProxyCommand can,
# because it's a fully separate ssh invocation for the Gateway leg.
run_on_node() {
    local node="$1" cmd="$2"
    local hops_json count hop0 host0 port0 user0 hop1 host1 port1 user1

    hops_json="$("$POOL_RESOLVE" "$node" --expand-hops 2>/dev/null)"
    if [[ $? -ne 0 || -z "$hops_json" ]]; then
        echo "mlp: could not resolve hop chain for '${node}'" >&2
        return 1
    fi

    count="$(printf '%s' "$hops_json" | jq 'length' 2>/dev/null)"
    case "$count" in
        ''|*[!0-9]*) echo "mlp: malformed hop chain for '${node}'" >&2; return 1 ;;
    esac
    if [[ "$count" -lt 1 ]]; then
        echo "mlp: empty hop chain for '${node}'" >&2
        return 1
    fi

    hop0="$(printf '%s' "$hops_json" | jq -c '.[0]')"
    host0="$(printf '%s' "$hop0" | jq -r '.host')"
    port0="$(printf '%s' "$hop0" | jq -r '.port // 22')"
    user0="$(printf '%s' "$hop0" | jq -r '.user')"

    if [[ "$count" -eq 1 ]]; then
        # node has no hops of its own — it IS the Gateway. Direct
        # connection, verified against the dedicated Gateway known_hosts.
        ssh_gateway_only "$GW_KNOWN_HOSTS" "$user0" "$host0" "$port0" "$cmd" < /dev/null
        return $?
    fi

    if [[ "$count" -ne 2 ]]; then
        echo "mlp: hop chain for '${node}' has ${count} hops — mlp only knows how to reach gateway+1" >&2
        return 1
    fi

    hop1="$(printf '%s' "$hops_json" | jq -c '.[1]')"
    host1="$(printf '%s' "$hop1" | jq -r '.host')"
    port1="$(printf '%s' "$hop1" | jq -r '.port // 22')"
    user1="$(printf '%s' "$hop1" | jq -r '.user')"

    # hop0 is the Gateway (verified via its dedicated known_hosts); hop1
    # is 127.0.0.1:<port> on the far side of the reverse tunnel — not a
    # stable identity (see scripts/lib/ssh.sh's top-of-file note), so no
    # host-key checking at all for it, on purpose.
    ssh_via_gateway "$GW_KNOWN_HOSTS" "$user0" "$host0" "$port0" "$user1" "$host1" "$port1" "$cmd" < /dev/null
}

# ---- LAN liveness: is the machine behind a silent port actually off? ------
# 2026-09-25: fh-l was woken, the box was alive on the LAN, but boot hung —
# sshd never started, so its port stayed silent and `mlp ls` said down.
# Down and off are not the same thing: waking an already-powered machine
# fixes nothing and, worse, hides the one state that needs a human. So for
# a node we already observed as down AND that declares .power.launch (we
# then know its LAN address and who can reach it), we ask a sender that is
# currently up to ping it.
#
# layering: both are data-only (no printf/echo/fzf). cmd_ls, which is an
# old output-and-action function, stays as it is otherwise — the probe
# lives here so a future refactor has something to move.

# lan_ping_probe <sender> <target_ip> — Model: one ping through one sender.
#   Sets NODE_LAN_STATE and returns matching status:
#     alive   (0)  ping answered: the machine is on the LAN
#     off     (1)  ping ran, no answer: the machine is not responding
#     unknown (2)  no verdict was produced — ssh failed, the sender has no
#                  ping, or the address is malformed. Never claim off here:
#                  "not observed" must stay visibly different from "off".
#   Two traps this classification avoids:
#   - run_on_node's own failures (bad hop chain, ssh down) also return 1,
#     so its exit code alone cannot mean "ping ran, no reply". Its failures
#     always print to stderr, and a successful probe prints nothing at all
#     (remote stdout+stderr are discarded inside the remote command), so
#     ANY captured output is infrastructure noise -> unknown, decided
#     before the exit code is even consulted.
#   - ping's exit code is the evidence, not run_on_node's: 1 is "ran, no
#     answer" (ARP failed / no reply) and 124 is the same verdict cut off
#     by the remote timeout; 2 (no route, permission) or anything else
#     (127 = ping/timeout missing) is no evidence at all -> unknown.
lan_ping_probe() {
    local sender="$1" target_ip="$2" out rc
    NODE_LAN_STATE=""
    if [[ ! "$target_ip" =~ ^[0-9A-Fa-f:.]+$ ]]; then
        NODE_LAN_STATE="unknown"
        return 2
    fi
    out="$(run_on_node "$sender" \
        "timeout 3 ping -c 1 -W 2 ${target_ip} >/dev/null 2>&1" 2>&1)"
    rc=$?
    if [[ -n "$out" ]]; then
        NODE_LAN_STATE="unknown"
        return 2
    fi
    case "$rc" in
        0)     NODE_LAN_STATE="alive"; return 0 ;;
        1|124) NODE_LAN_STATE="off";   return 1 ;;
        *)     NODE_LAN_STATE="unknown"; return 2 ;;
    esac
}

# node_lan_liveness <node_json> <live_senders_multiline> — ViewModel:
#   normalizes the node's via list (wake_senders), intersects it with the
#   senders the caller has just seen up, and pings through the first match.
#   Sets NODE_LAN_STATE (same three values; unknown when nothing suitable is
#   available). No output, no picker. Costs nothing unless called, and it is
#   called only for a node already observed down.
node_lan_liveness() {
    local json="$1" live="$2" target_ip sender s
    NODE_LAN_STATE=""
    target_ip="$(jq -r '.power.launch.target_ip // empty' 2>/dev/null <<< "$json")"
    if [[ -z "$target_ip" ]]; then
        NODE_LAN_STATE="unknown"
        return 2
    fi
    wake_senders "$json" || { NODE_LAN_STATE="unknown"; return 2; }
    sender=""
    if [[ "${#WAKE_SENDERS[@]}" -gt 0 ]]; then
        for s in "${WAKE_SENDERS[@]}"; do
            # exact line match against the caller's up list, not a glob:
            # "fh-proxy" must not match "fh-proxy-asus".
            case $'\n'"$live"$'\n' in
                *$'\n'"$s"$'\n'*) sender="$s"; break ;;
            esac
        done
    fi
    if [[ -z "$sender" ]]; then
        NODE_LAN_STATE="unknown"
        return 2
    fi
    lan_ping_probe "$sender" "$target_ip"
}

# ---- gather providers + workers ------------------------------------------
# Prints TSV: name<TAB>type<TAB>provider<TAB>port<TAB>user
# type is one of: provider | worker (gateway is handled separately by
# callers, since it never needs a Gateway hop to reach).
gather_targets() {
    local var node json role name port user

    while IFS= read -r var; do
        [[ -n "$var" ]] || continue
        [[ "$var" == "NODE_GATEWAY" ]] && continue
        node="$(printf '%s' "${var#NODE_}" | tr '[:upper:]' '[:lower:]')"
        json="$("$POOL_RESOLVE" "$node" 2>/dev/null)" || continue
        role="$(printf '%s' "$json" | jq -r '.role // empty' 2>/dev/null)"
        [[ "$role" == "provider" ]] || continue
        name="$(printf '%s' "$json" | jq -r '.name // empty' 2>/dev/null)"
        port="$(printf '%s' "$json" | jq -r '.gateway_port // empty' 2>/dev/null)"
        user="$(printf '%s' "$json" | jq -r '.user // empty' 2>/dev/null)"
        [[ -n "$name" && -n "$port" && -n "$user" ]] || continue
        printf '%s\tprovider\t-\t%s\t%s\n' "$name" "$port" "$user"
    done < <(gh api "repos/${REPO}/actions/variables?per_page=100" --jq '.variables[].name' 2>/dev/null | grep '^NODE_')

    local workers_json count i entry wprovider wport wcontainer wname
    workers_json="$(gw_run '~/.mylinuxpool/bin/pool-port-alloc --list')"
    [[ -n "$workers_json" ]] || workers_json='[]'

    count="$(printf '%s' "$workers_json" | jq 'length' 2>/dev/null)"
    case "$count" in ''|*[!0-9]*) count=0 ;; esac

    i=0
    while [[ "$i" -lt "$count" ]]; do
        entry="$(printf '%s' "$workers_json" | jq -c ".[$i]")"
        wprovider="$(printf '%s' "$entry" | jq -r '.provider // empty')"
        wport="$(printf '%s' "$entry" | jq -r '.port // empty')"
        wcontainer="$(printf '%s' "$entry" | jq -r '.container // empty')"
        wname="$wcontainer"
        [[ -n "$wname" && "$wname" != "null" ]] || wname="worker-${wport}"
        [[ -n "$wport" ]] && printf '%s\tworker\t%s\t%s\tworker\n' "$wname" "$wprovider" "$wport"
        i=$((i + 1))
    done
}

# ---- ls -------------------------------------------------------------------
# print_state <state> <width> — color is the verdict, word is the evidence:
#   up                       green  a banner was read
#   down / off               red    port observed silent; off = the machine
#                                   itself was pinged and did not answer
#   out-of-pool              yellow machine ANSWERED on the LAN but its port
#                                   is silent (boot hung, sshd never started)
#                                   — needs a human, and must never look like
#                                   "off": waking an already-powered machine
#                                   fixes nothing (2026-09-25 incident)
#   inconclusive / unknown   yellow nothing was observed; say so instead of
#                                   guessing a verdict
# Width is passed in because "out-of-pool" and "inconclusive" are longer
# than the old fixed 4.
print_state() {
    local state="$1" width="${2:-4}" pad
    printf -v pad "%-${width}s" "$state"
    case "$state" in
        up) printf '%s%s%s\n' "$C_GREEN" "$pad" "$C_RESET" ;;
        out-of-pool|inconclusive|unknown) printf '%s%s%s\n' "$C_YELLOW" "$pad" "$C_RESET" ;;
        *) printf '%s%s%s\n' "$C_RED" "$pad" "$C_RESET" ;;
    esac
}

cmd_ls() {
    resolve_gateway
    if ! open_gateway_master; then
        echo "mlp: Gateway unreachable (${GW_USER}@${GW_IP}) — nothing can be probed" >&2
        return 1
    fi

    # Two passes: gather all rows first, then size NAME, PROVIDER and STATE
    # to the longest ones actually seen (worker container names can run
    # long, e.g. mlp-fh-proxy-base-34797874425; so can provider names, e.g.
    # fh-proxy-asus; and STATE now carries verdicts like out-of-pool) — a
    # fixed width just breaks alignment on those instead of ever being
    # "wide enough". TYPE is a closed set capped at 8 and PORT at 5 digits
    # for any real ssh port, so those stay fixed.
    local name type provider port user state r
    local rows=()
    rows[0]="$(printf 'gateway\tgateway\t-\t%s\tup' "$GW_PORT")"

    while IFS= read -r r; do
        fwd_split_row "$r"
        name="$FWD_C1"; type="$FWD_C2"; provider="$FWD_C3"; port="$FWD_C4"; user="$FWD_C5"
        [[ -n "$name" ]] || continue
        # A worker row with no provider is corrupt ledger data, not an
        # absent one ("-" already means N/A) — mark it, never blank it.
        [[ -n "$provider" ]] || provider="?"
        state="$(gw_probe_port "$port")"
        rows+=("$(printf '%s\t%s\t%s\t%s\t%s' "$name" "$type" "$provider" "$port" "$state")")
    done < <(gather_targets)

    close_gateway_master

    # LAN-liveness follow-up (the 2026-09-25 incident): a node whose port we
    # OBSERVED down may still be powered on with a hung boot. Only nodes that
    # declare .power.launch can be asked about (we then know target_ip and
    # via), and only the ones that are down — so an all-up `mlp ls` spends
    # zero extra ssh, and today only fh-l can ever trigger the extra call.
    # The up-list is the same pass's rows: what ls just showed is what gets
    # used as senders, one source of truth for both.
    local live="" nj i2=0
    for r in "${rows[@]}"; do
        fwd_split_row "$r"
        [[ "$FWD_C5" == "up" ]] && live="${live}${FWD_C1}
"
    done
    for r in "${rows[@]}"; do
        fwd_split_row "$r"
        name="$FWD_C1"; type="$FWD_C2"; state="$FWD_C5"
        if [[ "$state" == "down" && "$type" == "provider" ]]; then
            nj="$("$POOL_RESOLVE" "$name" 2>/dev/null)" || nj=""
            if [[ -n "$nj" ]] && jq -e '.power.launch != null' >/dev/null 2>&1 <<< "$nj"; then
                node_lan_liveness "$nj" "$live"
                case "$NODE_LAN_STATE" in
                    alive) state="out-of-pool" ;;
                    off)   state="off" ;;
                    *)     state="unknown" ;;
                esac
                rows[$i2]="$(printf '%s\t%s\t%s\t%s\t%s' "$FWD_C1" "$FWD_C2" "$FWD_C3" "$FWD_C4" "$state")"
            fi
        fi
        i2=$((i2 + 1))
    done

    local namewidth=4 provwidth=8 statewidth=5 r rname rlen rprov rstate
    for r in "${rows[@]}"; do
        rname="${r%%$'\t'*}"
        rlen="${#rname}"
        [[ "$rlen" -gt "$namewidth" ]] && namewidth="$rlen"
        rprov="${r#*$'\t'}"; rprov="${rprov#*$'\t'}"; rprov="${rprov%%$'\t'*}"
        rlen="${#rprov}"
        [[ "$rlen" -gt "$provwidth" ]] && provwidth="$rlen"
        rstate="${r##*$'\t'}"
        rlen="${#rstate}"
        [[ "$rlen" -gt "$statewidth" ]] && statewidth="$rlen"
    done

    local fmt="%-${namewidth}s  %-9s %-${provwidth}s %-6s "
    printf "${C_BOLD}${fmt}%-${statewidth}s${C_RESET}\n" "NAME" "TYPE" "PROVIDER" "PORT" "STATE"

    for r in "${rows[@]}"; do
        fwd_split_row "$r"
        name="$FWD_C1"; type="$FWD_C2"; provider="$FWD_C3"; port="$FWD_C4"; state="$FWD_C5"
        printf "$fmt" "$name" "$type" "$provider" "$port"
        print_state "$state" "$statewidth"
    done
}

# ---- ssh ------------------------------------------------------------------
# target_resolve <name> — Model: name -> connection data, nothing shown.
#   The resolving half of the old connect_by_name, shared by do_connect and
#   fwd_add so the two paths cannot grow separate copies of it.
#   Sets TARGET_TYPE/TARGET_USER/TARGET_PORT and returns 0; on failure sets
#   TARGET_ERR (unreachable|notfound) and returns 1. No output of its own —
#   callers turn TARGET_ERR into messages. Assumes resolve_gateway already
#   ran (GW_* set), exactly as connect_by_name did. The worker-ledger master
#   is opened silent so a dead Gateway stays a return code, not output.
target_resolve() {
    local name="$1" json rc role port user workers_json match_port master_err
    TARGET_TYPE=""
    TARGET_USER=""
    TARGET_PORT=""
    TARGET_ERR=""
    TARGET_DETAIL=""

    json="$("$POOL_RESOLVE" "$name" 2>/dev/null)"
    rc=$?
    if [[ $rc -eq 0 && -n "$json" ]]; then
        role="$(jq -r '.role // empty' 2>/dev/null <<< "$json")"
        if [[ "$role" == "gateway" ]]; then
            TARGET_TYPE="gateway"
            TARGET_USER="$GW_USER"
            TARGET_PORT="$GW_PORT"
            return 0
        fi
        if [[ "$role" == "provider" ]]; then
            port="$(jq -r '.gateway_port // empty' 2>/dev/null <<< "$json")"
            user="$(jq -r '.user // empty' 2>/dev/null <<< "$json")"
            if [[ -n "$port" && -n "$user" ]]; then
                TARGET_TYPE="provider"
                TARGET_USER="$user"
                TARGET_PORT="$port"
                return 0
            fi
        fi
    fi

    # Not a registered node — workers deliberately aren't (spec §10.3), so
    # try matching by container name or bare port against the Gateway's
    # own placeholder ledger. The master is opened silent and its chatter
    # is carried back in TARGET_DETAIL for the caller to show — the old
    # inline code showed it, and this Model shows nothing itself.
    master_err="$(mktemp "${TMPDIR:-/tmp}/mlp-target-resolve.XXXXXX" 2>/dev/null)" || master_err=""
    if [[ -n "$master_err" ]]; then
        open_gateway_master 2>"$master_err"
        rc=$?
        TARGET_DETAIL="$(cat "$master_err" 2>/dev/null)"
        rm -f "$master_err"
    else
        open_gateway_master 2>/dev/null
        rc=$?
    fi
    if [[ $rc -eq 0 ]]; then
        workers_json="$(gw_run '~/.mylinuxpool/bin/pool-port-alloc --list')"
        close_gateway_master
    else
        TARGET_ERR="unreachable"
        return 1
    fi
    if [[ -z "$workers_json" ]]; then
        workers_json="[]"
    fi

    if [[ "$name" =~ ^[0-9]+$ ]]; then
        match_port="$name"
    else
        match_port="$(jq -r --arg n "$name" \
            '[.[] | select(.container == $n)] | first | .port // empty' 2>/dev/null <<< "$workers_json")"
    fi

    if [[ -n "$match_port" && "$match_port" != "null" ]]; then
        TARGET_TYPE="worker"
        TARGET_USER="worker"
        TARGET_PORT="$match_port"
        return 0
    fi

    TARGET_ERR="notfound"
    return 1
}

do_connect() {
    local type port user
    if [[ $# -eq 1 ]]; then
        # Name form: resolve through the shared Model, then fall through to
        # the same login below. This is what connect_by_name used to inline.
        target_resolve "$1" || {
            case "$TARGET_ERR" in
                unreachable)
                    [[ -n "$TARGET_DETAIL" ]] && printf '%s\n' "$TARGET_DETAIL" >&2
                    die "Gateway unreachable (${GW_USER}@${GW_IP})"
                    ;;
                *) die "no such node or worker: $1" ;;
            esac
        }
        type="$TARGET_TYPE"
        port="$TARGET_PORT"
        user="$TARGET_USER"
    else
        type="$1"
        port="$2"
        user="$3"
    fi
    # This is an interactive login (a human is about to get a shell) —
    # BatchMode must be off here, unlike every other caller of
    # ssh_gateway_only/ssh_via_gateway in this file, or a key needing a
    # passphrase would fail instead of prompting.
    local SSH_BATCH_MODE=no
    case "$type" in
        gateway)
            ssh_gateway_only "$GW_KNOWN_HOSTS" "$GW_USER" "$GW_IP" "$GW_PORT"
            ;;
        provider|worker)
            # See scripts/lib/ssh.sh's trust-model note: the Gateway leg
            # is verified (dedicated known_hosts, via ProxyCommand); the
            # 127.0.0.1:<port> leg is not checked at all, on purpose.
            ssh_via_gateway "$GW_KNOWN_HOSTS" "$GW_USER" "$GW_IP" "$GW_PORT" "$user" 127.0.0.1 "$port"
            ;;
        *)
            die "unknown target type: ${type}"
            ;;
    esac
}

connect_by_name() {
    do_connect "$1"
}

cmd_ssh() {
    local target="${1:-}"
    if [[ "$target" == -* ]]; then
        echo "usage: mlp ssh [<node-name|worker-name|port>]  (fzf pick when omitted)" >&2
        exit 2
    fi
    # NOTE: the non-interactive guard for the omitted-name case lives at
    # main's ssh dispatch, one frame up. test-tab-field-collapse.sh calls
    # cmd_ssh directly with a stubbed fzf and non-TTY stdin on purpose (to
    # exercise the pick-then-dial path headlessly) — a guard at this level
    # would delete that coverage. The CLI can only reach this function
    # through main, and main's menu is itself TTY-gated, so the boundary
    # guard covers every real invocation.
    resolve_gateway

    if [[ -n "$target" ]]; then
        connect_by_name "$target"
        return $?
    fi

    if ! open_gateway_master; then
        die "Gateway unreachable (${GW_USER}@${GW_IP})"
    fi

    local name type provider port user state selected r
    selected="$(
        {
            printf 'gateway\tgateway\t-\t%s\t%s\tup\n' "$GW_PORT" "$GW_USER"
            while IFS= read -r r; do
                fwd_split_row "$r"
                name="$FWD_C1"; type="$FWD_C2"; provider="$FWD_C3"; port="$FWD_C4"; user="$FWD_C5"
                [[ -n "$name" ]] || continue
                [[ -n "$provider" ]] || provider="?"
                state="$(gw_probe_port "$port")"
                printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$name" "$type" "$provider" "$port" "$user" "$state"
            done < <(gather_targets)
        } | fzf --delimiter=$'\t' --with-nth=1,2,3,4,6 \
                --header='NAME  TYPE  PROVIDER  PORT  STATE' \
                --prompt='ssh> ' --height='~60%'
    )"

    close_gateway_master

    [[ -n "$selected" ]] || return 0

    fwd_split_row "$selected"
    name="$FWD_C1"; type="$FWD_C2"; provider="$FWD_C3"; port="$FWD_C4"; user="$FWD_C5"
    do_connect "$type" "$port" "$user"
}

# ---- wake / down ------------------------------------------------------------
# The set of nodes that can be woken / shut down is whatever NODE_* declares
# under .power — never a hardcoded name (REDESIGN §3.35: NODE_FH_L.power was
# the master copy, and cmd_wake/cmd_down hardcoding fh-l was the second).
power_targets() {
    local action="$1" var node json
    while IFS= read -r var; do
        [[ -n "$var" ]] || continue
        [[ "$var" == "NODE_GATEWAY" ]] && continue
        node="$(printf '%s' "${var#NODE_}" | tr '[:upper:]' '[:lower:]' | tr '_' '-')"
        json="$("$POOL_RESOLVE" "$node" 2>/dev/null)" || continue
        if printf '%s' "$json" | jq -e --arg a "$action" '.power[$a] != null' >/dev/null 2>&1; then
            printf '%s\n' "$node"
        fi
    done < <(gh api "repos/${REPO}/actions/variables?per_page=100" --jq '.variables[].name' 2>/dev/null | grep '^NODE_')
}

# pick_power_target <action> — returns exactly one node name.
pick_power_target() {
    local action="$1" nodes=() n
    while IFS= read -r n; do
        [[ -n "$n" ]] && nodes+=("$n")
    done < <(power_targets "$action")

    case "${#nodes[@]}" in
        0)
            die "no node declares .power.${action} — nothing to wake/down"
            ;;
        1)
            printf '%s\n' "${nodes[0]}"
            ;;
        *)
            # Several candidates need a human to choose; without one, say
            # which argument would have avoided the question.
            interactive_only || {
                case "$action" in
                    launch) echo "usage: mlp wake [<node-name>]  (node must declare .power.launch; fzf pick when omitted)" >&2 ;;
                    *) echo "usage: mlp down [<node-name>]  (node must declare .power.shutdown; fzf pick when omitted)" >&2 ;;
                esac
                exit 2
            }
            printf '%s\n' "${nodes[@]}" \
                | fzf --prompt="${action}> " --height='~40%' \
                      --header="multiple nodes declare .power.${action} — pick one"
            ;;
    esac
}

# wake_senders <json> — Model: normalize .power.launch.via to an array.
#   A string is a one-element array, never a second code path; order is
#   priority. Sets WAKE_SENDERS (deduped, woken node itself filtered — a
#   powered-off box cannot wake itself) and returns 0. Missing/empty via,
#   or everything filtered away, is an error: return 1. No output of its
#   own; callers turn the bare code into messages.
wake_senders() {
    local json="$1" self s seen existing
    WAKE_SENDERS=()
    self="$(jq -r '.name // empty' 2>/dev/null <<< "$json")"
    while IFS= read -r s; do
        [[ -n "$s" ]] || continue
        [[ "$s" == "$self" ]] && continue
        seen=0
        if [[ "${#WAKE_SENDERS[@]}" -gt 0 ]]; then
            for existing in "${WAKE_SENDERS[@]}"; do
                if [[ "$existing" == "$s" ]]; then
                    seen=1
                    break
                fi
            done
        fi
        [[ "$seen" -eq 0 ]] && WAKE_SENDERS+=("$s")
    done < <(jq -r '.power.launch.via | if type == "array" then .[] elif type == "string" then . else empty end | select(type == "string" and length > 0)' 2>/dev/null <<< "$json")
    [[ "${#WAKE_SENDERS[@]}" -gt 0 ]]
}

# wake_try_sender <sender> <mac> <target_ip> <port> <budget_secs> — ViewModel.
#   Sends one WoL via sender, then polls the Gateway loopback port for up to
#   budget seconds. Returns 0 woke | 2 could not send (fast, no budget spent)
#   | 3 sent but provably still down | 4 sent, unverifiable. Sets WAKE_ELAPSED
#   (seconds waited this try) and, off the happy path, WAKE_SEND_ERR (captured
#   send chatter or the verify failure, for the View to list).
#   The trigger is the port poll, never the send exit code: pool-wol 0 proves
#   nothing about the far side (RUNBOOK §4.1). Opens its own Gateway master
#   so one call is one self-contained attempt. States 3 and 4 never merge:
#   3 means we watched the full budget expire with the port down; 4 means a
#   dead Gateway master left us with no observation at all — reporting 4 as
#   "did not wake" would blame the sender (or the sleeping box) for something
#   we never saw, the same lie class as fwd's timeout-versus-unreachable.
wake_try_sender() {
    local sender="$1" mac="$2" target_ip="$3" port="$4" budget="$5"
    local rc send_out state waited
    WAKE_SEND_ERR=""
    WAKE_ELAPSED=0
    send_out="$(run_on_node "$sender" "~/.mylinuxpool/bin/pool-wol ${mac} ${target_ip}" 2>&1)"
    rc=$?
    if [[ "$rc" -ne 0 ]]; then
        WAKE_SEND_ERR="$send_out"
        return 2
    fi
    if ! open_gateway_master 2>/dev/null; then
        WAKE_SEND_ERR="gateway unreachable, cannot verify wake"
        close_gateway_master
        return 4
    fi
    waited=0
    while [[ "$waited" -lt "$budget" ]]; do
        state="$(gw_probe_port "$port")"
        if [[ "$state" == "up" ]]; then
            close_gateway_master
            WAKE_ELAPSED="$waited"
            return 0
        fi
        sleep 5
        waited=$((waited + 5))
    done
    close_gateway_master
    WAKE_ELAPSED="$waited"
    return 3
}

cmd_wake() {
    local node="${1:-}" json rc method mac target_ip port
    local total i sender budget trc reason elapsed waited_total n_unknown
    local fail_names=() fail_reasons=() k
    if [[ "$node" == -* ]]; then
        echo "usage: mlp wake [<node-name>]  (node must declare .power.launch; fzf pick when omitted)" >&2
        exit 2
    fi
    if [[ -z "$node" ]]; then
        # Omitting the name opens the picker — or, with exactly one
        # candidate, pick_power_target returns it without fzf. That made
        # `mlp wake </dev/null` wake the sole node FOR REAL and exit 0:
        # not a hang but a side effect nobody asked for (2026-09-25).
        # Refuse before resolve_gateway: no network, no side effect,
        # immediately.
        interactive_only || {
            echo "usage: mlp wake [<node-name>]  (node must declare .power.launch; fzf pick when omitted)" >&2
            exit 2
        }
    fi
    resolve_gateway

    if [[ -n "$node" ]]; then
        json="$("$POOL_RESOLVE" "$node")"
        rc=$?
        [[ $rc -eq 0 ]] || die "pool-resolve ${node} failed (exit ${rc})"
        if ! printf '%s' "$json" | jq -e '.power.launch != null' >/dev/null 2>&1; then
            die "${node} does not declare .power.launch — nothing to wake"
        fi
    else
        node="$(pick_power_target launch)"
        [[ -n "$node" ]] || { echo "aborted."; return 1; }
        json="$("$POOL_RESOLVE" "$node")"
        rc=$?
        [[ $rc -eq 0 ]] || die "pool-resolve ${node} failed (exit ${rc})"
    fi

    method="$(printf '%s' "$json" | jq -r '.power.launch.method // empty')"
    mac="$(printf '%s' "$json" | jq -r '.power.launch.mac // empty')"
    target_ip="$(printf '%s' "$json" | jq -r '.power.launch.target_ip // empty')"
    port="$(printf '%s' "$json" | jq -r '.gateway_port // empty')"

    [[ "$method" == "wol-unicast" ]] || die "NODE_${node}.power.launch.method is '${method:-<empty>}', expected wol-unicast"
    [[ -n "$mac" && -n "$target_ip" && -n "$port" ]] || die "NODE_${node}.power.launch is missing mac/target_ip, or gateway_port is missing"

    wake_senders "$json" || die "${node} declares no usable .power.launch.via sender"

    total="${#WAKE_SENDERS[@]}"
    waited_total=0
    n_unknown=0
    i=0
    for sender in "${WAKE_SENDERS[@]}"; do
        i=$((i + 1))
        if [[ "$i" -lt "$total" ]]; then
            budget=90
        else
            # Last sender eats the remainder: once the list is exhausted
            # there is nothing else to try, so waiting it out beats giving
            # up early to arithmetic. Total budget stays 300 seconds.
            budget=$((300 - waited_total))
        fi
        echo "waking ${node} via ${sender} (${i}/${total}): unicast WoL to ${mac} @ ${target_ip} ..."
        wake_try_sender "$sender" "$mac" "$target_ip" "$port" "$budget"
        trc=$?
        if [[ "$trc" -eq 0 ]]; then
            elapsed="$WAKE_ELAPSED"
            printf '\n%s%s is up%s (after %ss, via %s)\n' "$C_GREEN" "$node" "$C_RESET" "$((waited_total + elapsed))" "$sender"
            return 0
        fi
        if [[ "$trc" -eq 2 ]]; then
            reason="$WAKE_SEND_ERR"
            [[ -n "$reason" ]] || reason="unknown error"
            printf '  %s: could not send (%s)\n' "$sender" "$reason"
            fail_names+=("$sender")
            fail_reasons+=("could not send: $reason")
            continue
        fi
        if [[ "$trc" -eq 4 ]]; then
            reason="$WAKE_SEND_ERR"
            [[ -n "$reason" ]] || reason="unknown error"
            printf '  %s: sent, but could not verify whether %s woke (%s)\n' "$sender" "$node" "$reason"
            fail_names+=("$sender")
            fail_reasons+=("sent, but could not verify whether ${node} woke (${reason})")
            n_unknown=$((n_unknown + 1))
            continue
        fi
        printf '  %s: sent, but %s did not come up within %ss\n' "$sender" "$node" "$budget"
        fail_names+=("$sender")
        fail_reasons+=("sent, but did not come up within ${budget}s")
        waited_total=$((waited_total + budget))
    done

    # Any unknown poisons "could not wake": an unverified send may well have
    # worked, so the honest ending is unverified, not failed. The per-sender
    # lines above already say which is which; the header just must not lie.
    if [[ "$n_unknown" -gt 0 ]]; then
        if [[ "$n_unknown" -eq "$total" ]]; then
            echo "could not verify whether ${node} woke — every sender unverified:"
        else
            echo "could not verify whether ${node} woke:"
        fi
    else
        echo "could not wake ${node} — every sender failed:"
    fi
    k=0
    while [[ "$k" -lt "${#fail_names[@]}" ]]; do
        printf '  %s: %s\n' "${fail_names[$k]}" "${fail_reasons[$k]}"
        k=$((k + 1))
    done
    if [[ "$n_unknown" -gt 0 ]]; then
        die "wake result unknown for ${node} — check 'mlp ls' to verify"
    fi
    die "all ${total} wake sender(s) failed for ${node}"
}

cmd_down() {
    local node="${1:-}" json rc method shutdown_cmd port confirm waited state
    if [[ "$node" == -* ]]; then
        echo "usage: mlp down [<node-name>]  (node must declare .power.shutdown; fzf pick when omitted)" >&2
        exit 2
    fi
    if [[ -z "$node" ]]; then
        # Same as wake: an omitted name means the picker — and worse, the
        # confirmation read below would eat whatever came down the pipe
        # instead of asking (2026-09-25). Refuse before resolve_gateway.
        interactive_only || {
            echo "usage: mlp down [<node-name>]  (node must declare .power.shutdown; fzf pick when omitted)" >&2
            exit 2
        }
    fi
    resolve_gateway

    if [[ -n "$node" ]]; then
        json="$("$POOL_RESOLVE" "$node")"
        rc=$?
        [[ $rc -eq 0 ]] || die "pool-resolve ${node} failed (exit ${rc})"
        if ! printf '%s' "$json" | jq -e '.power.shutdown != null' >/dev/null 2>&1; then
            die "${node} does not declare .power.shutdown — nothing to shut down"
        fi
    else
        node="$(pick_power_target shutdown)"
        [[ -n "$node" ]] || { echo "aborted."; return 1; }
        json="$("$POOL_RESOLVE" "$node")"
        rc=$?
        [[ $rc -eq 0 ]] || die "pool-resolve ${node} failed (exit ${rc})"
    fi

    method="$(printf '%s' "$json" | jq -r '.power.shutdown.method // empty')"
    shutdown_cmd="$(printf '%s' "$json" | jq -r '.power.shutdown.command // empty')"
    port="$(printf '%s' "$json" | jq -r '.gateway_port // empty')"

    [[ "$method" == "ssh" && -n "$shutdown_cmd" ]] || die "NODE_${node}.power.shutdown is missing method/command"
    [[ -n "$port" ]] || die "NODE_${node} is missing gateway_port"

    printf '%sThis will shut down %s%s (running: %s)\n' "$C_YELLOW" "$node" "$C_RESET" "$shutdown_cmd"
    printf 'Type "yes" to confirm: '
    read -r confirm
    if [[ "$confirm" != "yes" ]]; then
        echo "aborted."
        return 1
    fi

    echo "sending shutdown command to ${node}..."
    if ! run_on_node "$node" "$shutdown_cmd"; then
        die "failed to run shutdown command on ${node}"
    fi

    echo "waiting for ${node}'s port (${port}) to disappear from the Gateway (up to 2 minutes)"
    if ! open_gateway_master; then
        die "Gateway unreachable while waiting"
    fi

    waited=0
    while [[ "$waited" -lt 120 ]]; do
        state="$(gw_probe_port "$port")"
        if [[ "$state" == "down" ]]; then
            close_gateway_master
            printf '\n%s%s is down%s (after %ss)\n' "$C_GREEN" "$node" "$C_RESET" "$waited"
            return 0
        fi
        printf '.'
        sleep 5
        waited=$((waited + 5))
    done

    close_gateway_master
    echo ""
    die "${node}'s port is still up after 2 minutes — shutdown may not have worked"
}

# ---- mlp state --------------------------------------------------------------
# Compares the three copies of cluster truth (REDESIGN N7):
#   master   GitHub NODE_* + POOL_WORKERS
#   gateway  /var/lib/mylinuxpool/state.json (the cache the Gateway serves)
#   local    ~/.mylinuxpool/state.json (this Mac's snapshot, if any)
# Exits non-zero when anything diverges — that is what made a pre-ledger
# worker invisible to a rotate in 2026-09-14.
cmd_state() {
    resolve_gateway
    if ! open_gateway_master; then
        die "Gateway unreachable (${GW_USER}@${GW_IP})"
    fi

    local master_nodes master_ports master_serial
    local gw_json gw_serial gw_nodes gw_ports gw_workers
    local local_json local_serial local_nodes local_ports

    # Normalize master node names to the same lowercase-hyphen spelling
    # state.json uses for .nodes keys (NODE_FH_L -> fh-l), so the comm
    # comparisons below compare like with like.
    master_nodes="$({ gh api "repos/${REPO}/actions/variables?per_page=100" --jq '.variables[].name' 2>/dev/null | grep '^NODE_' | sed 's/^NODE_//' | tr '[:upper:]' '[:lower:]' | tr '_' '-' | sort; })"
    master_ports="$(gw_run '~/.mylinuxpool/bin/pool-port-alloc --list' | jq -r '[.[].port] | sort | .[]' 2>/dev/null)"

    gw_json="$(gw_run 'cat /var/lib/mylinuxpool/state.json')"
    if [[ -z "$gw_json" ]]; then
        echo "mlp: gateway state.json unreadable — is the Gateway provisioned with the state cache?" >&2
        gw_serial=""; gw_nodes=""; gw_ports=""
    else
        gw_serial="$(printf '%s' "$gw_json" | jq -r '.serial // empty')"
        gw_nodes="$(printf '%s' "$gw_json" | jq -r '.nodes | keys[]' 2>/dev/null | sort)"
        gw_ports="$(printf '%s' "$gw_json" | jq -r '[.workers[].port] | sort | .[]' 2>/dev/null)"
    fi

    if [[ -f "${MLP_STATE_DIR}/state.json" ]]; then
        local_json="$(cat "${MLP_STATE_DIR}/state.json" 2>/dev/null)"
        local_serial="$(printf '%s' "$local_json" | jq -r '.serial // empty')"
        local_nodes="$(printf '%s' "$local_json" | jq -r '.nodes | keys[]' 2>/dev/null | sort)"
        local_ports="$(printf '%s' "$local_json" | jq -r '[.workers[].port] | sort | .[]' 2>/dev/null)"
    else
        local_serial=""; local_nodes=""; local_ports=""
    fi

    close_gateway_master

    # master has no serial — only the two cache copies do
    master_serial=""

    local drift=0
    local name

    printf '%s%sSTATE%s\n' "$C_BOLD" "$C_BOLD" "$C_RESET"
    printf '  %-10s %-10s %-10s %-10s\n' "copy" "serial" "nodes" "ports"
    printf '  %-10s %-10s %-10s %-10s\n' "master" "${master_serial:--}" "$(printf '%s' "$master_nodes" | grep -c . || true)" "$(printf '%s' "$master_ports" | grep -c . || true)"
    printf '  %-10s %-10s %-10s %-10s\n' "gateway" "${gw_serial:--}" "$(printf '%s' "$gw_nodes" | grep -c . || true)" "$(printf '%s' "$gw_ports" | grep -c . || true)"
    printf '  %-10s %-10s %-10s %-10s\n' "local" "${local_serial:--}" "$(printf '%s' "$local_nodes" | grep -c . || true)" "$(printf '%s' "$local_ports" | grep -c . || true)"

    # node sets
    local only_gw only_local only_master common
    only_master="$(comm -23 <(printf '%s\n' "$master_nodes") <(printf '%s\n' "$gw_nodes") 2>/dev/null)"
    only_gw="$(comm -13 <(printf '%s\n' "$master_nodes") <(printf '%s\n' "$gw_nodes") 2>/dev/null)"
    only_local="$(comm -13 <(printf '%s\n' "$master_nodes") <(printf '%s\n' "$local_nodes") 2>/dev/null)"
    if [[ -n "$only_master" || -n "$only_gw" ]]; then
        echo ""
        echo "node set differs (master vs gateway):"
        [[ -n "$only_master" ]] && printf '%s    only in master:   %s%s\n' "$C_RED" "$(printf '%s' "$only_master" | tr '\n' ' ')" "$C_RESET"
        [[ -n "$only_gw" ]] && printf '%s    only in gateway:  %s%s\n' "$C_RED" "$(printf '%s' "$only_gw" | tr '\n' ' ')" "$C_RESET"
        drift=1
    fi
    if [[ -n "$only_local" ]]; then
        echo ""
        printf '%s    local has nodes missing from master: %s%s\n' "$C_YELLOW" "$(printf '%s' "$only_local" | tr '\n' ' ')" "$C_RESET"
    fi

    # worker port sets
    local only_ports_master only_ports_gw
    only_ports_master="$(comm -23 <(printf '%s\n' "$master_ports") <(printf '%s\n' "$gw_ports") 2>/dev/null)"
    only_ports_gw="$(comm -13 <(printf '%s\n' "$master_ports") <(printf '%s\n' "$gw_ports") 2>/dev/null)"
    if [[ -n "$only_ports_master" || -n "$only_ports_gw" ]]; then
        echo ""
        echo "worker port set differs (master vs gateway):"
        [[ -n "$only_ports_master" ]] && printf '%s    only in master:   %s%s\n' "$C_RED" "$(printf '%s' "$only_ports_master" | tr '\n' ' ')" "$C_RESET"
        [[ -n "$only_ports_gw" ]] && printf '%s    only in gateway:  %s%s\n' "$C_RED" "$(printf '%s' "$only_ports_gw" | tr '\n' ' ')" "$C_RESET"
        drift=1
    fi

    # serials
    if [[ -n "$gw_serial" && -n "$local_serial" && "$gw_serial" != "$local_serial" ]]; then
        echo ""
        printf '%s    serial differs: gateway=%s local=%s%s\n' "$C_YELLOW" "$gw_serial" "$local_serial" "$C_RESET"
        drift=1
    fi

    if [[ "$drift" -eq 0 ]]; then
        echo ""
        printf '%sconsistent — master, gateway and local agree%s\n' "$C_GREEN" "$C_RESET"
        return 0
    fi
    return 1
}

cmd_status() {
    [[ -x "$POOL_STATUS" ]] || die "pool-status not found at ${POOL_STATUS}"
    "$POOL_STATUS" "$@"
}

# ---- workflow-backed commands ------------------------------------------------
# rotate / create-worker / delete-worker run as GitHub Actions, and these
# commands trigger them rather than reimplementing them.
#
# Not for convenience. Those flows need LINODE_TOKEN, FILE_CRYPTO_KEY,
# SSH_KEY_ACTIONS and the ability to look up a secret by a name known only
# at run time; doing them here would put all of that on a laptop that
# travels. And the step ordering, the rollback that only arms after the
# switch point, and the orphan sweep live in the workflow — a local
# reimplementation would be a second copy of that logic, free to drift
# from the one Actions actually runs.
#
# The line: anything needing credentials or orchestration goes through a
# workflow; anything interactive or latency-sensitive (ssh/wake/down)
# stays local.

# wf_dispatch <workflow-file> <label> [-f k=v ...]
wf_dispatch() {
    local wf="$1" label="$2"; shift 2
    local before after run_id i

    # The dispatch API returns nothing identifying the run it creates, so
    # remember the newest id first and watch for a different one.
    before="$(gh run list --workflow="$wf" --repo "$REPO" --limit 1 \
                --json databaseId --jq '.[0].databaseId // 0' 2>/dev/null)"

    gh workflow run "$wf" --repo "$REPO" "$@" >/dev/null 2>&1 \
        || die "could not dispatch ${wf} (is gh authenticated for ${REPO}?)"

    printf '%s%s%s dispatched, waiting for the run to appear' "$C_BOLD" "$label" "$C_RESET"
    run_id=""
    for i in $(seq 1 20); do
        sleep 3
        after="$(gh run list --workflow="$wf" --repo "$REPO" --limit 1 \
                   --json databaseId --jq '.[0].databaseId // 0' 2>/dev/null)"
        if [[ -n "$after" && "$after" != "$before" ]]; then run_id="$after"; break; fi
        printf '.'
    done
    echo ""
    [[ -n "$run_id" ]] || die "the run never appeared — check https://github.com/${REPO}/actions"

    echo "  https://github.com/${REPO}/actions/runs/${run_id}"
    echo ""
    wf_follow "$run_id"
}

# wf_follow <run-id> — prints each step as it settles; exits with the run's status.
wf_follow() {
    local run_id="$1" seen="" json cur new status conclusion line mark

    while true; do
        json="$(gh run view "$run_id" --repo "$REPO" --json status,conclusion,jobs 2>/dev/null)" || {
            sleep 10; continue
        }
        cur="$(printf '%s' "$json" | jq -r '
            .jobs[].steps[]
            | select(.conclusion != null and .conclusion != "")
            | "\(.number)\t\(.conclusion)\t\(.name)"' 2>/dev/null | sort -n)"

        new="$(comm -13 <(printf '%s\n' "$seen") <(printf '%s\n' "$cur") 2>/dev/null)"
        while IFS=$'\t' read -r _ conclusion line; do
            [[ -n "$line" ]] || continue
            case "$conclusion" in
                success)  mark="${C_GREEN}ok${C_RESET}      " ;;
                skipped)  mark="—       " ;;
                *)        mark="${C_RED}${conclusion}${C_RESET} " ;;
            esac
            printf '  %s%s\n' "$mark" "$line"
        done <<< "$new"
        seen="$cur"

        status="$(printf '%s' "$json" | jq -r '.status')"
        if [[ "$status" == "completed" ]]; then
            conclusion="$(printf '%s' "$json" | jq -r '.conclusion')"
            echo ""
            if [[ "$conclusion" == "success" ]]; then
                printf '%srun finished: success%s\n' "$C_GREEN" "$C_RESET"
                return 0
            fi
            printf '%srun finished: %s%s\n' "$C_RED" "$conclusion" "$C_RESET"
            echo "  gh run view ${run_id} --repo ${REPO} --log-failed"
            return 1
        fi
        sleep 10
    done
}

cmd_rotate() {
    local real=0 confirm gw_ip
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --real) real=1; shift ;;
            *) die "usage: mlp rotate [--real]" ;;
        esac
    done

    if [[ "$real" -eq 0 ]]; then
        echo "dry run: builds, provisions and verifies a preview machine, then deletes it."
        echo "NODE_GATEWAY and the live Gateway are not touched."
        echo ""
        wf_dispatch rotate-gateway.yml "rotate (dry run)" -f dry_run=true
        return
    fi

    resolve_gateway
    gw_ip="$GW_IP"
    printf '%sThis replaces the live Gateway (%s).%s\n' "$C_YELLOW" "$gw_ip" "$C_RESET"
    echo "  Providers reconnect on their own (~1s). Running workers follow"
    echo "  too — they read the address their provider publishes, and the"
    echo "  port ledger is carried over — but expect a brief interruption."
    echo "  Run 'mlp rotate' (dry run) first if you haven't."
    printf 'Type the current Gateway IP to confirm: '
    read -r confirm
    if [[ "$confirm" != "$gw_ip" ]]; then
        echo "aborted (expected ${gw_ip})."
        return 1
    fi

    wf_dispatch rotate-gateway.yml "rotate" -f dry_run=false || return 1
    echo ""
    echo "next: run 'mlp trust-gateway' to accept the new machine's host key."
}

cmd_worker() {
    local sub="${1:-}"
    [[ $# -gt 0 ]] && shift
    case "$sub" in
        new) worker_new "$@" ;;
        rm)  worker_rm "$@" ;;
        "")  die "usage: mlp worker {new|rm}" ;;
        *)   die "unknown worker subcommand '${sub}' (expected new or rm)" ;;
    esac
}

# The pickers read the same live view `ls` renders, so what you pick is
# what you just saw — including the container-name spelling, which is the
# one delete-worker did not accept until it was taught both.
worker_targets() {
    resolve_gateway
    open_gateway_master || die "Gateway unreachable (${GW_USER}@${GW_IP})"
    gather_targets
}

worker_new() {
    local provider image

    # No flag form exists for these two picks, so there is no usage line to
    # point at — say plainly what is missing instead of hanging.
    interactive_only || {
        echo "mlp worker new needs an interactive terminal to pick provider and image (stdin is not a TTY)" >&2
        exit 2
    }

    provider="$(worker_targets | awk -F'\t' '$2 == "provider" { print $1 }' \
                 | fzf --prompt='provider> ' --height='~40%' \
                       --header='which machine should host the worker?')"
    [[ -n "$provider" ]] || { echo "aborted."; return 1; }

    image="$(worker_images | fzf --prompt='image> ' --height='~40%' \
               --header='which profiles/worker/<image> to build?')"
    [[ -n "$image" ]] || { echo "aborted."; return 1; }

    wf_dispatch create-worker.yml "create-worker (${provider}/${image})" \
        -f provider="$provider" -f image="$image" || return 1
    echo ""
    echo "next: 'mlp ls' to see it, 'mlp ssh' to connect."
}

worker_rm() {
    local name="${1:-}" confirm
    if [[ "$name" == -* ]]; then
        echo "usage: mlp worker rm [<worker-name>]  (fzf pick when omitted)" >&2
        exit 2
    fi
    if [[ -z "$name" ]]; then
        interactive_only || {
            echo "usage: mlp worker rm [<worker-name>]  (fzf pick when omitted)" >&2
            exit 2
        }
        name="$(worker_targets \
                 | awk -F'\t' '$2 == "worker" { printf "%s\t(on %s, port %s)\n", $1, $3, $4 }' \
                 | fzf --prompt='worker> ' --height='~40%' \
                       --header='which worker to delete? (Esc to cancel)' \
                 | cut -f1)"
    fi
    [[ -n "$name" ]] || { echo "aborted."; return 1; }

    printf '%sDelete worker %s?%s Its container is removed and its port released.\n' \
        "$C_YELLOW" "$name" "$C_RESET"
    printf 'Type "yes" to confirm: '
    read -r confirm
    [[ "$confirm" == "yes" ]] || { echo "aborted."; return 1; }

    wf_dispatch delete-worker.yml "delete-worker (${name})" -f name="$name"
}

worker_images() {
    local d
    for d in "${REPO_ROOT}"/profiles/worker/*/; do
        [[ -d "$d" ]] && basename "$d"
    done
}


# ---- register ---------------------------------------------------------------
# Thin forwarders to the real registration scripts — the logic lives in
# ops-scripts/register-client / register-provider.sh, never duplicated
# here (RUNBOOK §7.12: one rule, one implementation). IMPORTANT WHERE
# THEY RUN (people get this wrong):
#   - `mlp register client` runs on the machine YOU will connect FROM
#     (the operator's Mac) — it uploads YOUR public key to GitHub.
#   - `mlp register provider` runs ON THE NEW MACHINE being added to the
#     pool — NOT on the Mac. It provisions that box itself.
cmd_register() {
    local sub="${1:-}"
    [[ $# -gt 0 ]] && shift
    local script
    case "$sub" in
        client)   script="${SCRIPT_DIR}/register-client" ;;
        provider) script="${SCRIPT_DIR}/register-provider.sh" ;;
        "")
            cat >&2 <<'EOF'
usage: mlp register {client|provider} [args...]

  register client    register THIS machine (the one you are on) as a
                     client: uploads your public key to CLIENT_<NAME>.
                     Run it on the machine you will connect FROM.
                     forwards to ops-scripts/register-client
  register provider  register a NEW machine into the pool. Run it ON
                     that new machine, not here on the Mac.
                     forwards to ops-scripts/register-provider.sh
EOF
            return 2
            ;;
        *)
            echo "mlp: unknown register subcommand '${sub}' (expected client or provider)" >&2
            return 2
            ;;
    esac
    if [[ ! -x "$script" ]]; then
        echo "mlp: ${script} not found or not executable" >&2
        return 127
    fi
    "$script" "$@"
}


# Emits a normal ssh_config so plain `ssh fh-l`, `scp`, `rsync`, `-L`/`-R`
# and anything else that speaks ssh_config work against the pool — without
# going through mlp at all.
#
# ---- ssh-config export -------------------------------------------------------
# Emits a normal ssh_config so plain `ssh fh-l`, `scp`, `rsync`, `-L`/`-R`
# and anything else that speaks ssh_config work against the pool — without
# going through mlp at all.
#
# Trust is not uniform across the two legs, which is why this cannot be a
# single ProxyJump with one set of options (the same reason mlp builds
# ProxyCommand by hand):
#   - The Gateway leg is pinned to the host key NODE_GATEWAY carries.
#   - The 127.0.0.1:<port> legs are NOT verified: every node answers on the
#     same loopback address, and their keys change whenever a worker is
#     rebuilt. Pinning there would mean a host key warning every time.
#     The Gateway leg is what authenticates the path.
MLP_SSH_CONFIG="${MLP_STATE_DIR}/ssh_config"

emit_ssh_config() {
    local name type provider port user r

    cat <<HEADER
# Generated by \`mlp ssh-config\` on $(date -u +%Y-%m-%dT%H:%M:%SZ).
# Gateway: ${GW_IP} (generation $("$POOL_RESOLVE" gateway --field .generation 2>/dev/null))
#
# Regenerate after a rotate: the Gateway's address and host key both change.
#   mlp ssh-config --write

Host mlp-gateway
    HostName ${GW_IP}
    User ${GW_USER}
    Port ${GW_PORT}
HEADER
    client_identity_line
    cat <<HEADER
    UserKnownHostsFile ${GW_KNOWN_HOSTS}
    StrictHostKeyChecking yes
HEADER

    while IFS= read -r r; do
        fwd_split_row "$r"
        name="$FWD_C1"; type="$FWD_C2"; provider="$FWD_C3"; port="$FWD_C4"; user="$FWD_C5"
        [[ -n "$name" ]] || continue
        [[ -n "$provider" ]] || provider="?"
        echo ""
        if [[ "$type" == "worker" ]]; then
            echo "# worker on ${provider}"
            echo "Host ${name} worker-${port}"
        else
            echo "Host ${name}"
        fi
        echo "    HostName 127.0.0.1"
        echo "    Port ${port}"
        echo "    User ${user}"
        client_identity_line
        echo "    ProxyJump mlp-gateway"
        echo "    UserKnownHostsFile /dev/null"
        echo "    StrictHostKeyChecking no"
        echo "    LogLevel ERROR"
    done < <(gather_targets)
}

# Names we are about to define that ~/.ssh/config already defines. ssh takes
# the FIRST value it obtains for a keyword, so an earlier Host block wins —
# a stale entry silently beats the generated one, which is the confusing
# failure this warns about rather than tries to resolve.
ssh_config_collisions() {
    local generated="$1" user_cfg="${HOME}/.ssh/config" n
    [[ -f "$user_cfg" ]] || return 0
    grep -E '^Host ' "$generated" | sed 's/^Host //' | tr ' ' '\n' | while read -r n; do
        [[ -n "$n" ]] || continue
        grep -qE "^Host( .*)? ${n}( |$)|^Host ${n}( |$)" "$user_cfg" && echo "$n"
    done
}

# client_identity_line — print the IdentityFile line for this client.
#   Prefers ~/.ssh/id_mlp, which is what `mlp register client` creates and
#   publishes as CLIENT_<NAME>. Falls back to ~/.ssh/id_rsa for a machine
#   that predates that flow. Hardcoding id_rsa is how a client keeps using
#   a key the pool is about to stop authorising.
client_identity_line() {
    local k
    local key
    key="$(client_identity_path)" || return 0
    echo "    IdentityFile ${key/#${HOME}/~}"
}

cmd_ssh_config() {
    local write=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --write) write=1; shift ;;
            *) die "usage: mlp ssh-config [--write]" ;;
        esac
    done

    resolve_gateway
    open_gateway_master || die "Gateway unreachable (${GW_USER}@${GW_IP})"
    local tmp; tmp="$(mktemp)"
    emit_ssh_config > "$tmp"
    close_gateway_master

    if [[ "$write" -eq 0 ]]; then
        cat "$tmp"
        rm -f "$tmp"
        return 0
    fi

    mkdir -p "$MLP_STATE_DIR"
    mv -f "$tmp" "$MLP_SSH_CONFIG"
    chmod 600 "$MLP_SSH_CONFIG"
    printf '%swrote %s%s\n' "$C_GREEN" "$MLP_SSH_CONFIG" "$C_RESET"

    local inc="Include ${MLP_SSH_CONFIG}"
    if [[ -f "${HOME}/.ssh/config" ]] && grep -qF "$inc" "${HOME}/.ssh/config"; then
        echo "~/.ssh/config already includes it."
    else
        echo ""
        echo "Add this as the FIRST line of ~/.ssh/config (ssh keeps the first"
        echo "value it finds for a setting, so an Include placed lower loses to"
        echo "whatever is above it):"
        echo ""
        printf '    %s\n' "$inc"
    fi

    local dupes; dupes="$(ssh_config_collisions "$MLP_SSH_CONFIG")"
    if [[ -n "$dupes" ]]; then
        echo ""
        printf '%sthese names are already defined in ~/.ssh/config:%s\n' "$C_YELLOW" "$C_RESET"
        printf '%s\n' "$dupes" | sed 's/^/    /'
        echo "  Whichever block comes first wins. Remove the old ones, or put"
        echo "  the Include above them."
    fi
}


# ---- fwd (local port forwards) --------------------------------------------
# Client-side only: zero pool state, the Gateway never hears about these.
# No config file — the live answer is the socket files under $FWD_DIR plus
# the process table (ps shows the full -L line). Reboot forgets everything;
# that is accepted on purpose, no launchd recovery, no auto-retry.
#
# MVVM split, hard rule: Model returns data and shows nothing; ViewModel
# decides and acts but shows nothing and never picks; View shows and picks
# but never dials. New helpers below honor that: the six data/decision
# functions contain no output primitive and no picker.
#
# ControlPath shape: $FWD_DIR/fwd-<bind>-<entryport> (entryport is unique by
# construction, so rm addresses by entryport). The node name rides the
# master command line as a trailing mlp-fwd-node=<node> marker: -N means it
# is never executed remotely, it only stays visible for fwd_records to read
# back — the same "no second source of truth" idea as the -L line itself.

# fwd_parse_spec <spec> — ViewModel helper: split an -L-shaped spec.
#   Sets FWD_SPEC_BIND/ENTRY/THOST/TPORT, 0 on valid, 1 on invalid.
#   A field of digits only is a port, anything else is an address — that one
#   rule disambiguates every arity, so a third-party target needs no extra
#   flag (the target is always resolved on the far side anyway):
#     8080                 -> bind 127.0.0.1, entry 8080, target node:8080
#     9090:8080            -> bind 127.0.0.1, entry 9090, target node:8080
#     0.0.0.0:9090:8080    -> bind 0.0.0.0, entry 9090, target node:8080
#     8080:192.168.0.50:80 -> bind 127.0.0.1, entry 8080, target 192.168.0.50:80
fwd_parse_spec() {
    local spec="$1" parts rest p
    FWD_SPEC_BIND=""
    FWD_SPEC_ENTRY=""
    FWD_SPEC_THOST=""
    FWD_SPEC_TPORT=""
    if [[ "$spec" != *:* ]]; then
        if [[ "$spec" =~ ^[0-9]+$ ]]; then
            FWD_SPEC_BIND="127.0.0.1"
            FWD_SPEC_ENTRY="$spec"
            FWD_SPEC_THOST="127.0.0.1"
            FWD_SPEC_TPORT="$spec"
        else
            return 1
        fi
    else
        parts=()
        rest="$spec"
        while [[ "$rest" == *:* ]]; do
            p="${rest%%:*}"
            parts+=("$p")
            rest="${rest#*:}"
        done
        parts+=("$rest")
        if [[ "${#parts[@]}" -eq 2 ]]; then
            if [[ "${parts[0]}" =~ ^[0-9]+$ && "${parts[1]}" =~ ^[0-9]+$ ]]; then
                FWD_SPEC_BIND="127.0.0.1"
                FWD_SPEC_ENTRY="${parts[0]}"
                FWD_SPEC_THOST="127.0.0.1"
                FWD_SPEC_TPORT="${parts[1]}"
            elif [[ ! "${parts[0]}" =~ ^[0-9]+$ && "${parts[1]}" =~ ^[0-9]+$ ]]; then
                FWD_SPEC_BIND="${parts[0]}"
                FWD_SPEC_ENTRY="${parts[1]}"
                FWD_SPEC_THOST="127.0.0.1"
                FWD_SPEC_TPORT="${parts[1]}"
            else
                return 1
            fi
        elif [[ "${#parts[@]}" -eq 3 ]]; then
            if [[ ! "${parts[0]}" =~ ^[0-9]+$ && "${parts[1]}" =~ ^[0-9]+$ && "${parts[2]}" =~ ^[0-9]+$ ]]; then
                FWD_SPEC_BIND="${parts[0]}"
                FWD_SPEC_ENTRY="${parts[1]}"
                FWD_SPEC_THOST="127.0.0.1"
                FWD_SPEC_TPORT="${parts[2]}"
            elif [[ "${parts[0]}" =~ ^[0-9]+$ && -n "${parts[1]}" && ! "${parts[1]}" =~ ^[0-9]+$ && "${parts[2]}" =~ ^[0-9]+$ ]]; then
                FWD_SPEC_BIND="127.0.0.1"
                FWD_SPEC_ENTRY="${parts[0]}"
                FWD_SPEC_THOST="${parts[1]}"
                FWD_SPEC_TPORT="${parts[2]}"
            else
                return 1
            fi
        elif [[ "${#parts[@]}" -eq 4 ]]; then
            if [[ ! "${parts[0]}" =~ ^[0-9]+$ && "${parts[1]}" =~ ^[0-9]+$ && -n "${parts[2]}" && ! "${parts[2]}" =~ ^[0-9]+$ && "${parts[3]}" =~ ^[0-9]+$ ]]; then
                FWD_SPEC_BIND="${parts[0]}"
                FWD_SPEC_ENTRY="${parts[1]}"
                FWD_SPEC_THOST="${parts[2]}"
                FWD_SPEC_TPORT="${parts[3]}"
            else
                return 1
            fi
        else
            return 1
        fi
    fi
    if [[ ! "$FWD_SPEC_ENTRY" =~ ^[0-9]+$ || ! "$FWD_SPEC_TPORT" =~ ^[0-9]+$ ]]; then
        return 1
    fi
    if [[ "$FWD_SPEC_ENTRY" -lt 1 || "$FWD_SPEC_ENTRY" -gt 65535 || "$FWD_SPEC_TPORT" -lt 1 || "$FWD_SPEC_TPORT" -gt 65535 ]]; then
        return 1
    fi
    case "$FWD_SPEC_BIND" in ""|*[[:space:]/]*) return 1 ;; esac
    case "$FWD_SPEC_THOST" in ""|*[[:space:]/]*) return 1 ;; esac
    return 0
}

# fwd_split_row <row> — split one TAB row into FWD_C1..FWD_C10.
#   Shared plumbing for every TAB-row reader (fwd records/status and the
#   gather_targets rows alike). Pure expansion on purpose: TAB counts as IFS
#   whitespace, so an IFS-tab read squeezes runs of TABs into one and empty
#   middle fields vanish (a stale record's node then eats the ctl path; a
#   provider-less worker row shifts port into provider). Expansion keeps
#   every empty slot exactly where it is. Rows carry up to 10 fields;
#   unused slots stay empty. Data only, no output, no picking.
fwd_split_row() {
    local rest="$1"
    FWD_C1=""; FWD_C2=""; FWD_C3=""; FWD_C4=""; FWD_C5=""
    FWD_C6=""; FWD_C7=""; FWD_C8=""; FWD_C9=""; FWD_C10=""
    rest="$1"
    FWD_C1="${rest%%$'\t'*}"
    if [[ "$rest" == *$'\t'* ]]; then rest="${rest#*$'\t'}"; else rest=""; fi
    FWD_C2="${rest%%$'\t'*}"
    if [[ "$rest" == *$'\t'* ]]; then rest="${rest#*$'\t'}"; else rest=""; fi
    FWD_C3="${rest%%$'\t'*}"
    if [[ "$rest" == *$'\t'* ]]; then rest="${rest#*$'\t'}"; else rest=""; fi
    FWD_C4="${rest%%$'\t'*}"
    if [[ "$rest" == *$'\t'* ]]; then rest="${rest#*$'\t'}"; else rest=""; fi
    FWD_C5="${rest%%$'\t'*}"
    if [[ "$rest" == *$'\t'* ]]; then rest="${rest#*$'\t'}"; else rest=""; fi
    FWD_C6="${rest%%$'\t'*}"
    if [[ "$rest" == *$'\t'* ]]; then rest="${rest#*$'\t'}"; else rest=""; fi
    FWD_C7="${rest%%$'\t'*}"
    if [[ "$rest" == *$'\t'* ]]; then rest="${rest#*$'\t'}"; else rest=""; fi
    FWD_C8="${rest%%$'\t'*}"
    if [[ "$rest" == *$'\t'* ]]; then rest="${rest#*$'\t'}"; else rest=""; fi
    FWD_C9="${rest%%$'\t'*}"
    if [[ "$rest" == *$'\t'* ]]; then rest="${rest#*$'\t'}"; else rest=""; fi
    FWD_C10="$rest"
    return 0
}

# fwd_is_wild <bind> — 0 when bind is a wildcard (0.0.0.0, ::, empty).
#   Only these three count: anything else, even another loopback spelling,
#   is a specific address and coexists with its siblings on the same port.
fwd_is_wild() {
    case "$1" in
        ""|"0.0.0.0"|"::") return 0 ;;
        *) return 1 ;;
    esac
}

# fwd_records — Model: one row per socket file under $FWD_DIR.
#   Sets FWD_RECORDS, each bind<TAB>entryport<TAB>node<TAB>targethost<TAB>
#   targetport<TAB>pid<TAB>ctl. No network. A file with no live process is
#   still listed (pid/node/target blank) so ls can show it down and rm can
#   clear it — hiding it would be a second source of truth disagreeing.
fwd_records() {
    local f base rest bind entry ps_out line pid lspec node thost tport
    local lbind lentry r1 r2 tmp
    FWD_RECORDS=()
    [[ -d "$FWD_DIR" ]] || return 0
    ps_out="$(ps ax -o pid= -o args= 2>/dev/null)"
    for f in "$FWD_DIR"/fwd-*; do
        [[ -e "$f" ]] || continue
        base="${f##*/}"
        rest="${base#fwd-}"
        case "$rest" in
            *-*) bind="${rest%-*}"; entry="${rest##*-}" ;;
            *) continue ;;
        esac
        [[ -n "$bind" && "$entry" =~ ^[0-9]+$ ]] || continue
        pid=""
        node=""
        thost=""
        tport=""
        line=""
        if [[ -n "$ps_out" ]]; then
            while IFS= read -r tmp; do
                case "$tmp" in
                    *" -S ${f} "*) line="$tmp"; break ;;
                esac
            done <<< "$ps_out"
        fi
        if [[ -n "$line" ]]; then
            tmp="${line#"${line%%[! ]*}"}"
            pid="${tmp%% *}"
            case "$line" in
                *" -L "*)
                    tmp="${line#* -L }"
                    lspec="${tmp%% *}"
                    lbind="${lspec%%:*}"
                    r1="${lspec#*:}"
                    lentry="${r1%%:*}"
                    r2="${r1#*:}"
                    thost="${r2%%:*}"
                    tport="${r2##*:}"
                    if [[ "$lbind" == "$bind" && "$lentry" == "$entry" ]]; then
                        :
                    else
                        thost=""
                        tport=""
                    fi
                    ;;
            esac
            case "$line" in
                *"mlp-fwd-node="*)
                    tmp="${line#*mlp-fwd-node=}"
                    node="${tmp%% *}"
                    ;;
            esac
        fi
        FWD_RECORDS+=("${bind}"$'\t'"${entry}"$'\t'"${node}"$'\t'"${thost}"$'\t'"${tport}"$'\t'"${pid}"$'\t'"${f}")
    done
    return 0
}

# fwd_probe <ctl> <targethost> <targetport> — Model: two live segments.
#   Sets FWD_PROBE_TUNNEL (up|down), FWD_PROBE_TARGET
#   (open|refused|inconclusive|unreachable|unknown), FWD_PROBE_RTT (ms) and the
#   joined FWD_PROBE_RESULT. 0 when the tunnel answered, 1 when it did not.
#   Tunnel verdict rides the master itself (a remote true through it):
#   asking the local master process would answer OK with the line dead,
#   which is the exact failure this repo kept re-hitting, so that call is
#   never used here. Target verdict is one TCP open attempt run ON the far
#   side, classified by exit code AND far-side stderr: only an explicit
#   "Connection refused" proves the packet reached the host (RST came back),
#   so only that counts as healthy alongside open; anything else non-zero
#   (no route, host down) is unreachable, while 124 stays inconclusive —
#   "I do not know" versus "I know it cannot get there", never merged.
fwd_probe() {
    local ctl="$1" thost="$2" tport="$3" rc start_ms now_ms target_err
    FWD_PROBE_TUNNEL=""
    FWD_PROBE_TARGET=""
    FWD_PROBE_RTT=""
    FWD_PROBE_RESULT=""
    if command -v python3 >/dev/null 2>&1; then
        start_ms="$(python3 -c 'import time;print(int(time.time()*1000))' 2>/dev/null)" || start_ms=""
    else
        start_ms=""
    fi
    if ssh -S "$ctl" -o BatchMode=yes -o ConnectTimeout=5 placeholder true < /dev/null >/dev/null 2>&1; then
        FWD_PROBE_TUNNEL="up"
    else
        FWD_PROBE_TUNNEL="down"
    fi
    if command -v python3 >/dev/null 2>&1; then
        now_ms="$(python3 -c 'import time;print(int(time.time()*1000))' 2>/dev/null)" || now_ms=""
    else
        now_ms=""
    fi
    if [[ -n "$start_ms" && -n "$now_ms" ]]; then
        FWD_PROBE_RTT="$(( now_ms - start_ms ))"
    else
        FWD_PROBE_RTT="0"
    fi
    if [[ "$FWD_PROBE_TUNNEL" != "up" ]]; then
        FWD_PROBE_TARGET="unknown"
        FWD_PROBE_RESULT="${FWD_PROBE_TUNNEL}"$'\t'"${FWD_PROBE_TARGET}"$'\t'"${FWD_PROBE_RTT}"
        return 1
    fi
    target_err="$(ssh -S "$ctl" -o BatchMode=yes -o ConnectTimeout=8 placeholder \
        "timeout 3 bash -c 'exec 3<>/dev/tcp/${thost}/${tport}'" < /dev/null 2>&1 >/dev/null)"
    rc=$?
    if [[ "$rc" -eq 0 ]]; then
        FWD_PROBE_TARGET="open"
    elif [[ "$rc" -eq 124 ]]; then
        FWD_PROBE_TARGET="inconclusive"
    elif [[ "$target_err" == *"Connection refused"* ]]; then
        FWD_PROBE_TARGET="refused"
    else
        FWD_PROBE_TARGET="unreachable"
    fi
    FWD_PROBE_RESULT="${FWD_PROBE_TUNNEL}"$'\t'"${FWD_PROBE_TARGET}"$'\t'"${FWD_PROBE_RTT}"
    return 0
}

# fwd_add <node> <spec> — ViewModel: parse, resolve, start master, verify.
#   Sets FWD_ADD_* on success (CTL/BIND/ENTRY/NODE/THOST/TPORT) and returns
#   0. On failure sets FWD_ERR (spec|resolve|inuse|start|verify, plus
#   FWD_START_ERR detail and TARGET_ERR from the resolver) and returns
#   non-zero. Starts the master through ssh_via_gateway with SSH_EXTRA_OPTS
#   carrying -L/-M/-S/-N/-f; ExitOnForwardFailure makes a held port fail
#   here instead of pretending to succeed. A stale socket file for the same
#   entryport is cleared so add stays retryable; a live one refuses.
fwd_add() {
    local node="$1" spec="$2" bind entry thost tport tuser tport_lb ctl lspec
    local rc start_err ps_now f base rest fbind fentry
    FWD_ERR=""
    FWD_START_ERR=""
    FWD_CLASH=""
    FWD_ADD_CTL=""
    FWD_ADD_BIND=""
    FWD_ADD_ENTRY=""
    FWD_ADD_NODE=""
    FWD_ADD_THOST=""
    FWD_ADD_TPORT=""
    fwd_parse_spec "$spec" || { FWD_ERR="spec"; return 2; }
    bind="$FWD_SPEC_BIND"
    entry="$FWD_SPEC_ENTRY"
    thost="$FWD_SPEC_THOST"
    tport="$FWD_SPEC_TPORT"
    resolve_gateway nodie || { FWD_ERR="resolve"; return 3; }
    target_resolve "$node" || { FWD_ERR="resolve"; return 3; }
    tuser="$TARGET_USER"
    tport_lb="$TARGET_PORT"
    if [[ ! -d "$FWD_DIR" ]]; then
        mkdir -p "$FWD_DIR" || { FWD_ERR="start"; return 5; }
    fi
    ctl="${FWD_DIR}/fwd-${bind}-${entry}"
    # Identity is bind:entryport; same-port records collide only on overlap:
    # an exact duplicate always refuses, a wildcard on either side refuses
    # (the kernel allows it under SO_REUSEADDR but then silently routes by
    # specificity — two "up" rows pointing at different destinations), and
    # two different specific addresses coexist legitimately. Dead files never
    # collide; same-port ones are cleared so add stays retryable.
    ps_now="$(ps ax -o pid= -o args= 2>/dev/null)"
    for f in "$FWD_DIR"/fwd-*; do
        [[ -e "$f" ]] || continue
        base="${f##*/}"
        rest="${base#fwd-}"
        case "$rest" in
            *-*) fbind="${rest%-*}"; fentry="${rest##*-}" ;;
            *) continue ;;
        esac
        [[ "$fentry" == "$entry" ]] || continue
        case "$ps_now" in
            *" -S ${f} "*) : ;;
            *) rm -f "$f"; continue ;;
        esac
        if [[ "$fbind" == "$bind" ]]; then
            FWD_ERR="inuse"; FWD_CLASH="${fbind}:${fentry}"; return 4
        fi
        if fwd_is_wild "$fbind" || fwd_is_wild "$bind"; then
            FWD_ERR="inuse"; FWD_CLASH="${fbind}:${fentry}"; return 4
        fi
    done
    lspec="${bind}:${entry}:${thost}:${tport}"
    SSH_EXTRA_OPTS=(-M -S "$ctl" -N -f -L "$lspec" -o ControlPersist=yes -o ExitOnForwardFailure=yes)
    start_err="$(ssh_via_gateway "$GW_KNOWN_HOSTS" "$GW_USER" "$GW_IP" "$GW_PORT" "$tuser" 127.0.0.1 "$tport_lb" "mlp-fwd-node=${node}" < /dev/null 2>&1 >/dev/null)"
    rc=$?
    unset SSH_EXTRA_OPTS
    if [[ "$rc" -ne 0 ]]; then
        rm -f "$ctl"
        FWD_ERR="start"
        FWD_START_ERR="$start_err"
        return 5
    fi
    fwd_probe "$ctl" "$thost" "$tport"
    if [[ "$FWD_PROBE_TUNNEL" != "up" ]]; then
        ssh -S "$ctl" -O exit placeholder < /dev/null >/dev/null 2>&1 || true
        rm -f "$ctl"
        FWD_ERR="verify"
        return 6
    fi
    FWD_ADD_CTL="$ctl"
    FWD_ADD_BIND="$bind"
    FWD_ADD_ENTRY="$entry"
    FWD_ADD_NODE="$node"
    FWD_ADD_THOST="$thost"
    FWD_ADD_TPORT="$tport"
    return 0
}

# fwd_remove <entryport|bind:entryport> — ViewModel: stop one master, clear
#   its socket. A bare port must match exactly one file; bind:port pins it
#   (last colon splits, so IPv6 binds work). Several files on one port
#   (stale leftovers) refuse with FWD_ERR=ambiguous and the FWD_RM_CANDS
#   list instead of silently picking one.
#   Sets FWD_RM_CTL and returns 0; FWD_ERR (spec|notfound|ambiguous) else.
#   Entry match is exact on the parsed port, never a glob, so port 80 can
#   never catch 8080.
fwd_remove() {
    local arg="$1" entry bind f base rest fbind fentry ctl ncands
    FWD_ERR=""
    FWD_RM_CTL=""
    FWD_RM_CANDS=""
    case "$arg" in
        *:*)
            bind="${arg%:*}"
            entry="${arg##*:}"
            ;;
        *)
            bind=""
            entry="$arg"
            ;;
    esac
    [[ "$entry" =~ ^[0-9]+$ ]] || { FWD_ERR="spec"; return 2; }
    ctl=""
    ncands=0
    if [[ -d "$FWD_DIR" ]]; then
        for f in "$FWD_DIR"/fwd-*; do
            [[ -e "$f" ]] || continue
            base="${f##*/}"
            rest="${base#fwd-}"
            case "$rest" in
                *-*) fbind="${rest%-*}"; fentry="${rest##*-}" ;;
                *) continue ;;
            esac
            [[ "$fentry" == "$entry" ]] || continue
            if [[ -n "$bind" ]]; then
                [[ "$fbind" == "$bind" ]] || continue
                ctl="$f"
                break
            fi
            ncands=$((ncands + 1))
            FWD_RM_CANDS="${FWD_RM_CANDS}${fbind}:${fentry}
"
            ctl="$f"
        done
    fi
    if [[ -n "$bind" ]]; then
        if [[ -z "$ctl" ]]; then
            FWD_ERR="notfound"
            return 3
        fi
    else
        case "$ncands" in
            0) FWD_ERR="notfound"; return 3 ;;
            1) : ;;
            *) FWD_ERR="ambiguous"; return 4 ;;
        esac
    fi
    ssh -S "$ctl" -O exit placeholder < /dev/null >/dev/null 2>&1 || true
    rm -f "$ctl"
    FWD_RM_CTL="$ctl"
    return 0
}

# fwd_status — ViewModel: records joined with a probe each.
#   Sets FWD_STATUS_ROWS, each a record row plus tunnel<TAB>target<TAB>rtt.
#   Rows with no target (stale files) skip the dial and read down/unknown.
fwd_status() {
    local r bind entry node thost tport pid ctl tunnel target rtt
    FWD_STATUS_ROWS=()
    fwd_records
    if [[ "${#FWD_RECORDS[@]}" -gt 0 ]]; then
        for r in "${FWD_RECORDS[@]}"; do
            fwd_split_row "$r"
            bind="$FWD_C1"; entry="$FWD_C2"; node="$FWD_C3"; thost="$FWD_C4"
            tport="$FWD_C5"; pid="$FWD_C6"; ctl="$FWD_C7"
            if [[ -n "$thost" && -n "$tport" ]]; then
                fwd_probe "$ctl" "$thost" "$tport"
                tunnel="$FWD_PROBE_TUNNEL"
                target="$FWD_PROBE_TARGET"
                rtt="$FWD_PROBE_RTT"
            else
                tunnel="down"
                target="unknown"
                rtt="0"
            fi
            FWD_STATUS_ROWS+=("${bind}"$'\t'"${entry}"$'\t'"${node}"$'\t'"${thost}"$'\t'"${tport}"$'\t'"${pid}"$'\t'"${ctl}"$'\t'"${tunnel}"$'\t'"${target}"$'\t'"${rtt}")
        done
    fi
    return 0
}

# ---- fwd view -----------------------------------------------------------------
# View: picking, layout, color. Never dials — every fact comes from the
# ViewModel above.

fwd_view_add() {
    local node="${1:-}" spec="${2:-}"
    if [[ -z "$node" || -z "$spec" ]]; then
        echo "usage: mlp fwd add <node> [entryip:]entryport[:targethost:targetport]" >&2
        exit 2
    fi
    if fwd_add "$node" "$spec"; then
        printf '%sforward up:%s %s:%s -> %s (%s:%s)\n' \
            "$C_GREEN" "$C_RESET" "$FWD_ADD_BIND" "$FWD_ADD_ENTRY" "$FWD_ADD_NODE" "$FWD_ADD_THOST" "$FWD_ADD_TPORT"
        return 0
    fi
    case "$FWD_ERR" in
        spec)
            die "bad spec '${spec}' — want [entryip:]entryport[:targethost:targetport] (e.g. 8080, 9090:8080, 8080:192.168.0.50:80)"
            ;;
        resolve)
            if [[ -n "$RESOLVE_DETAIL" ]]; then
                die "$RESOLVE_DETAIL"
            fi
            if [[ "$TARGET_ERR" == "unreachable" ]]; then
                [[ -n "$TARGET_DETAIL" ]] && printf '%s\n' "$TARGET_DETAIL" >&2
                die "Gateway unreachable (${GW_USER}@${GW_IP})"
            fi
            die "no such node or worker: ${node}"
            ;;
        inuse)
            die "fwd ${FWD_SPEC_BIND}:${FWD_SPEC_ENTRY} overlaps live ${FWD_CLASH} (shared bind:port) — 'mlp fwd ls' to see it, 'mlp fwd rm ${FWD_CLASH}' to clear it"
            ;;
        start)
            [[ -n "$FWD_START_ERR" ]] && printf '%s\n' "$FWD_START_ERR" >&2
            die "could not start forward to ${node} — is the entryport already held?"
            ;;
        verify)
            die "forward to ${node} started but the tunnel never answered — removed again"
            ;;
        *)
            die "mlp fwd add failed"
            ;;
    esac
}

fwd_view_ls() {
    local r bind entry node thost tport pid ctl tunnel target rtt target_disp
    local bind_disp tunnel_disp target_state_disp nodewidth bindwidth targetwidth tstatewidth
    local bplain tplain tunnel_pad tstate_pad rname
    fwd_status
    if [[ "${#FWD_STATUS_ROWS[@]}" -eq 0 ]]; then
        echo "no forwards — 'mlp fwd add <node> <spec>' to create one"
        return 0
    fi
    # Every data-driven column sizes to its widest plain value (headers are
    # the floors): TSTATE must fit unreachable (11), BIND an IPv6 bind plus
    # the LAN "*", TARGET an IPv6/long-DNS host:port. ENTRY/TUNNEL are
    # provably bounded (5-digit ports; up/down), so they stay fixed.
    nodewidth=4
    bindwidth=4
    targetwidth=6
    tstatewidth=6
    for r in "${FWD_STATUS_ROWS[@]}"; do
        fwd_split_row "$r"
        bind="$FWD_C1"; entry="$FWD_C2"; node="$FWD_C3"; thost="$FWD_C4"
        tport="$FWD_C5"; target="$FWD_C9"
        [[ -n "$node" ]] || node="-"
        if [[ "${#node}" -gt "$nodewidth" ]]; then
            nodewidth="${#node}"
        fi
        if [[ "$bind" == "127.0.0.1" || "$bind" == "localhost" ]]; then
            bplain="$bind"
        else
            bplain="${bind}*"
        fi
        if [[ "${#bplain}" -gt "$bindwidth" ]]; then
            bindwidth="${#bplain}"
        fi
        if [[ -n "$thost" && -n "$tport" ]]; then
            tplain="${thost}:${tport}"
        else
            tplain="-"
        fi
        if [[ "${#tplain}" -gt "$targetwidth" ]]; then
            targetwidth="${#tplain}"
        fi
        if [[ "${#target}" -gt "$tstatewidth" ]]; then
            tstatewidth="${#target}"
        fi
    done
    # Color wraps OUTSIDE the padding: printf counts escape bytes as visible
    # width, so coloring first breaks TTY alignment while pipes stay clean —
    # exactly the kind of bug pipe-only verification cannot see.
    local fmt="%-7s %s %-${nodewidth}s  %-${targetwidth}s %s %s %s\n"
    printf "${C_BOLD}%-7s %-${bindwidth}s %-${nodewidth}s  %-${targetwidth}s %-7s %-${tstatewidth}s %s${C_RESET}\n" \
        "ENTRY" "BIND" "NODE" "TARGET" "TUNNEL" "TSTATE" "RTT"
    for r in "${FWD_STATUS_ROWS[@]}"; do
        fwd_split_row "$r"
        bind="$FWD_C1"; entry="$FWD_C2"; node="$FWD_C3"; thost="$FWD_C4"
        tport="$FWD_C5"; pid="$FWD_C6"; ctl="$FWD_C7"; tunnel="$FWD_C8"
        target="$FWD_C9"; rtt="$FWD_C10"
        [[ -n "$node" ]] || node="-"
        if [[ -n "$thost" && -n "$tport" ]]; then
            target_disp="${thost}:${tport}"
        else
            target_disp="-"
        fi
        if [[ "$bind" == "127.0.0.1" || "$bind" == "localhost" ]]; then
            printf -v bind_disp "%-${bindwidth}s" "$bind"
        else
            printf -v bind_disp "%-${bindwidth}s" "${bind}*"
            bind_disp="${C_RED}${bind_disp}${C_RESET}"
        fi
        printf -v tunnel_pad "%-7s" "$tunnel"
        if [[ "$tunnel" == "up" ]]; then
            tunnel_disp="${C_GREEN}${tunnel_pad}${C_RESET}"
        else
            tunnel_disp="${C_RED}${tunnel_pad}${C_RESET}"
        fi
        printf -v tstate_pad "%-${tstatewidth}s" "$target"
        case "$target" in
            open|refused) target_state_disp="${C_GREEN}${tstate_pad}${C_RESET}" ;;
            inconclusive|unreachable) target_state_disp="${C_YELLOW}${tstate_pad}${C_RESET}" ;;
            *) target_state_disp="${C_RED}${tstate_pad}${C_RESET}" ;;
        esac
        # shellcheck disable=SC2059
        printf "$fmt" "$entry" "$bind_disp" "$node" "$target_disp" "$tunnel_disp" "$target_state_disp" "${rtt}ms"
    done
    if printf '%s\n' "${FWD_STATUS_ROWS[@]}" | grep -qv '^127.0.0.1\|^localhost'; then
        printf '%s* listening past loopback — reachable from the LAN%s\n' "$C_YELLOW" "$C_RESET"
    fi
}

fwd_view_rm() {
    local entry="${1:-}" pick lines r bind rent rnode rthost rtport rpid rctl pentry pbind prest
    if [[ "$entry" == -* ]]; then
        echo "usage: mlp fwd rm [entryport|bind:entryport]  (fzf pick when omitted)" >&2
        exit 2
    fi
    if [[ -z "$entry" ]]; then
        interactive_only || {
            echo "usage: mlp fwd rm [entryport|bind:entryport]  (fzf pick when omitted)" >&2
            exit 2
        }
        fwd_records
        if [[ "${#FWD_RECORDS[@]}" -eq 0 ]]; then
            echo "no forwards"
            return 0
        fi
        lines=""
        for r in "${FWD_RECORDS[@]}"; do
            fwd_split_row "$r"
            bind="$FWD_C1"; rent="$FWD_C2"; rnode="$FWD_C3"; rthost="$FWD_C4"
            rtport="$FWD_C5"; rpid="$FWD_C6"; rctl="$FWD_C7"
            [[ -n "$rnode" ]] || rnode="-"
            if [[ -n "$rthost" && -n "$rtport" ]]; then
                lines="${lines}${rent}	${bind}	${rnode}	${rthost}:${rtport}
"
            else
                lines="${lines}${rent}	${bind}	${rnode}	-
"
            fi
        done
        pick="$(printf '%s' "$lines" | fzf --delimiter=$'\t' --with-nth=1,2,3,4 \
                --header='ENTRY  BIND  NODE  TARGET' \
                --prompt='forward> ' --height='~40%')"
        [[ -n "$pick" ]] || return 0
        pentry="${pick%%$'\t'*}"
        prest="${pick#*$'\t'}"
        pbind="${prest%%$'\t'*}"
        entry="${pbind}:${pentry}"
    fi
    if fwd_remove "$entry"; then
        printf '%sremoved forward on %s%s\n' "$C_GREEN" "$entry" "$C_RESET"
        return 0
    fi
    case "$FWD_ERR" in
        spec) die "bad entryport '${entry}' — want entryport or bind:entryport (e.g. 2222, 0.0.0.0:2222)" ;;
        ambiguous)
            printf 'several forwards share a port — pick one:\n%s' "$FWD_RM_CANDS" >&2
            die "usage: mlp fwd rm <bind:entryport>"
            ;;
        *) die "no forward on entryport ${entry}" ;;
    esac
}

# fwd_menu_add — View: interactive add for main_menu. Node comes from fzf
#   over the same live view ls renders (gateway plus every gather_targets
#   row, names only), the spec is typed at the prompt, then the normal add
#   path runs. Never dials directly — resolution and startup stay inside
#   the ViewModel it hands off to.
fwd_menu_add() {
    local name selected spec
    # Reachable only from main_menu (itself gated in main), but the picker
    # and the spec prompt both need a human — guard here too so the
    # invariant is local, not an argument about who calls whom.
    interactive_only || {
        echo "mlp fwd add needs an interactive terminal to pick a node and type a spec (stdin is not a TTY)" >&2
        exit 2
    }
    resolve_gateway
    open_gateway_master || die "Gateway unreachable (${GW_USER}@${GW_IP})"
    selected="$(
        {
            printf 'gateway\n'
            gather_targets | awk -F'\t' '{ print $1 }'
        } | fzf --prompt='node> ' --height='~40%' \
                --header='forward to which node?'
    )"
    close_gateway_master
    [[ -n "$selected" ]] || { echo "aborted."; return 1; }
    name="$selected"
    printf 'spec ([entryip:]entryport[:targethost:targetport], e.g. 8080): '
    read -r spec
    [[ -n "$spec" ]] || { echo "aborted."; return 1; }
    fwd_view_add "$name" "$spec"
}

cmd_fwd() {
    local sub="${1:-}"
    [[ $# -gt 0 ]] && shift
    case "$sub" in
        add) fwd_view_add "$@" ;;
        ls|"") fwd_view_ls ;;
        rm) fwd_view_rm "$@" ;;
        -*)
            echo "usage: mlp fwd {add|ls|rm}" >&2
            exit 2
            ;;
        *)
            echo "mlp: unknown fwd subcommand '${sub}' (expected add, ls or rm)" >&2
            exit 2
            ;;
    esac
}

# ---- capabilities (docs/CAPABILITY-DESIGN.md) -------------------------------
# Every capability key's value is an OBJECT ({} = "has it, no parameters";
# null = "unknown", which is never valid). Unknown keys pass through
# untouched — this code only ever adds or verifies what it understands.

# cap_shape_ok <capabilities_json> — 0 when every value is an object.
#   The shape check the format needs: a string or null value is a contract
#   violation, not a variant. Prints nothing.
cap_shape_ok() {
    jq -e 'type == "object" and all(.[]; type == "object")' >/dev/null 2>&1 <<< "${1:-null}"
}

# cap_verify_worker_host <node> <value_json> — Model: verify `worker-host`.
#   Sets CAP_STATE (pass|fail|unverifiable) and CAP_DETAIL. The criterion is
#   §2's: run `docker info` AS the declared user, never `id -nG` — a group
#   can be present while the socket is unreadable, and then id -nG answers
#   the same as when everything is fine. The check runs through the same
#   node hop (run_on_node), as the node's own user, so it verifies the
#   declaration where it matters. `runtime` must be `docker`; anything else
#   is unverifiable by this implementation, NOT a pass.
cap_verify_worker_host() {
    local node="$1" value_json="$2" runtime out rc
    # Starts unverifiable, like cap_verify_github: only a path that actually
    # observed something may raise the verdict to pass (2026-09-25 qa
    # finding — an initial pass leaks "never inspected" out as "true").
    CAP_STATE="unverifiable"; CAP_DETAIL=""
    runtime="$(jq -r '.runtime // empty' 2>/dev/null <<< "$value_json")"
    if [[ "$runtime" != "docker" ]]; then
        CAP_STATE="unverifiable"
        CAP_DETAIL="runtime '${runtime:-<missing>}' has no verification defined"
        return 0
    fi
    out="$(run_on_node "$node" "docker info >/dev/null 2>&1 && printf MLP_DOCKER_OK" 2>&1)"
    rc=$?
    if [[ $rc -ne 0 ]]; then
        CAP_STATE="unverifiable"
        CAP_DETAIL="could not run docker info on ${node} (hop/ssh failed)"
    elif [[ "$out" == *MLP_DOCKER_OK* ]]; then
        CAP_STATE="pass"
        CAP_DETAIL="docker info answered as the declared user"
    elif [[ -n "$out" ]]; then
        CAP_STATE="fail"
        CAP_DETAIL="docker info failed on ${node}: $(printf '%s' "$out" | head -c 160)"
    else
        CAP_STATE="fail"
        CAP_DETAIL="docker info failed on ${node} (no output)"
    fi
}

# cap_verify_github <node> <value_json> — Model: verify `github`.
#   For each declared repo, `read` is checked with a real API call
#   (`gh api repos/<owner>/<repo>`), per §2. `write` and `trigger-actions`
#   have no defined verification yet, so they are reported unverifiable —
#   never passed. The API call runs through run_on_node (the provider holds
#   the token; the caller's machine may not), reading the node's own
#   ~/.mylinuxpool/gh_token.
#
#   Two lesson-shaped details (qa 2026-09-25):
#   - CAP_STATE starts at `unverifiable`, not `pass`. "Not observed yet" is
#     not "true": a malformed .repos makes the jq below exit 5, the process
#     substitution yields nothing, the loop body never runs, and an initial
#     `pass` would then be reported for a declaration that was never even
#     looked at. Only the paths that actually performed an observation may
#     raise the verdict to pass.
#   - The value's schema is validated first, and violations are `fail`
#     (the declaration itself is broken), not `unverifiable` ("no
#     verification defined" is a different thing from "the declaration is
#     malformed").
cap_verify_github() {
    local node="$1" value_json="$2" repo perms schema_err out rc observed=0
    CAP_STATE="unverifiable"
    CAP_DETAIL=""

    # schema: .repos must be an object, every value an array, every element
    # one of the defined permission words; .repos absent == no repos.
    schema_err="$(jq -r '
        if (has("repos") | not) then ""
        elif (.repos | type) != "object" then ".repos must be an object"
        elif [.repos[] | select(type != "array")] | length > 0 then "every .repos value must be an array"
        elif [.repos[][] | select(. != "read" and . != "write" and . != "trigger-actions")] | length > 0
          then "permission values must be read/write/trigger-actions"
        else "" end' 2>/dev/null <<< "$value_json")"
    if [[ -z "$schema_err" ]] && ! jq -e 'type == "object"' >/dev/null 2>&1 <<< "$value_json"; then
        schema_err="capability value must be an object"
    fi
    if [[ -n "$schema_err" ]]; then
        CAP_STATE="fail"
        CAP_DETAIL="malformed github declaration: ${schema_err}"
        return 0
    fi

    if [[ "$(jq '.repos // {} | length' 2>/dev/null <<< "$value_json")" == "0" ]]; then
        CAP_STATE="pass"
        CAP_DETAIL="no repos declared — nothing this capability claims to reach"
        return 0
    fi

    while IFS=$'\t' read -r repo perms; do
        [[ -n "$repo" ]] || continue
        observed=1
        # only `read` has a defined verification (§2)
        if [[ "$perms" == *write* || "$perms" == *trigger-actions* ]]; then
            [[ "$CAP_STATE" != "fail" ]] && CAP_STATE="unverifiable"
            CAP_DETAIL="repo ${repo}: write/trigger-actions have no defined verification"
            continue
        fi
        out="$(run_on_node "$node" \
            "GH_TOKEN=\"\$(cat ~/.mylinuxpool/gh_token 2>/dev/null)\" gh api repos/${repo} >/dev/null 2>&1 && printf MLP_GH_OK" 2>&1)"
        rc=$?
        if [[ $rc -ne 0 ]]; then
            [[ "$CAP_STATE" != "fail" ]] && CAP_STATE="unverifiable"
            CAP_DETAIL="repo ${repo}: could not run the check (hop/ssh failed)"
        elif [[ "$out" == *MLP_GH_OK* ]]; then
            [[ "$CAP_STATE" == "unverifiable" ]] && CAP_STATE="pass"
            [[ -z "$CAP_DETAIL" ]] && CAP_DETAIL="repo ${repo}: read verified"
        else
            CAP_STATE="fail"
            CAP_DETAIL="repo ${repo}: gh api failed${out:+ ($(printf '%s' "$out" | head -c 120))}"
        fi
    done < <(jq -r '.repos // {} | to_entries[] | [.key, (.value | join(","))] | @tsv' 2>/dev/null <<< "$value_json")
    # belt and braces: if the loop never observed anything, stay
    # unverifiable — never promote to pass from an empty run.
    if [[ "$observed" -eq 0 && "$CAP_STATE" == "pass" ]]; then
        CAP_STATE="unverifiable"
        CAP_DETAIL="nothing was observed"
    fi
    return 0
}

# cap_verify_node <node> <capabilities_json> — Model. Sets CAP_ROWS, each
#   `key<TAB>state<TAB>detail`. No output, no picker. A declared key with no
#   defined verification returns `unverifiable` — NEVER `pass`; that is the
#   core of the design (a flag nobody can check must not be reported as
#   true).
cap_verify_node() {
    local node="$1" caps="$2" key value n=0
    CAP_ROWS=()
    while IFS=$'\t' read -r key value; do
        [[ -n "$key" ]] || continue
        n=$((n + 1))
        case "$key" in
            worker-host) cap_verify_worker_host "$node" "$value" ;;
            github)      cap_verify_github "$node" "$value" ;;
            *)
                CAP_STATE="unverifiable"
                CAP_DETAIL="no verification is defined for '${key}'"
                ;;
        esac
        CAP_ROWS+=("${key}"$'\t'"${CAP_STATE}"$'\t'"${CAP_DETAIL}")
    done < <(jq -r 'to_entries[] | [.key, (.value | tojson)] | @tsv' 2>/dev/null <<< "$caps")
    # If the walk itself failed to enumerate anything (malformed caps, or
    # the process substitution yielded nothing), that is "not observed" —
    # record it as unverifiable rather than returning an empty, silently
    # successful row set. cap_verify_one's shape check normally arrives
    # first; this keeps the Model honest when called directly.
    if [[ "$n" -eq 0 && "$(jq 'length' 2>/dev/null <<< "$caps")" != "0" ]]; then
        CAP_ROWS+=("<capabilities>"$'\t'"unverifiable"$'\t'"could not enumerate the declarations")
    fi
    return 0
}

# cap_migrate_value <capabilities_json> — prints the migrated object.
#   Old array -> {"worker-host":{"runtime":"docker"}} iff worker-host is in
#   it (the docker tag folds in; §5). A lone "wol-sender"/"wsl2" is dropped
#   with no replacement (§2/§5). An already-object value (including unknown
#   keys) prints unchanged. Anything else is an error (return 1): the
#   migration must never guess at an unrecognized shape.
cap_migrate_value() {
    local caps="${1:-}"
    if jq -e 'type == "object"' >/dev/null 2>&1 <<< "$caps"; then
        jq -c '.' <<< "$caps"
        return 0
    fi
    if jq -e 'type == "array"' >/dev/null 2>&1 <<< "$caps"; then
        jq -c 'if index("worker-host") != null
               then {"worker-host": {"runtime": "docker"}}
               else {} end' <<< "$caps"
        return 0
    fi
    return 1
}

# cmd_verify_capabilities [<node>|--all] — View: run the Model verifiers and
#   render. Exit codes split by what actually happened (2026-09-25 qa):
#     0  everything verified
#     1  at least one FAILED (the declaration is broken — must fix)
#     3  no failures, but at least one UNVERIFIABLE (no fault, but a
#        declaration nobody can check)
#   unverifiable is deliberately NOT collapsed into 0 — "not verified" is
#   not "verified". Splitting it from 1 keeps a healthy pool with an
#   unverifiable key from showing a permanent red light that people learn
#   to ignore, which would be its own kind of lie.
cmd_verify_capabilities() {
    local node="" all=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --all) all=1; shift ;;
            -*) echo "usage: mlp verify-capabilities [<node>|--all]" >&2; exit 2 ;;
            *) node="$1"; shift ;;
        esac
    done
    if [[ -z "$node" && "$all" -eq 0 ]]; then
        echo "usage: mlp verify-capabilities [<node>|--all]" >&2
        exit 2
    fi
    local var n rc_all=0 rc
    if [[ -n "$node" ]]; then
        cap_verify_one "$node"; rc=$?
        cap_verify_summary "$rc"
        return "$rc"
    fi
    local tally_ok=0 tally_fail=0 tally_unv=0
    while IFS= read -r var; do
        [[ -n "$var" ]] || continue
        [[ "$var" == "NODE_GATEWAY" ]] && continue
        n="$(printf '%s' "${var#NODE_}" | tr '[:upper:]' '[:lower:]' | tr '_' '-')"
        cap_verify_one "$n"; rc=$?
        case "$rc" in
            0) tally_ok=$((tally_ok + 1)) ;;
            3) tally_unv=$((tally_unv + 1)); [[ "$rc_all" -eq 0 ]] && rc_all=3 ;;
            *) tally_fail=$((tally_fail + 1)); rc_all=1 ;;
        esac
    done < <(gh api "repos/${REPO}/actions/variables?per_page=100" --jq '.variables[].name' 2>/dev/null | grep '^NODE_')
    printf '\n%s%s ok, %s fail, %s unverifiable%s\n' \
        "$C_BOLD" "$tally_ok" "$tally_fail" "$tally_unv" "$C_RESET"
    if [[ "$tally_fail" -eq 0 && "$tally_unv" -gt 0 ]]; then
        printf '%sno failures, but %s declaration(s) have no verification defined%s\n' \
            "$C_YELLOW" "$tally_unv" "$C_RESET"
        printf 'that is not "broken" — it is "not checked yet"\n'
    fi
    return "$rc_all"
}

# cap_verify_summary <rc> — one closing line for the single-node path.
cap_verify_summary() {
    case "$1" in
        0) return 0 ;;
        3) printf '\n%s%s%s\n' "$C_YELLOW" "no failures, but something has no verification defined — not checked, not broken" "$C_RESET" ;;
        *) : ;;
    esac
}

# cap_verify_one <node> — View: resolve one node and render its rows.
#   Returns 0 all-ok, 1 any fail, 3 unverifiable-only.
cap_verify_one() {
    local node="$1" json caps
    json="$("$POOL_RESOLVE" "$node" 2>/dev/null)" || { echo "mlp: no such node: ${node}" >&2; return 1; }
    caps="$(jq -c '.capabilities // empty' 2>/dev/null <<< "$json")"
    if [[ -z "$caps" ]]; then
        printf '%s%s%s: no capabilities declared\n' "$C_BOLD" "$node" "$C_RESET"
        return 0
    fi
    if ! cap_shape_ok "$caps"; then
        printf '%s%s%s: capabilities is not key:object — refusing to guess\n' "$C_RED" "$node" "$C_RESET"
        return 1
    fi
    local n
    n="$(jq 'length' <<< "$caps")"
    printf '%s%s%s: %s declared\n' "$C_BOLD" "$node" "$C_RESET" "$n"
    cap_verify_node "$node" "$caps"
    local r key state detail mark rc=0
    for r in "${CAP_ROWS[@]}"; do
        fwd_split_row "$r"
        key="$FWD_C1"; state="$FWD_C2"; detail="$FWD_C3"
        case "$state" in
            pass) mark="${C_GREEN}ok${C_RESET}" ;;
            fail) mark="${C_RED}FAIL${C_RESET}"; rc=1 ;;
            *)    mark="${C_YELLOW}unverifiable${C_RESET}"; [[ "$rc" -eq 0 ]] && rc=3 ;;
        esac
        printf '  %-14s %-14s %s\n' "$key" "$mark" "$detail"
    done
    return "$rc"
}

# cmd_migrate_capabilities — View: one-off, rerunnable migration of every
#   NODE_* variable's capabilities to the new shape (CAPABILITY-DESIGN §5).
#   MERGE, never overwrite: only the capabilities field changes; every other
#   field is carried through byte-for-byte by re-reading the live var and
#   merging. Dry run by default. Idempotent — an already-object var prints
#   "already" and is skipped.
cmd_migrate_capabilities() {
    local real=0 rc_all=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --real) real=1; shift ;;
            *) echo "usage: mlp migrate-capabilities [--real]" >&2; exit 2 ;;
        esac
    done
    local var name json caps new
    while IFS= read -r var; do
        [[ -n "$var" ]] || continue
        [[ "$var" == "NODE_GATEWAY" ]] && continue
        name="$(printf '%s' "${var#NODE_}" | tr '[:upper:]' '[:lower:]' | tr '_' '-')"
        # Read the RAW variable, not pool-resolve's view: the state.json
        # snapshot can be stale, and the merge below must carry the exact
        # bytes of every field it does not own.
        json="$(gh api "repos/${REPO}/actions/variables/${var}" --jq .value 2>/dev/null)" \
            || { echo "skip ${name}: could not read ${var}"; rc_all=1; continue; }
        caps="$(jq -c '.capabilities // empty' 2>/dev/null <<< "$json")"
        if [[ -z "$caps" ]]; then
            echo "${name}: no capabilities — nothing to migrate"
            continue
        fi
        if jq -e 'type == "object"' >/dev/null 2>&1 <<< "$caps"; then
            echo "${name}: already the new shape — skipped"
            continue
        fi
        new="$(cap_migrate_value "$caps")" || { echo "${name}: unrecognized capabilities shape — refusing" >&2; rc_all=1; continue; }
        echo "${name}: $(jq -c . <<< "$caps") -> ${new}"
        if [[ "$real" -eq 0 ]]; then
            continue
        fi
        # merge: replace ONLY capabilities, keep every other key of the live
        # declaration untouched (hops/power/tunnel_public_key/... must not
        # move a byte).
        printf '%s' "$json" | jq -c --argjson c "$new" '.capabilities = $c' \
            | gh variable set "$var" --repo "$REPO" \
            || { echo "${name}: write failed" >&2; return 1; }
        echo "${name}: written"
    done < <(gh api "repos/${REPO}/actions/variables?per_page=100" --jq '.variables[].name' 2>/dev/null | grep '^NODE_')
    [[ "$real" -eq 1 ]] || echo "(dry run — pass --real to write)"
    return "$rc_all"
}

# ---- main menu --------------------------------------------------------------
main_menu() {
    local choice action
    while true; do
        choice="$(
            printf '%s\n' \
                "ls      list providers/workers and their live state" \
                "ssh     pick a node/worker and connect" \
                "wake           wake fh-l" \
                "down           shut down fh-l" \
                "status         run pool-status" \
                "state          compare master vs Gateway vs local snapshots" \
                "rotate         Gateway dry run (builds and discards a preview machine)" \
                "rotate-real    replace the live Gateway for real (asks you to type its IP)" \
                "worker-new     build and start a worker on a provider" \
                "worker-rm      stop a worker and release its port" \
                "fwd-add        forward a local port to a node (pick node, type spec)" \
                "fwd-ls         list local forwards with live state" \
                "fwd-rm         remove a local forward (pick)" \
                "ssh-config     write an ssh_config so plain ssh/scp/rsync work" \
                "trust-gateway  re-accept the Gateway's host key after a rotate" \
                "quit           exit" \
            | fzf --prompt='mlp> ' --height='~50%' --header='select an action (Esc to quit)'
        )"

        [[ -n "$choice" ]] || break
        action="$(printf '%s' "$choice" | awk '{print $1}')"

        case "$action" in
            ls) cmd_ls ;;
            ssh) cmd_ssh ;;
            wake) cmd_wake ;;
            down) cmd_down ;;
            status) cmd_status ;;
            state) cmd_state ;;
            rotate) cmd_rotate ;;
            rotate-real) cmd_rotate --real ;;
            worker-new) worker_new ;;
            worker-rm) worker_rm ;;
            fwd-add) fwd_menu_add ;;
            fwd-ls) cmd_fwd ls ;;
            fwd-rm) cmd_fwd rm ;;
            ssh-config) cmd_ssh_config --write ;;
            trust-gateway) cmd_trust_gateway ;;
            quit) break ;;
        esac

        echo ""
        printf 'press Enter to return to the menu...'
        read -r _
    done
}

main() {
    local cmd="${1:-}"

    if [[ "$cmd" == "-h" || "$cmd" == "--help" ]]; then
        usage
        exit 0
    fi

    check_deps

    if [[ -n "$cmd" ]]; then
        shift
    fi

    case "$cmd" in
        "")
            # No subcommand means the interactive menu, which needs a human.
            interactive_only || { usage >&2; exit 2; }
            main_menu
            ;;
        ls) cmd_ls "$@" ;;
        ssh)
            # Boundary guard for the omitted-name picker (see cmd_ssh's
            # note): refuse before anything resolves.
            if [[ $# -eq 0 ]]; then
                interactive_only || {
                    echo "usage: mlp ssh [<node-name|worker-name|port>]  (fzf pick when omitted)" >&2
                    exit 2
                }
            fi
            cmd_ssh "$@"
            ;;
        wake) cmd_wake "$@" ;;
        down) cmd_down "$@" ;;
        status) cmd_status "$@" ;;
        state) cmd_state "$@" ;;
        rotate) cmd_rotate "$@" ;;
        worker) cmd_worker "$@" ;;
        register) cmd_register "$@" ;;
        ssh-config) cmd_ssh_config "$@" ;;
        trust-gateway) cmd_trust_gateway "$@" ;;
        fwd) cmd_fwd "$@" ;;
        verify-capabilities) cmd_verify_capabilities "$@" ;;
        migrate-capabilities) cmd_migrate_capabilities "$@" ;;
        *)
            echo "mlp: unknown command '${cmd}'" >&2
            usage
            exit 2
            ;;
    esac
}

# Only run as a standalone command when actually executed, not sourced —
# sourcing is how tests load the functions above (same pattern as
# scripts/lib/crypto.sh and pool-tunnel).
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
