#!/usr/bin/env bash
# ops-scripts/mlp — interactive admin CLI for MyLinuxPool, run from the operator's
# own Mac (DDNS is gone; this replaces hand-building `ssh -J ...` chains).
#
# bash 3.2 COMPATIBLE ON PURPOSE — macOS ships 3.2, not bash 4+, and that
# is very easy to forget on a Mac that also has a newer bash on $PATH via
# Homebrew. Concretely, this file must never use:
#   - associative arrays (`declare -A`)
#   - ${var,,} / ${var^^} case conversion (use `tr` instead)
#   - `mapfile`/`readarray`
# Plain indexed arrays, `[[ ... ]]`, process substitution and `printf %q`
# are all fine — those have been in bash since well before 3.2.
#
# All node connection info comes from shared-configs/pool-runtime's
# pool-resolve. The one direct `gh api` call in this file (in
# gather_targets) only enumerates NODE_* variable NAMES — pool-resolve has
# no "list all nodes" capability and neither does anything else here, so
# this is the same narrow, already-established exception pool-status uses
# for the same reason. No connection info (ip/port/user/...) is ever read
# from `gh` directly — that always goes through pool-resolve.
#
# HOST KEY TRUST MODEL (2026-09-14 incident — read this before touching
# any ssh call below):
#   - The Gateway is the one real trust boundary here, and it IS a stable
#     identity between rotates — its host key is checked, but against a
#     DEDICATED known_hosts file ($GW_KNOWN_HOSTS), never the operator's
#     own ~/.ssh/known_hosts. Rotating the Gateway changes its host key
#     on purpose; polluting the user's real known_hosts with it would
#     make a *future* rotate look like a MITM attack there instead
#     ("REMOTE HOST IDENTIFICATION HAS CHANGED"), right when the operator
#     most needs to get in. `mlp trust-gateway` clears and re-accepts it.
#   - 127.0.0.1:<port> (every provider/worker, on the far side of the
#     Gateway) is NOT a stable identity — worker ports get reused for a
#     different container, and it's always 127.0.0.1 regardless of which
#     machine is actually listening. Recording a host key for it would
#     be pure false confidence: it doesn't verify anything real, and it
#     actively causes spurious "changed" failures on ordinary port reuse.
#     Every connection to that hop uses UserKnownHostsFile=/dev/null +
#     StrictHostKeyChecking=no, on purpose — not laziness.
#   - Multi-hop connections (any provider/worker) reach this mixed model
#     via `-o ProxyCommand=...`, not `-J`: `-J` applies the SAME ssh
#     options to every hop, which can't express "verify the Gateway,
#     don't verify past it". ProxyCommand runs the Gateway leg as its own
#     ssh invocation with its own options, entirely independent of the
#     outer (destination-hop) ssh's options.

set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
POOL_RESOLVE="${REPO_ROOT}/shared-configs/pool-runtime/files/pool-resolve"
POOL_STATUS="${REPO_ROOT}/shared-configs/pool-runtime/files/pool-status"
REPO="${POOL_REPO:-FATESAIKOU/MyLinuxPool}"

# shellcheck source=../scripts/lib/ssh.sh
source "${REPO_ROOT}/scripts/lib/ssh.sh"

MLP_STATE_DIR="${HOME}/.mylinuxpool"
GW_KNOWN_HOSTS="${MLP_STATE_DIR}/known_hosts"

CTL_DIR=""
CTL=""
GW_IP=""
GW_USER=""
GW_HOST_KEY=""

# ---- colors: tput, off outside a real terminal --------------------------
if [[ -t 1 ]] && command -v tput >/dev/null 2>&1; then
    C_RESET="$(tput sgr0 2>/dev/null)"
    C_BOLD="$(tput bold 2>/dev/null)"
    C_GREEN="$(tput setaf 2 2>/dev/null)"
    C_RED="$(tput setaf 1 2>/dev/null)"
    C_YELLOW="$(tput setaf 3 2>/dev/null)"
else
    C_RESET=""; C_BOLD=""; C_GREEN=""; C_RED=""; C_YELLOW=""
fi

die() {
    echo "mlp: $*" >&2
    exit 1
}

usage() {
    cat <<'EOF'
usage: mlp [command]

  (no command)     interactive main menu
  ls               list providers/workers with live state
  ssh [name]       connect to a node or worker (menu if name omitted)
  wake [name]       wake a node declaring power.launch (fzf pick if none given / more than one)
  down [name]       shut down a node declaring power.shutdown (fzf pick if none given / more than one)
  state            compare master (GitHub) vs Gateway state.json vs local snapshot
  status           run pool-status
  rotate [--real]  rotate the Gateway (dry run unless --real)
  worker new       build and start a worker on a provider
  worker rm [name] stop a worker and release its port
  register client  register THIS machine (the one you are on) as a client
                   — uploads your public key. Run it on the machine you
                   will connect FROM.
  register provider  register a NEW machine into the pool. Run it ON
                   that new machine, not here on the Mac.
  ssh-config       print an ssh_config for the pool (--write to install it)
  trust-gateway    re-accept the Gateway's host key after a rotate
  -h, --help       show this help

requires: fzf, jq, gh — install missing ones with `brew install <name>`
EOF
}

check_deps() {
    local missing=""
    command -v fzf >/dev/null 2>&1 || missing="${missing} fzf"
    command -v jq >/dev/null 2>&1 || missing="${missing} jq"
    command -v gh >/dev/null 2>&1 || missing="${missing} gh"
    if [[ -n "$missing" ]]; then
        echo "mlp: missing required tool(s):${missing}" >&2
        echo "install with: brew install${missing}" >&2
        exit 1
    fi
    if [[ ! -x "$POOL_RESOLVE" ]]; then
        die "pool-resolve not found at ${POOL_RESOLVE} — run mlp from inside a MyLinuxPool checkout"
    fi
    mkdir -p "$MLP_STATE_DIR"
    touch "$GW_KNOWN_HOSTS"
}

# ---- gateway + shared ControlMaster --------------------------------------
# One ssh session to the Gateway, reused for every port probe below —
# never open a new connection per node. Same idea as pool-tunnel's own
# health check riding its ControlMaster instead of a fresh handshake.

resolve_gateway() {
    local json rc
    # --refresh, not the 30s cache. Every command here means "through the
    # Gateway that is current right now"; served from cache, `ls` spends up
    # to 30 seconds after a rotate probing the previous machine, which is
    # still running until it is promoted away — so the table mixes nodes
    # that moved with nodes that had not yet, and reads as a fault when
    # nothing is wrong. One API call per command is the right price for an
    # interactive tool, and it also means the host key pinned below is the
    # current one.
    json="$("$POOL_RESOLVE" gateway --refresh)"
    rc=$?
    [[ $rc -eq 0 ]] || die "pool-resolve gateway failed (exit ${rc})"
    GW_IP="$(printf '%s' "$json" | jq -r '.ip // empty')"
    GW_USER="$(printf '%s' "$json" | jq -r '.user // empty')"
    GW_HOST_KEY="$(printf '%s' "$json" | jq -r '.host_key // empty')"
    [[ -n "$GW_IP" && -n "$GW_USER" ]] || die "NODE_GATEWAY is missing ip/user"

    # NODE_GATEWAY carries the Gateway's host key, written by the rotate
    # that built the machine and writable only by Actions. Pin to it, so a
    # rotate needs no `trust-gateway` afterwards and a recycled Linode
    # address cannot collide with a stale entry (RUNBOOK §7.8).
    if [[ -n "$GW_HOST_KEY" ]]; then
        mkdir -p "$MLP_STATE_DIR"
        if ! grep -qxF "${GW_IP} ${GW_HOST_KEY}" "$GW_KNOWN_HOSTS" 2>/dev/null; then
            ssh-keygen -R "$GW_IP" -f "$GW_KNOWN_HOSTS" >/dev/null 2>&1
            printf '%s %s\n' "$GW_IP" "$GW_HOST_KEY" >> "$GW_KNOWN_HOSTS"
        fi
    fi
}

# client_identity_path — the key this client authenticates with.
#   ONE definition, used both by mlp's own ssh calls and by the ssh_config
#   it writes. id_mlp is what `mlp register client` creates and publishes;
#   ssh's built-in candidates (id_rsa, id_ed25519, ...) do NOT include it,
#   so every ssh invocation must pass -i explicitly or it silently falls
#   back to a key the pool may have stopped authorising — which is exactly
#   how `mlp` started failing with Permission denied while a direct
#   `ssh -i ~/.ssh/id_mlp` still worked.
client_identity_path() {
    # Sourced, never restated: tunnel-identity.sh is the one place that
    # says which file holds which key (RUNBOOK §7.12 — a rule with two
    # implementations is a rule that drifts). Prefer the copy installed on
    # this machine, fall back to the repo's.
    local ti
    for ti in "${HOME}/.mylinuxpool/bin/tunnel-identity.sh" \
              "${SCRIPT_DIR}/../shared-configs/pool-runtime/files/tunnel-identity.sh"; do
        if [[ -f "$ti" ]]; then
            # shellcheck source=/dev/null
            . "$ti"
            break
        fi
    done
    [[ -n "${CLIENT_KEY:-}" ]] || return 1
    echo "$CLIENT_KEY"
}

# client_identity_opts — the -i/-o pair for ssh, empty when no key is found
#   (ssh then falls back to its own defaults, and says so itself).
client_identity_opts() {
    local key
    key="$(client_identity_path)" || return 0
    printf '%s' "-i ${key} -o IdentitiesOnly=yes"
}

# Every ssh in this file ultimately goes through scripts/lib/ssh.sh, which
# reads SSH_IDENTITY. Set it ONCE, here, for the whole program.
#
# Setting it per call site is how `mlp down` kept failing with Permission
# denied after `mlp ssh` had been fixed: do_connect declared it `local`, so
# run_on_node — a different path to the same two helpers — still had none.
# That is the same "one rule, several implementations" mistake the rule
# itself exists to prevent (RUNBOOK §7.12). A global assignment cannot be
# half-applied.
SSH_IDENTITY="$(client_identity_path 2>/dev/null || true)"

open_gateway_master() {
    CTL_DIR="$(mktemp -d "${TMPDIR:-/tmp}/mlp.XXXXXX")" || return 1
    CTL="${CTL_DIR}/ctl-gateway"
    local err rc
    local ident; read -r -a ident <<< "$(client_identity_opts)"
    err="$(ssh -M -S "$CTL" -o ControlPersist=60 -o ConnectTimeout=8 \
        ${ident[@]+"${ident[@]}"} \
        -o UserKnownHostsFile="$GW_KNOWN_HOSTS" -o StrictHostKeyChecking=accept-new -o BatchMode=yes \
        -N -f "${GW_USER}@${GW_IP}" < /dev/null 2>&1)"
    rc=$?
    if [[ $rc -ne 0 ]]; then
        if printf '%s' "$err" | grep -qi 'REMOTE HOST IDENTIFICATION HAS CHANGED\|host key verification failed'; then
            echo "mlp: Gateway's host key has changed — this usually means it was just rotated." >&2
            echo "mlp: if you just ran rotate-gateway, this is expected: run 'mlp trust-gateway', then try again." >&2
        else
            echo "mlp: could not connect to Gateway (${GW_USER}@${GW_IP}):" >&2
            printf '%s\n' "$err" >&2
        fi
    fi
    return "$rc"
}

# Clears any stale entry for the Gateway's current IP from the DEDICATED
# known_hosts file (never ~/.ssh/known_hosts — see the top-of-file trust
# model note) and re-accepts whatever key it presents right now.
cmd_trust_gateway() {
    resolve_gateway
    mkdir -p "$MLP_STATE_DIR"
    touch "$GW_KNOWN_HOSTS"

    # resolve_gateway already pinned the key NODE_GATEWAY carries, which
    # is a real identity check rather than trusting whatever answers.
    # Nothing left to do, and nothing to accept on faith.
    if [[ -n "$GW_HOST_KEY" ]]; then
        printf '%spinned %s from NODE_GATEWAY%s → %s\n' \
            "$C_GREEN" "$GW_IP" "$C_RESET" "$GW_KNOWN_HOSTS"
        echo "  (no trust-on-first-use needed; this runs automatically on every mlp command)"
        return 0
    fi

    # Unconditional and silent-if-nothing-to-do on purpose: macOS's default
    # /etc/ssh/ssh_config sets HashKnownHosts yes, so entries in here won't
    # be plaintext-grep-able — ssh-keygen -R already knows how to find a
    # hashed entry, a plain grep pre-check would not.
    ssh-keygen -R "$GW_IP" -f "$GW_KNOWN_HOSTS" >/dev/null 2>&1
    echo "cleared any old host key entry for ${GW_IP} in ${GW_KNOWN_HOSTS}"

    local ident2; read -r -a ident2 <<< "$(client_identity_opts)"
    if ssh -o UserKnownHostsFile="$GW_KNOWN_HOSTS" -o StrictHostKeyChecking=accept-new \
           "${ident2[@]}" \
           -o ConnectTimeout=8 -o BatchMode=yes "${GW_USER}@${GW_IP}" true < /dev/null 2>/dev/null; then
        printf '%strusted Gateway host key for %s%s → %s\n' "$C_GREEN" "$GW_IP" "$C_RESET" "$GW_KNOWN_HOSTS"
    else
        die "could not connect to ${GW_USER}@${GW_IP} to accept its host key — check connectivity first"
    fi
}

close_gateway_master() {
    if [[ -n "$CTL" && -S "$CTL" ]]; then
        ssh -S "$CTL" -O exit "${GW_USER}@${GW_IP}" < /dev/null >/dev/null 2>&1 || true
    fi
    [[ -n "$CTL_DIR" ]] && rm -rf "$CTL_DIR" 2>/dev/null || true
    CTL=""
    CTL_DIR=""
}

# Rides the shared ControlMaster; the remote-side `timeout` (present on
# the Gateway) bounds the actual check, so no local `timeout` binary is
# needed here — macOS doesn't ship one by default. Echoes up|down.
#
# `< /dev/null` on the LOCAL ssh here is not optional (2026-09-14
# incident): this runs inside `while read ... done < <(gather_targets)`
# loops in cmd_ls/cmd_ssh. Without it, ssh inherits the loop's stdin —
# which is the process-substitution pipe still holding unread rows — and
# happily eats from it, so the outer `read` silently loses whatever
# gather_targets hadn't produced yet (fh-proxy and one worker vanished
# from `mlp ls` this way). The `</dev/null` *inside* the quoted remote
# command string is unrelated: that one runs on the Gateway, for `nc`.
gw_probe_port() {
    local port="$1" banner
    banner="$(ssh -S "$CTL" -o ConnectTimeout=5 "${GW_USER}@${GW_IP}" \
        "timeout 2 nc 127.0.0.1 ${port} </dev/null | head -c 4" < /dev/null 2>/dev/null)"
    if [[ "$banner" == SSH-* ]]; then
        printf 'up'
    else
        printf 'down'
    fi
}

# Same `< /dev/null` requirement as gw_probe_port above, for the same
# reason — this is called from inside gather_targets, which itself feeds
# a `while read ... done < <(...)` loop in more than one caller. Do not
# "clean up" this redirection; removing it reproduces the bug where rows
# after this call silently disappear from `mlp ls`/`mlp ssh`'s menu.
gw_run() {
    # Runs one command on the Gateway over the shared ControlMaster.
    ssh -S "$CTL" -o ConnectTimeout=8 "${GW_USER}@${GW_IP}" "$1" < /dev/null 2>/dev/null
}

# ---- generic "run a command on any registered node" ----------------------
# Builds a connection from pool-resolve <node> --expand-hops and runs $2
# there. Every real chain today is exactly gateway+1 (see ARCHITECTURE.md
# §3 — no node is ever more than one hop past the Gateway), so this
# handles exactly that shape rather than an arbitrary-depth `-J` chain —
# which also matters for the trust model below: `-J` applies the SAME
# ssh options to every hop, so it can't express "verify the Gateway,
# don't verify past it" (see the top-of-file note). ProxyCommand can,
# because it's a fully separate ssh invocation for the Gateway leg.
run_on_node() {
    local node="$1" cmd="$2"
    local hops_json count hop0 host0 port0 user0 hop1 host1 port1 user1

    hops_json="$("$POOL_RESOLVE" "$node" --expand-hops 2>/dev/null)"
    if [[ $? -ne 0 || -z "$hops_json" ]]; then
        echo "mlp: could not resolve hop chain for '${node}'" >&2
        return 1
    fi

    count="$(printf '%s' "$hops_json" | jq 'length' 2>/dev/null)"
    case "$count" in
        ''|*[!0-9]*) echo "mlp: malformed hop chain for '${node}'" >&2; return 1 ;;
    esac
    if [[ "$count" -lt 1 ]]; then
        echo "mlp: empty hop chain for '${node}'" >&2
        return 1
    fi

    hop0="$(printf '%s' "$hops_json" | jq -c '.[0]')"
    host0="$(printf '%s' "$hop0" | jq -r '.host')"
    port0="$(printf '%s' "$hop0" | jq -r '.port // 22')"
    user0="$(printf '%s' "$hop0" | jq -r '.user')"

    if [[ "$count" -eq 1 ]]; then
        # node has no hops of its own — it IS the Gateway. Direct
        # connection, verified against the dedicated Gateway known_hosts.
        ssh_gateway_only "$GW_KNOWN_HOSTS" "$user0" "$host0" "$port0" "$cmd" < /dev/null
        return $?
    fi

    if [[ "$count" -ne 2 ]]; then
        echo "mlp: hop chain for '${node}' has ${count} hops — mlp only knows how to reach gateway+1" >&2
        return 1
    fi

    hop1="$(printf '%s' "$hops_json" | jq -c '.[1]')"
    host1="$(printf '%s' "$hop1" | jq -r '.host')"
    port1="$(printf '%s' "$hop1" | jq -r '.port // 22')"
    user1="$(printf '%s' "$hop1" | jq -r '.user')"

    # hop0 is the Gateway (verified via its dedicated known_hosts); hop1
    # is 127.0.0.1:<port> on the far side of the reverse tunnel — not a
    # stable identity (see scripts/lib/ssh.sh's top-of-file note), so no
    # host-key checking at all for it, on purpose.
    ssh_via_gateway "$GW_KNOWN_HOSTS" "$user0" "$host0" "$port0" "$user1" "$host1" "$port1" "$cmd" < /dev/null
}

# ---- gather providers + workers ------------------------------------------
# Prints TSV: name<TAB>type<TAB>provider<TAB>port<TAB>user
# type is one of: provider | worker (gateway is handled separately by
# callers, since it never needs a Gateway hop to reach).
gather_targets() {
    local var node json role name port user

    while IFS= read -r var; do
        [[ -n "$var" ]] || continue
        [[ "$var" == "NODE_GATEWAY" ]] && continue
        node="$(printf '%s' "${var#NODE_}" | tr '[:upper:]' '[:lower:]')"
        json="$("$POOL_RESOLVE" "$node" 2>/dev/null)" || continue
        role="$(printf '%s' "$json" | jq -r '.role // empty' 2>/dev/null)"
        [[ "$role" == "provider" ]] || continue
        name="$(printf '%s' "$json" | jq -r '.name // empty' 2>/dev/null)"
        port="$(printf '%s' "$json" | jq -r '.gateway_port // empty' 2>/dev/null)"
        user="$(printf '%s' "$json" | jq -r '.user // empty' 2>/dev/null)"
        [[ -n "$name" && -n "$port" && -n "$user" ]] || continue
        printf '%s\tprovider\t-\t%s\t%s\n' "$name" "$port" "$user"
    done < <(gh api "repos/${REPO}/actions/variables?per_page=100" --jq '.variables[].name' 2>/dev/null | grep '^NODE_')

    local workers_json count i entry wprovider wport wcontainer wname
    workers_json="$(gw_run '~/.mylinuxpool/bin/pool-port-alloc --list')"
    [[ -n "$workers_json" ]] || workers_json='[]'

    count="$(printf '%s' "$workers_json" | jq 'length' 2>/dev/null)"
    case "$count" in ''|*[!0-9]*) count=0 ;; esac

    i=0
    while [[ "$i" -lt "$count" ]]; do
        entry="$(printf '%s' "$workers_json" | jq -c ".[$i]")"
        wprovider="$(printf '%s' "$entry" | jq -r '.provider // empty')"
        wport="$(printf '%s' "$entry" | jq -r '.port // empty')"
        wcontainer="$(printf '%s' "$entry" | jq -r '.container // empty')"
        wname="$wcontainer"
        [[ -n "$wname" && "$wname" != "null" ]] || wname="worker-${wport}"
        [[ -n "$wport" ]] && printf '%s\tworker\t%s\t%s\tworker\n' "$wname" "$wprovider" "$wport"
        i=$((i + 1))
    done
}

# ---- ls -------------------------------------------------------------------
print_state() {
    if [[ "$1" == "up" ]]; then
        printf '%s%-4s%s\n' "$C_GREEN" "up" "$C_RESET"
    else
        printf '%s%-4s%s\n' "$C_RED" "down" "$C_RESET"
    fi
}

cmd_ls() {
    resolve_gateway
    if ! open_gateway_master; then
        echo "mlp: Gateway unreachable (${GW_USER}@${GW_IP}) — nothing can be probed" >&2
        return 1
    fi

    # Two passes: gather all rows first, then size the NAME column to the
    # longest one actually seen (worker container names can run long,
    # e.g. mlp-fh-proxy-base-34797874425) — a fixed width just breaks
    # alignment on those instead of ever being "wide enough".
    local name type provider port user state
    local rows=()
    rows[0]="$(printf 'gateway\tgateway\t-\t22\tup')"

    while IFS=$'\t' read -r name type provider port user; do
        [[ -n "$name" ]] || continue
        state="$(gw_probe_port "$port")"
        rows+=("$(printf '%s\t%s\t%s\t%s\t%s' "$name" "$type" "$provider" "$port" "$state")")
    done < <(gather_targets)

    close_gateway_master

    local namewidth=4 r rname rlen
    for r in "${rows[@]}"; do
        rname="${r%%$'\t'*}"
        rlen="${#rname}"
        [[ "$rlen" -gt "$namewidth" ]] && namewidth="$rlen"
    done

    local fmt="%-${namewidth}s  %-9s %-12s %-6s "
    printf "${C_BOLD}${fmt}%s${C_RESET}\n" "NAME" "TYPE" "PROVIDER" "PORT" "STATE"

    for r in "${rows[@]}"; do
        IFS=$'\t' read -r name type provider port state <<< "$r"
        printf "$fmt" "$name" "$type" "$provider" "$port"
        print_state "$state"
    done
}

# ---- ssh ------------------------------------------------------------------
do_connect() {
    local type="$1" port="$2" user="$3"
    # This is an interactive login (a human is about to get a shell) —
    # BatchMode must be off here, unlike every other caller of
    # ssh_gateway_only/ssh_via_gateway in this file, or a key needing a
    # passphrase would fail instead of prompting.
    local SSH_BATCH_MODE=no
    case "$type" in
        gateway)
            ssh_gateway_only "$GW_KNOWN_HOSTS" "$GW_USER" "$GW_IP" 22
            ;;
        provider|worker)
            # See scripts/lib/ssh.sh's trust-model note: the Gateway leg
            # is verified (dedicated known_hosts, via ProxyCommand); the
            # 127.0.0.1:<port> leg is not checked at all, on purpose.
            ssh_via_gateway "$GW_KNOWN_HOSTS" "$GW_USER" "$GW_IP" 22 "$user" 127.0.0.1 "$port"
            ;;
        *)
            die "unknown target type: ${type}"
            ;;
    esac
}

connect_by_name() {
    local name="$1" json rc role port user workers_json match_port

    json="$("$POOL_RESOLVE" "$name" 2>/dev/null)"
    rc=$?
    if [[ $rc -eq 0 ]]; then
        role="$(printf '%s' "$json" | jq -r '.role // empty')"
        if [[ "$role" == "gateway" ]]; then
            do_connect gateway 22 ""
            return $?
        fi
        if [[ "$role" == "provider" ]]; then
            port="$(printf '%s' "$json" | jq -r '.gateway_port // empty')"
            user="$(printf '%s' "$json" | jq -r '.user // empty')"
            if [[ -n "$port" && -n "$user" ]]; then
                do_connect provider "$port" "$user"
                return $?
            fi
        fi
    fi

    # Not a registered node — workers deliberately aren't (spec §10.3), so
    # try matching by container name or bare port against the Gateway's
    # own placeholder ledger.
    if ! open_gateway_master; then
        die "Gateway unreachable (${GW_USER}@${GW_IP})"
    fi
    workers_json="$(gw_run '~/.mylinuxpool/bin/pool-port-alloc --list')"
    close_gateway_master
    [[ -n "$workers_json" ]] || workers_json='[]'

    if [[ "$name" =~ ^[0-9]+$ ]]; then
        match_port="$name"
    else
        match_port="$(printf '%s' "$workers_json" | jq -r --arg n "$name" \
            '[.[] | select(.container == $n)] | first | .port // empty' 2>/dev/null)"
    fi

    if [[ -n "$match_port" && "$match_port" != "null" ]]; then
        do_connect worker "$match_port" worker
        return $?
    fi

    die "no such node or worker: ${name}"
}

cmd_ssh() {
    local target="${1:-}"
    if [[ "$target" == -* ]]; then
        echo "usage: mlp ssh [<node-name|worker-name|port>]  (fzf pick when omitted)" >&2
        exit 2
    fi
    resolve_gateway

    if [[ -n "$target" ]]; then
        connect_by_name "$target"
        return $?
    fi

    if ! open_gateway_master; then
        die "Gateway unreachable (${GW_USER}@${GW_IP})"
    fi

    local name type provider port user state selected
    selected="$(
        {
            printf 'gateway\tgateway\t-\t22\t%s\tup\n' "$GW_USER"
            while IFS=$'\t' read -r name type provider port user; do
                [[ -n "$name" ]] || continue
                state="$(gw_probe_port "$port")"
                printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$name" "$type" "$provider" "$port" "$user" "$state"
            done < <(gather_targets)
        } | fzf --delimiter=$'\t' --with-nth=1,2,3,4,6 \
                --header='NAME  TYPE  PROVIDER  PORT  STATE' \
                --prompt='ssh> ' --height='~60%'
    )"

    close_gateway_master

    [[ -n "$selected" ]] || return 0

    IFS=$'\t' read -r name type provider port user state <<< "$selected"
    do_connect "$type" "$port" "$user"
}

# ---- wake / down ------------------------------------------------------------
# The set of nodes that can be woken / shut down is whatever NODE_* declares
# under .power — never a hardcoded name (REDESIGN §3.35: NODE_FH_L.power was
# the master copy, and cmd_wake/cmd_down hardcoding fh-l was the second).
power_targets() {
    local action="$1" var node json
    while IFS= read -r var; do
        [[ -n "$var" ]] || continue
        [[ "$var" == "NODE_GATEWAY" ]] && continue
        node="$(printf '%s' "${var#NODE_}" | tr '[:upper:]' '[:lower:]' | tr '_' '-')"
        json="$("$POOL_RESOLVE" "$node" 2>/dev/null)" || continue
        if printf '%s' "$json" | jq -e --arg a "$action" '.power[$a] != null' >/dev/null 2>&1; then
            printf '%s\n' "$node"
        fi
    done < <(gh api "repos/${REPO}/actions/variables?per_page=100" --jq '.variables[].name' 2>/dev/null | grep '^NODE_')
}

# pick_power_target <action> — returns exactly one node name.
pick_power_target() {
    local action="$1" nodes=() n
    while IFS= read -r n; do
        [[ -n "$n" ]] && nodes+=("$n")
    done < <(power_targets "$action")

    case "${#nodes[@]}" in
        0)
            die "no node declares .power.${action} — nothing to wake/down"
            ;;
        1)
            printf '%s\n' "${nodes[0]}"
            ;;
        *)
            printf '%s\n' "${nodes[@]}" \
                | fzf --prompt="${action}> " --height='~40%' \
                      --header="multiple nodes declare .power.${action} — pick one"
            ;;
    esac
}

cmd_wake() {
    local node="${1:-}" json rc method via mac target_ip port waited state
    if [[ "$node" == -* ]]; then
        echo "usage: mlp wake [<node-name>]  (node must declare .power.launch; fzf pick when omitted)" >&2
        exit 2
    fi
    resolve_gateway

    if [[ -n "$node" ]]; then
        json="$("$POOL_RESOLVE" "$node")"
        rc=$?
        [[ $rc -eq 0 ]] || die "pool-resolve ${node} failed (exit ${rc})"
        if ! printf '%s' "$json" | jq -e '.power.launch != null' >/dev/null 2>&1; then
            die "${node} does not declare .power.launch — nothing to wake"
        fi
    else
        node="$(pick_power_target launch)"
        [[ -n "$node" ]] || { echo "aborted."; return 1; }
        json="$("$POOL_RESOLVE" "$node")"
        rc=$?
        [[ $rc -eq 0 ]] || die "pool-resolve ${node} failed (exit ${rc})"
    fi

    method="$(printf '%s' "$json" | jq -r '.power.launch.method // empty')"
    via="$(printf '%s' "$json" | jq -r '.power.launch.via // empty')"
    mac="$(printf '%s' "$json" | jq -r '.power.launch.mac // empty')"
    target_ip="$(printf '%s' "$json" | jq -r '.power.launch.target_ip // empty')"
    port="$(printf '%s' "$json" | jq -r '.gateway_port // empty')"

    [[ "$method" == "wol-unicast" ]] || die "NODE_${node}.power.launch.method is '${method:-<empty>}', expected wol-unicast"
    [[ -n "$via" && -n "$mac" && -n "$target_ip" && -n "$port" ]] || die "NODE_${node}.power.launch is missing via/mac/target_ip, or gateway_port is missing"

    echo "waking ${node} via ${via}: unicast WoL to ${mac} @ ${target_ip} ..."
    if ! run_on_node "$via" "~/.mylinuxpool/bin/pool-wol ${mac} ${target_ip}"; then
        die "failed to send WoL packet via ${via}"
    fi

    echo "packet sent — waiting for ${node}'s port (${port}) on the Gateway (up to 5 minutes)"
    if ! open_gateway_master; then
        die "Gateway unreachable while waiting"
    fi

    waited=0
    while [[ "$waited" -lt 300 ]]; do
        state="$(gw_probe_port "$port")"
        if [[ "$state" == "up" ]]; then
            close_gateway_master
            printf '\n%s%s is up%s (after %ss)\n' "$C_GREEN" "$node" "$C_RESET" "$waited"
            return 0
        fi
        printf '.'
        sleep 5
        waited=$((waited + 5))
    done

    close_gateway_master
    echo ""
    die "timed out after 5 minutes waiting for ${node}"
}

cmd_down() {
    local node="${1:-}" json rc method shutdown_cmd port confirm waited state
    if [[ "$node" == -* ]]; then
        echo "usage: mlp down [<node-name>]  (node must declare .power.shutdown; fzf pick when omitted)" >&2
        exit 2
    fi
    resolve_gateway

    if [[ -n "$node" ]]; then
        json="$("$POOL_RESOLVE" "$node")"
        rc=$?
        [[ $rc -eq 0 ]] || die "pool-resolve ${node} failed (exit ${rc})"
        if ! printf '%s' "$json" | jq -e '.power.shutdown != null' >/dev/null 2>&1; then
            die "${node} does not declare .power.shutdown — nothing to shut down"
        fi
    else
        node="$(pick_power_target shutdown)"
        [[ -n "$node" ]] || { echo "aborted."; return 1; }
        json="$("$POOL_RESOLVE" "$node")"
        rc=$?
        [[ $rc -eq 0 ]] || die "pool-resolve ${node} failed (exit ${rc})"
    fi

    method="$(printf '%s' "$json" | jq -r '.power.shutdown.method // empty')"
    shutdown_cmd="$(printf '%s' "$json" | jq -r '.power.shutdown.command // empty')"
    port="$(printf '%s' "$json" | jq -r '.gateway_port // empty')"

    [[ "$method" == "ssh" && -n "$shutdown_cmd" ]] || die "NODE_${node}.power.shutdown is missing method/command"
    [[ -n "$port" ]] || die "NODE_${node} is missing gateway_port"

    printf '%sThis will shut down %s%s (running: %s)\n' "$C_YELLOW" "$node" "$C_RESET" "$shutdown_cmd"
    printf 'Type "yes" to confirm: '
    read -r confirm
    if [[ "$confirm" != "yes" ]]; then
        echo "aborted."
        return 1
    fi

    echo "sending shutdown command to ${node}..."
    if ! run_on_node "$node" "$shutdown_cmd"; then
        die "failed to run shutdown command on ${node}"
    fi

    echo "waiting for ${node}'s port (${port}) to disappear from the Gateway (up to 2 minutes)"
    if ! open_gateway_master; then
        die "Gateway unreachable while waiting"
    fi

    waited=0
    while [[ "$waited" -lt 120 ]]; do
        state="$(gw_probe_port "$port")"
        if [[ "$state" == "down" ]]; then
            close_gateway_master
            printf '\n%s%s is down%s (after %ss)\n' "$C_GREEN" "$node" "$C_RESET" "$waited"
            return 0
        fi
        printf '.'
        sleep 5
        waited=$((waited + 5))
    done

    close_gateway_master
    echo ""
    die "${node}'s port is still up after 2 minutes — shutdown may not have worked"
}

# ---- mlp state --------------------------------------------------------------
# Compares the three copies of cluster truth (REDESIGN N7):
#   master   GitHub NODE_* + POOL_WORKERS
#   gateway  /var/lib/mylinuxpool/state.json (the cache the Gateway serves)
#   local    ~/.mylinuxpool/state.json (this Mac's snapshot, if any)
# Exits non-zero when anything diverges — that is what made a pre-ledger
# worker invisible to a rotate in 2026-09-14.
cmd_state() {
    resolve_gateway
    if ! open_gateway_master; then
        die "Gateway unreachable (${GW_USER}@${GW_IP})"
    fi

    local master_nodes master_ports master_serial
    local gw_json gw_serial gw_nodes gw_ports gw_workers
    local local_json local_serial local_nodes local_ports

    # Normalize master node names to the same lowercase-hyphen spelling
    # state.json uses for .nodes keys (NODE_FH_L -> fh-l), so the comm
    # comparisons below compare like with like.
    master_nodes="$({ gh api "repos/${REPO}/actions/variables?per_page=100" --jq '.variables[].name' 2>/dev/null | grep '^NODE_' | sed 's/^NODE_//' | tr '[:upper:]' '[:lower:]' | tr '_' '-' | sort; })"
    master_ports="$(gw_run '~/.mylinuxpool/bin/pool-port-alloc --list' | jq -r '[.[].port] | sort | .[]' 2>/dev/null)"

    gw_json="$(gw_run 'cat /var/lib/mylinuxpool/state.json')"
    if [[ -z "$gw_json" ]]; then
        echo "mlp: gateway state.json unreadable — is the Gateway provisioned with the state cache?" >&2
        gw_serial=""; gw_nodes=""; gw_ports=""
    else
        gw_serial="$(printf '%s' "$gw_json" | jq -r '.serial // empty')"
        gw_nodes="$(printf '%s' "$gw_json" | jq -r '.nodes | keys[]' 2>/dev/null | sort)"
        gw_ports="$(printf '%s' "$gw_json" | jq -r '[.workers[].port] | sort | .[]' 2>/dev/null)"
    fi

    if [[ -f "${MLP_STATE_DIR}/state.json" ]]; then
        local_json="$(cat "${MLP_STATE_DIR}/state.json" 2>/dev/null)"
        local_serial="$(printf '%s' "$local_json" | jq -r '.serial // empty')"
        local_nodes="$(printf '%s' "$local_json" | jq -r '.nodes | keys[]' 2>/dev/null | sort)"
        local_ports="$(printf '%s' "$local_json" | jq -r '[.workers[].port] | sort | .[]' 2>/dev/null)"
    else
        local_serial=""; local_nodes=""; local_ports=""
    fi

    close_gateway_master

    # master has no serial — only the two cache copies do
    master_serial=""

    local drift=0
    local name

    printf '%s%sSTATE%s\n' "$C_BOLD" "$C_BOLD" "$C_RESET"
    printf '  %-10s %-10s %-10s %-10s\n' "copy" "serial" "nodes" "ports"
    printf '  %-10s %-10s %-10s %-10s\n' "master" "${master_serial:--}" "$(printf '%s' "$master_nodes" | grep -c . || true)" "$(printf '%s' "$master_ports" | grep -c . || true)"
    printf '  %-10s %-10s %-10s %-10s\n' "gateway" "${gw_serial:--}" "$(printf '%s' "$gw_nodes" | grep -c . || true)" "$(printf '%s' "$gw_ports" | grep -c . || true)"
    printf '  %-10s %-10s %-10s %-10s\n' "local" "${local_serial:--}" "$(printf '%s' "$local_nodes" | grep -c . || true)" "$(printf '%s' "$local_ports" | grep -c . || true)"

    # node sets
    local only_gw only_local only_master common
    only_master="$(comm -23 <(printf '%s\n' "$master_nodes") <(printf '%s\n' "$gw_nodes") 2>/dev/null)"
    only_gw="$(comm -13 <(printf '%s\n' "$master_nodes") <(printf '%s\n' "$gw_nodes") 2>/dev/null)"
    only_local="$(comm -13 <(printf '%s\n' "$master_nodes") <(printf '%s\n' "$local_nodes") 2>/dev/null)"
    if [[ -n "$only_master" || -n "$only_gw" ]]; then
        echo ""
        echo "node set differs (master vs gateway):"
        [[ -n "$only_master" ]] && printf '%s    only in master:   %s%s\n' "$C_RED" "$(printf '%s' "$only_master" | tr '\n' ' ')" "$C_RESET"
        [[ -n "$only_gw" ]] && printf '%s    only in gateway:  %s%s\n' "$C_RED" "$(printf '%s' "$only_gw" | tr '\n' ' ')" "$C_RESET"
        drift=1
    fi
    if [[ -n "$only_local" ]]; then
        echo ""
        printf '%s    local has nodes missing from master: %s%s\n' "$C_YELLOW" "$(printf '%s' "$only_local" | tr '\n' ' ')" "$C_RESET"
    fi

    # worker port sets
    local only_ports_master only_ports_gw
    only_ports_master="$(comm -23 <(printf '%s\n' "$master_ports") <(printf '%s\n' "$gw_ports") 2>/dev/null)"
    only_ports_gw="$(comm -13 <(printf '%s\n' "$master_ports") <(printf '%s\n' "$gw_ports") 2>/dev/null)"
    if [[ -n "$only_ports_master" || -n "$only_ports_gw" ]]; then
        echo ""
        echo "worker port set differs (master vs gateway):"
        [[ -n "$only_ports_master" ]] && printf '%s    only in master:   %s%s\n' "$C_RED" "$(printf '%s' "$only_ports_master" | tr '\n' ' ')" "$C_RESET"
        [[ -n "$only_ports_gw" ]] && printf '%s    only in gateway:  %s%s\n' "$C_RED" "$(printf '%s' "$only_ports_gw" | tr '\n' ' ')" "$C_RESET"
        drift=1
    fi

    # serials
    if [[ -n "$gw_serial" && -n "$local_serial" && "$gw_serial" != "$local_serial" ]]; then
        echo ""
        printf '%s    serial differs: gateway=%s local=%s%s\n' "$C_YELLOW" "$gw_serial" "$local_serial" "$C_RESET"
        drift=1
    fi

    if [[ "$drift" -eq 0 ]]; then
        echo ""
        printf '%sconsistent — master, gateway and local agree%s\n' "$C_GREEN" "$C_RESET"
        return 0
    fi
    return 1
}

cmd_status() {
    [[ -x "$POOL_STATUS" ]] || die "pool-status not found at ${POOL_STATUS}"
    "$POOL_STATUS" "$@"
}

# ---- workflow-backed commands ------------------------------------------------
# rotate / create-worker / delete-worker run as GitHub Actions, and these
# commands trigger them rather than reimplementing them.
#
# Not for convenience. Those flows need LINODE_TOKEN, FILE_CRYPTO_KEY,
# SSH_KEY_ACTIONS and the ability to look up a secret by a name known only
# at run time; doing them here would put all of that on a laptop that
# travels. And the step ordering, the rollback that only arms after the
# switch point, and the orphan sweep live in the workflow — a local
# reimplementation would be a second copy of that logic, free to drift
# from the one Actions actually runs.
#
# The line: anything needing credentials or orchestration goes through a
# workflow; anything interactive or latency-sensitive (ssh/wake/down)
# stays local.

# wf_dispatch <workflow-file> <label> [-f k=v ...]
wf_dispatch() {
    local wf="$1" label="$2"; shift 2
    local before after run_id i

    # The dispatch API returns nothing identifying the run it creates, so
    # remember the newest id first and watch for a different one.
    before="$(gh run list --workflow="$wf" --repo "$REPO" --limit 1 \
                --json databaseId --jq '.[0].databaseId // 0' 2>/dev/null)"

    gh workflow run "$wf" --repo "$REPO" "$@" >/dev/null 2>&1 \
        || die "could not dispatch ${wf} (is gh authenticated for ${REPO}?)"

    printf '%s%s%s dispatched, waiting for the run to appear' "$C_BOLD" "$label" "$C_RESET"
    run_id=""
    for i in $(seq 1 20); do
        sleep 3
        after="$(gh run list --workflow="$wf" --repo "$REPO" --limit 1 \
                   --json databaseId --jq '.[0].databaseId // 0' 2>/dev/null)"
        if [[ -n "$after" && "$after" != "$before" ]]; then run_id="$after"; break; fi
        printf '.'
    done
    echo ""
    [[ -n "$run_id" ]] || die "the run never appeared — check https://github.com/${REPO}/actions"

    echo "  https://github.com/${REPO}/actions/runs/${run_id}"
    echo ""
    wf_follow "$run_id"
}

# wf_follow <run-id> — prints each step as it settles; exits with the run's status.
wf_follow() {
    local run_id="$1" seen="" json cur new status conclusion line mark

    while true; do
        json="$(gh run view "$run_id" --repo "$REPO" --json status,conclusion,jobs 2>/dev/null)" || {
            sleep 10; continue
        }
        cur="$(printf '%s' "$json" | jq -r '
            .jobs[].steps[]
            | select(.conclusion != null and .conclusion != "")
            | "\(.number)\t\(.conclusion)\t\(.name)"' 2>/dev/null | sort -n)"

        new="$(comm -13 <(printf '%s\n' "$seen") <(printf '%s\n' "$cur") 2>/dev/null)"
        while IFS=$'\t' read -r _ conclusion line; do
            [[ -n "$line" ]] || continue
            case "$conclusion" in
                success)  mark="${C_GREEN}ok${C_RESET}      " ;;
                skipped)  mark="—       " ;;
                *)        mark="${C_RED}${conclusion}${C_RESET} " ;;
            esac
            printf '  %s%s\n' "$mark" "$line"
        done <<< "$new"
        seen="$cur"

        status="$(printf '%s' "$json" | jq -r '.status')"
        if [[ "$status" == "completed" ]]; then
            conclusion="$(printf '%s' "$json" | jq -r '.conclusion')"
            echo ""
            if [[ "$conclusion" == "success" ]]; then
                printf '%srun finished: success%s\n' "$C_GREEN" "$C_RESET"
                return 0
            fi
            printf '%srun finished: %s%s\n' "$C_RED" "$conclusion" "$C_RESET"
            echo "  gh run view ${run_id} --repo ${REPO} --log-failed"
            return 1
        fi
        sleep 10
    done
}

cmd_rotate() {
    local real=0 confirm gw_ip
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --real) real=1; shift ;;
            *) die "usage: mlp rotate [--real]" ;;
        esac
    done

    if [[ "$real" -eq 0 ]]; then
        echo "dry run: builds, provisions and verifies a preview machine, then deletes it."
        echo "NODE_GATEWAY and the live Gateway are not touched."
        echo ""
        wf_dispatch rotate-gateway.yml "rotate (dry run)" -f dry_run=true
        return
    fi

    resolve_gateway
    gw_ip="$GW_IP"
    printf '%sThis replaces the live Gateway (%s).%s\n' "$C_YELLOW" "$gw_ip" "$C_RESET"
    echo "  Providers reconnect on their own (~1s). Running workers follow"
    echo "  too — they read the address their provider publishes, and the"
    echo "  port ledger is carried over — but expect a brief interruption."
    echo "  Run 'mlp rotate' (dry run) first if you haven't."
    printf 'Type the current Gateway IP to confirm: '
    read -r confirm
    if [[ "$confirm" != "$gw_ip" ]]; then
        echo "aborted (expected ${gw_ip})."
        return 1
    fi

    wf_dispatch rotate-gateway.yml "rotate" -f dry_run=false || return 1
    echo ""
    echo "next: run 'mlp trust-gateway' to accept the new machine's host key."
}

cmd_worker() {
    local sub="${1:-}"
    [[ $# -gt 0 ]] && shift
    case "$sub" in
        new) worker_new "$@" ;;
        rm)  worker_rm "$@" ;;
        "")  die "usage: mlp worker {new|rm}" ;;
        *)   die "unknown worker subcommand '${sub}' (expected new or rm)" ;;
    esac
}

# The pickers read the same live view `ls` renders, so what you pick is
# what you just saw — including the container-name spelling, which is the
# one delete-worker did not accept until it was taught both.
worker_targets() {
    resolve_gateway
    open_gateway_master || die "Gateway unreachable (${GW_USER}@${GW_IP})"
    gather_targets
}

worker_new() {
    local provider image

    provider="$(worker_targets | awk -F'\t' '$2 == "provider" { print $1 }' \
                 | fzf --prompt='provider> ' --height='~40%' \
                       --header='which machine should host the worker?')"
    [[ -n "$provider" ]] || { echo "aborted."; return 1; }

    image="$(worker_images | fzf --prompt='image> ' --height='~40%' \
               --header='which profiles/worker/<image> to build?')"
    [[ -n "$image" ]] || { echo "aborted."; return 1; }

    wf_dispatch create-worker.yml "create-worker (${provider}/${image})" \
        -f provider="$provider" -f image="$image" || return 1
    echo ""
    echo "next: 'mlp ls' to see it, 'mlp ssh' to connect."
}

worker_rm() {
    local name="${1:-}" confirm
    if [[ "$name" == -* ]]; then
        echo "usage: mlp worker rm [<worker-name>]  (fzf pick when omitted)" >&2
        exit 2
    fi
    if [[ -z "$name" ]]; then
        name="$(worker_targets \
                 | awk -F'\t' '$2 == "worker" { printf "%s\t(on %s, port %s)\n", $1, $3, $4 }' \
                 | fzf --prompt='worker> ' --height='~40%' \
                       --header='which worker to delete? (Esc to cancel)' \
                 | cut -f1)"
    fi
    [[ -n "$name" ]] || { echo "aborted."; return 1; }

    printf '%sDelete worker %s?%s Its container is removed and its port released.\n' \
        "$C_YELLOW" "$name" "$C_RESET"
    printf 'Type "yes" to confirm: '
    read -r confirm
    [[ "$confirm" == "yes" ]] || { echo "aborted."; return 1; }

    wf_dispatch delete-worker.yml "delete-worker (${name})" -f name="$name"
}

worker_images() {
    local d
    for d in "${REPO_ROOT}"/profiles/worker/*/; do
        [[ -d "$d" ]] && basename "$d"
    done
}


# ---- register ---------------------------------------------------------------
# Thin forwarders to the real registration scripts — the logic lives in
# ops-scripts/register-client / register-provider.sh, never duplicated
# here (RUNBOOK §7.12: one rule, one implementation). IMPORTANT WHERE
# THEY RUN (people get this wrong):
#   - `mlp register client` runs on the machine YOU will connect FROM
#     (the operator's Mac) — it uploads YOUR public key to GitHub.
#   - `mlp register provider` runs ON THE NEW MACHINE being added to the
#     pool — NOT on the Mac. It provisions that box itself.
cmd_register() {
    local sub="${1:-}"
    [[ $# -gt 0 ]] && shift
    local script
    case "$sub" in
        client)   script="${SCRIPT_DIR}/register-client" ;;
        provider) script="${SCRIPT_DIR}/register-provider.sh" ;;
        "")
            cat >&2 <<'EOF'
usage: mlp register {client|provider} [args...]

  register client    register THIS machine (the one you are on) as a
                     client: uploads your public key to CLIENT_<NAME>.
                     Run it on the machine you will connect FROM.
                     forwards to ops-scripts/register-client
  register provider  register a NEW machine into the pool. Run it ON
                     that new machine, not here on the Mac.
                     forwards to ops-scripts/register-provider.sh
EOF
            return 2
            ;;
        *)
            echo "mlp: unknown register subcommand '${sub}' (expected client or provider)" >&2
            return 2
            ;;
    esac
    if [[ ! -x "$script" ]]; then
        echo "mlp: ${script} not found or not executable" >&2
        return 127
    fi
    "$script" "$@"
}


# Emits a normal ssh_config so plain `ssh fh-l`, `scp`, `rsync`, `-L`/`-R`
# and anything else that speaks ssh_config work against the pool — without
# going through mlp at all.
#
# ---- ssh-config export -------------------------------------------------------
# Emits a normal ssh_config so plain `ssh fh-l`, `scp`, `rsync`, `-L`/`-R`
# and anything else that speaks ssh_config work against the pool — without
# going through mlp at all.
#
# Trust is not uniform across the two legs, which is why this cannot be a
# single ProxyJump with one set of options (the same reason mlp builds
# ProxyCommand by hand):
#   - The Gateway leg is pinned to the host key NODE_GATEWAY carries.
#   - The 127.0.0.1:<port> legs are NOT verified: every node answers on the
#     same loopback address, and their keys change whenever a worker is
#     rebuilt. Pinning there would mean a host key warning every time.
#     The Gateway leg is what authenticates the path.
MLP_SSH_CONFIG="${MLP_STATE_DIR}/ssh_config"

emit_ssh_config() {
    local name type provider port user

    cat <<HEADER
# Generated by \`mlp ssh-config\` on $(date -u +%Y-%m-%dT%H:%M:%SZ).
# Gateway: ${GW_IP} (generation $("$POOL_RESOLVE" gateway --field .generation 2>/dev/null))
#
# Regenerate after a rotate: the Gateway's address and host key both change.
#   mlp ssh-config --write

Host mlp-gateway
    HostName ${GW_IP}
    User ${GW_USER}
    Port 22
HEADER
    client_identity_line
    cat <<HEADER
    UserKnownHostsFile ${GW_KNOWN_HOSTS}
    StrictHostKeyChecking yes
HEADER

    while IFS=$'\t' read -r name type provider port user; do
        [[ -n "$name" ]] || continue
        echo ""
        if [[ "$type" == "worker" ]]; then
            echo "# worker on ${provider}"
            echo "Host ${name} worker-${port}"
        else
            echo "Host ${name}"
        fi
        echo "    HostName 127.0.0.1"
        echo "    Port ${port}"
        echo "    User ${user}"
        client_identity_line
        echo "    ProxyJump mlp-gateway"
        echo "    UserKnownHostsFile /dev/null"
        echo "    StrictHostKeyChecking no"
        echo "    LogLevel ERROR"
    done < <(gather_targets)
}

# Names we are about to define that ~/.ssh/config already defines. ssh takes
# the FIRST value it obtains for a keyword, so an earlier Host block wins —
# a stale entry silently beats the generated one, which is the confusing
# failure this warns about rather than tries to resolve.
ssh_config_collisions() {
    local generated="$1" user_cfg="${HOME}/.ssh/config" n
    [[ -f "$user_cfg" ]] || return 0
    grep -E '^Host ' "$generated" | sed 's/^Host //' | tr ' ' '\n' | while read -r n; do
        [[ -n "$n" ]] || continue
        grep -qE "^Host( .*)? ${n}( |$)|^Host ${n}( |$)" "$user_cfg" && echo "$n"
    done
}

# client_identity_line — print the IdentityFile line for this client.
#   Prefers ~/.ssh/id_mlp, which is what `mlp register client` creates and
#   publishes as CLIENT_<NAME>. Falls back to ~/.ssh/id_rsa for a machine
#   that predates that flow. Hardcoding id_rsa is how a client keeps using
#   a key the pool is about to stop authorising.
client_identity_line() {
    local k
    local key
    key="$(client_identity_path)" || return 0
    echo "    IdentityFile ${key/#${HOME}/~}"
}

cmd_ssh_config() {
    local write=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --write) write=1; shift ;;
            *) die "usage: mlp ssh-config [--write]" ;;
        esac
    done

    resolve_gateway
    open_gateway_master || die "Gateway unreachable (${GW_USER}@${GW_IP})"
    local tmp; tmp="$(mktemp)"
    emit_ssh_config > "$tmp"
    close_gateway_master

    if [[ "$write" -eq 0 ]]; then
        cat "$tmp"
        rm -f "$tmp"
        return 0
    fi

    mkdir -p "$MLP_STATE_DIR"
    mv -f "$tmp" "$MLP_SSH_CONFIG"
    chmod 600 "$MLP_SSH_CONFIG"
    printf '%swrote %s%s\n' "$C_GREEN" "$MLP_SSH_CONFIG" "$C_RESET"

    local inc="Include ${MLP_SSH_CONFIG}"
    if [[ -f "${HOME}/.ssh/config" ]] && grep -qF "$inc" "${HOME}/.ssh/config"; then
        echo "~/.ssh/config already includes it."
    else
        echo ""
        echo "Add this as the FIRST line of ~/.ssh/config (ssh keeps the first"
        echo "value it finds for a setting, so an Include placed lower loses to"
        echo "whatever is above it):"
        echo ""
        printf '    %s\n' "$inc"
    fi

    local dupes; dupes="$(ssh_config_collisions "$MLP_SSH_CONFIG")"
    if [[ -n "$dupes" ]]; then
        echo ""
        printf '%sthese names are already defined in ~/.ssh/config:%s\n' "$C_YELLOW" "$C_RESET"
        printf '%s\n' "$dupes" | sed 's/^/    /'
        echo "  Whichever block comes first wins. Remove the old ones, or put"
        echo "  the Include above them."
    fi
}


# ---- main menu --------------------------------------------------------------
main_menu() {
    local choice action
    while true; do
        choice="$(
            printf '%s\n' \
                "ls      list providers/workers and their live state" \
                "ssh     pick a node/worker and connect" \
                "wake           wake fh-l" \
                "down           shut down fh-l" \
                "status         run pool-status" \
                "state          compare master vs Gateway vs local snapshots" \
                "rotate         Gateway dry run (builds and discards a preview machine)" \
                "rotate-real    replace the live Gateway for real (asks you to type its IP)" \
                "worker-new     build and start a worker on a provider" \
                "worker-rm      stop a worker and release its port" \
                "ssh-config     write an ssh_config so plain ssh/scp/rsync work" \
                "trust-gateway  re-accept the Gateway's host key after a rotate" \
                "quit           exit" \
            | fzf --prompt='mlp> ' --height='~50%' --header='select an action (Esc to quit)'
        )"

        [[ -n "$choice" ]] || break
        action="$(printf '%s' "$choice" | awk '{print $1}')"

        case "$action" in
            ls) cmd_ls ;;
            ssh) cmd_ssh ;;
            wake) cmd_wake ;;
            down) cmd_down ;;
            status) cmd_status ;;
            state) cmd_state ;;
            rotate) cmd_rotate ;;
            rotate-real) cmd_rotate --real ;;
            worker-new) worker_new ;;
            worker-rm) worker_rm ;;
            ssh-config) cmd_ssh_config --write ;;
            trust-gateway) cmd_trust_gateway ;;
            quit) break ;;
        esac

        echo ""
        printf 'press Enter to return to the menu...'
        read -r _
    done
}

main() {
    local cmd="${1:-}"

    if [[ "$cmd" == "-h" || "$cmd" == "--help" ]]; then
        usage
        exit 0
    fi

    check_deps

    if [[ -n "$cmd" ]]; then
        shift
    fi

    case "$cmd" in
        "") main_menu ;;
        ls) cmd_ls "$@" ;;
        ssh) cmd_ssh "$@" ;;
        wake) cmd_wake "$@" ;;
        down) cmd_down "$@" ;;
        status) cmd_status "$@" ;;
        state) cmd_state "$@" ;;
        rotate) cmd_rotate "$@" ;;
        worker) cmd_worker "$@" ;;
        register) cmd_register "$@" ;;
        ssh-config) cmd_ssh_config "$@" ;;
        trust-gateway) cmd_trust_gateway "$@" ;;
        *)
            echo "mlp: unknown command '${cmd}'" >&2
            usage
            exit 2
            ;;
    esac
}

# Only run as a standalone command when actually executed, not sourced —
# sourcing is how tests load the functions above (same pattern as
# scripts/lib/crypto.sh and pool-tunnel).
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
